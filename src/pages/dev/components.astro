---
/**
 * M3 GATE ARTIFACT — component library demo.
 * ---------------------------------------------------------------------------
 * Renders every component in the M3 library with REAL seed content, so the
 * gate checks something honest rather than lorem. Both journey variants are
 * present, which is what makes the Variant B modules reviewable.
 *
 * noindex, and kept after M3 as a living style guide — it is the fastest way
 * to see the whole design language on one screen, and it fails loudly if a
 * component's props drift.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import QuickFactsBar from '../../components/QuickFactsBar.astro';
import HighlightsGrid from '../../components/HighlightsGrid.astro';
import GlanceTable from '../../components/GlanceTable.astro';
import DayAccordion from '../../components/DayAccordion.astro';
import InclusionsBlock from '../../components/InclusionsBlock.astro';
import CabinCards from '../../components/CabinCards.astro';
import BookingStepper from '../../components/BookingStepper.astro';
import PoliciesAccordion from '../../components/PoliciesAccordion.astro';
import PracticalNotesGrid from '../../components/PracticalNotesGrid.astro';
import ConvertBand from '../../components/ConvertBand.astro';
import JourneyCard from '../../components/JourneyCard.astro';
import RelatedJourneys from '../../components/RelatedJourneys.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import StickyMobileBar from '../../components/StickyMobileBar.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import Callout from '../../components/Callout.astro';
import CounterStat from '../../components/CounterStat.astro';
import Button from '../../components/Button.astro';
import Lotus from '../../components/Lotus.astro';
import TransportChip from '../../components/TransportChip.astro';
import { getCollection, getEntry } from 'astro:content';
import { getSiteSettings, verifiedTrustStats } from '../../lib/site-settings';

const settings = await getSiteSettings();
const stats = verifiedTrustStats(settings);

const kerala = await getEntry('journeys', 'kerala-with-houseboat-11n-12d');
const pow = await getEntry('journeys', 'palace-on-wheels-7n-8d');
if (!kerala || !pow) throw new Error('M3 demo needs both seed journeys');
if (kerala.data.variant !== 'A' || pow.data.variant !== 'B') {
  throw new Error('M3 demo expects Kerala as Variant A and Palace on Wheels as Variant B');
}

const testimonials = (await getCollection('testimonials')).map((entry) => ({
  name: entry.data.name,
  origin: entry.data.origin,
  tripLabel: entry.data.tripLabel,
  quote: entry.data.quote,
  photo: entry.data.photo,
}));

const cardOf = (entry: typeof kerala | typeof pow) => ({
  slug: entry.id,
  title: entry.data.title,
  image: entry.data.heroImage,
  imageAlt: entry.data.heroImageAlt,
  nights: entry.data.nights,
  days: entry.data.days,
  routeCities: entry.data.routeCities,
  variant: entry.data.variant,
  signatureFeature: entry.data.signatureFeature,
});

const sections = [
  ['buttons', 'Buttons & CTAs'],
  ['glyph', 'Lotus glyph & chips'],
  ['hero', 'Hero'],
  ['quickfacts', 'Quick Facts bar'],
  ['highlights', 'Highlights grid'],
  ['glance', 'At a glance'],
  ['days', 'Day accordion'],
  ['inclusions', 'Inclusions'],
  ['cabins', 'Cabin cards (Variant B)'],
  ['booking', 'Booking stepper (Variant B)'],
  ['policies', 'Policies (Variant B)'],
  ['practical', 'Practical notes'],
  ['cards', 'Journey cards'],
  ['related', 'Related journeys'],
  ['stats', 'Counter stats'],
  ['quotes', 'Testimonials'],
  ['article', 'Article body'],
  ['convert', 'Convert band'],
];
---

<Base
  title="Component library — India Visit"
  description="M3 gate artifact: every component in the library rendered with real seed content."
  noindex={true}
>
  <Header slot="header" />

  <section class="band band-tight">
    <div class="container-content">
      <p class="eyebrow">Milestone 3 · Component library</p>
      <h1 class="demo__title">Every component, real content</h1>
      <p class="demo__lede prose-measure">
        The design language is white-canvas premium: white is the page,
        off-white is a whisper of contrast, plum bands are rare, and crimson is
        punctuation — one action per viewport. Both journey variants render
        below, which is what makes the Variant&nbsp;B modules reviewable.
      </p>
      <nav class="demo__toc" aria-label="Components on this page">
        <ul>
          {sections.map(([id, label]) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <hr class="hairline" />

  <section class="band band-tight" id="buttons">
    <div class="container-content">
      <h2 class="demo__h2">Buttons &amp; CTAs</h2>
      <p class="demo__note">
        One crimson primary per viewport. Secondary is outline ink; ghost is
        text. All are ≥44px tall.
      </p>
      <div class="demo__row">
        <Button href="/plan-my-trip/">Plan My Trip</Button>
        <Button href="/journeys/" variant="secondary">Explore Journeys</Button>
        <Button href="/journeys/" variant="ghost">View all →</Button>
        <Button variant="primary" size="lg">Large primary</Button>
        <Button variant="secondary" size="sm">Small secondary</Button>
        <Button disabled>Disabled</Button>
      </div>
      <div class="demo__row demo__row--dark">
        <Button variant="on-dark">On a plum band</Button>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <section class="band band-tight" id="glyph">
    <div class="container-content">
      <h2 class="demo__h2">Lotus glyph &amp; transport chips</h2>
      <p class="demo__note">
        The lotus is the sitewide bullet mark — never ✦, never a checkmark. It
        inherits colour from context via <code>currentColor</code>.
      </p>
      <div class="demo__row demo__row--glyphs">
        <Lotus size={14} /><Lotus size={18} /><Lotus size={24} /><Lotus size={40} />
      </div>
      <div class="demo__row">
        <TransportChip mode="flight" detail="Delhi to Udaipur" />
        <TransportChip mode="overnight-train" detail="Overnight to Jaisalmer" />
        <TransportChip mode="drive" detail="Drive 172 km" />
        <TransportChip mode="boat" detail="Overnight houseboat" />
      </div>
    </div>
  </section>

  <div id="hero">
    <Hero image={kerala.data.heroImage} alt={kerala.data.heroImageAlt} height="short" kenBurns>
      <p class="hero__eyebrow">{kerala.data.tripTypeTag}</p>
      <h2 class="hero__h1">{kerala.data.title}</h2>
      <p class="hero__badges">
        <span class="hero__pill">{kerala.data.nights} Nights · {kerala.data.days} Days</span>
        {kerala.data.signatureFeature && (
          <span class="hero__pill hero__pill--feature">{kerala.data.signatureFeature}</span>
        )}
      </p>
      <p class="hero__route">{kerala.data.routeCities.join(' · ')}</p>
      <p class="demo__row">
        <Button>Customise This Journey</Button>
        <Button variant="on-dark">WhatsApp</Button>
      </p>
    </Hero>
  </div>

  <div id="quickfacts">
    <QuickFactsBar
      nights={kerala.data.nights}
      days={kerala.data.days}
      startCity={kerala.data.startCity}
      endCity={kerala.data.endCity}
      pace={kerala.data.pace}
      bestSeason={kerala.data.bestSeason}
      idealFor={kerala.data.idealFor}
    />
  </div>

  <div id="highlights"><HighlightsGrid highlights={kerala.data.highlights} /></div>
  <div id="glance"><GlanceTable rows={kerala.data.glanceRows} /></div>
  <div id="days">
    <DayAccordion days={kerala.data.itineraryDays.slice(0, 5)} />
  </div>

  <div id="inclusions">
    <InclusionsBlock inclusions={pow.data.inclusions} exclusions={pow.data.exclusions} />
  </div>

  <div id="cabins">
    <CabinCards
      cabins={pow.data.cabinCategories}
      operatorDisclosure={pow.data.operatorDisclosure}
      bookingTermsUrl={pow.data.bookingTermsUrl}
    />
  </div>

  <div id="booking"><BookingStepper steps={pow.data.bookingSteps} /></div>

  <div id="policies">
    <PoliciesAccordion
      policies={pow.data.policies}
      operatorDisclosure={pow.data.operatorDisclosure}
      operatorName={pow.data.operatorName}
      bookingTermsUrl={pow.data.bookingTermsUrl}
    />
  </div>

  <div id="practical"><PracticalNotesGrid notes={kerala.data.practicalNotes} /></div>

  <section class="band" id="cards">
    <div class="container-content">
      <h2 class="demo__h2">Journey cards</h2>
      <p class="demo__note">
        Variant B takes the plum treatment and a Fixed Departures tag, so a
        train reads as a different product. Neither card can show a price:
        <code>showPrices</code> is off, and Variant B is exempt permanently.
      </p>
      <div class="demo__cards">
        <JourneyCard {...cardOf(kerala)} />
        <JourneyCard {...cardOf(pow)} />
        <JourneyCard {...cardOf(kerala)} comingSoon />
      </div>
    </div>
  </section>

  <div id="related">
    <RelatedJourneys journeys={[cardOf(kerala), cardOf(pow), cardOf(kerala)]} />
  </div>

  <div id="stats"><CounterStat stats={stats} /></div>
  <div id="quotes"><TestimonialCarousel testimonials={testimonials} /></div>

  <section class="band" id="article">
    <div class="container-content">
      <h2 class="demo__h2">Article body</h2>
      <ArticleBody>
        <p>
          Some places you visit. Kerala, you sink into. This is the editorial
          register the whole site is benchmarked against — warm, unhurried, no
          hard sell.
        </p>
        <h3>A subheading in the display face</h3>
        <p>
          Body copy sits at 16–18px with a 1.6–1.7 line height and a measure
          capped near 68 characters, which is where long-form reading stays
          comfortable.
        </p>
        <Callout title="Practical note">
          <p>
            Boats moor at dusk and resume in the morning — a navigation rule,
            not an operator preference.
          </p>
        </Callout>
        <blockquote><p>Whitespace is the luxury signal; restraint is the aesthetic.</p></blockquote>
      </ArticleBody>
    </div>
  </section>

  <div id="convert">
    <ConvertBand
      heading="This itinerary can be tailored to your dates"
      body={kerala.data.customiseCopy}
      leadType="journey"
      journeySlug={kerala.id}
      journeyTitle={kerala.data.title}
      waContext={kerala.data.title}
    />
  </div>

  <Footer slot="footer" />
  <StickyMobileBar slot="after-footer" waContext="Component library" />
</Base>

<style>
  .demo__title {
    margin-top: 0.75rem;
    font-size: var(--text-hero);
  }

  .demo__lede {
    margin-top: 1.5rem;
    font-size: var(--text-xl);
    color: var(--color-ink-muted);
  }

  .demo__toc {
    margin-top: 2.5rem;
  }

  .demo__toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demo__toc a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
  }

  .demo__toc a:hover {
    border-color: var(--color-crimson);
    color: var(--color-crimson);
  }

  .demo__h2 {
    font-size: var(--text-2xl);
  }

  .demo__note {
    margin-top: 0.75rem;
    max-width: var(--container-prose);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .demo__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .demo__row--dark {
    padding: 1.25rem;
    background-color: var(--color-plum);
    border-radius: var(--radius-md);
  }

  .demo__row--glyphs {
    color: var(--color-crimson);
  }

  .demo__cards {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 40rem) {
    .demo__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .demo__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Hero content styling lives with the page that composes the hero, so the
     Hero component stays layout-only and reusable. */
  .hero__eyebrow {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-yellow);
  }

  .hero__h1 {
    margin-top: 0.75rem;
    font-size: var(--text-hero);
    color: var(--color-white);
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .hero__pill {
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-yellow);
    color: var(--color-plum);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .hero__pill--feature {
    background-color: rgb(255 255 255 / 0.18);
    color: var(--color-white);
  }

  .hero__route {
    margin-top: 1rem;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(247 245 246 / 0.85);
  }
</style>
