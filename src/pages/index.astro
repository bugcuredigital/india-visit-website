---
/**
 * Homepage — PAGE_TEMPLATES T1, all eleven sections.
 * ---------------------------------------------------------------------------
 * Section order is PAGE_TEMPLATES **T1 v2** (M4 revision 2): destinations move
 * above journeys because travellers shop by place first, and a "Meet your
 * travel consultant" section is added because the page had no human in it —
 * which, for a twenty-year consultancy whose whole pitch is that a person
 * plans your trip, was the most important thing missing.
 *
 * This page sets the design language for the site, so the discipline matters
 * more here than anywhere: white canvas, type doing the work, crimson as
 * punctuation, and exactly TWO plum bands (How It Works and the closing lead
 * capture) besides the footer. That is the whole allowance the design
 * direction gives for dark surfaces, and it is spent deliberately.
 *
 * Section rhythm alternates white → off-white as a whisper of contrast, never
 * as stripes. Every section is one idea, and no viewport carries two crimson
 * actions.
 *
 * What is deliberately absent:
 *  · the "Curating journeys since {foundingYear}" line — `foundingYear` is
 *    null (blocked on PRD Open Question #2) and the year is never guessed. The
 *    supporting line uses `yearsExperience`, which IS verified, and reads
 *    without a founding date.
 *  · the association logo row — none supplied, so T1 says omit entirely.
 *  · any price. `showPrices` is false and the cards respect it.
 *
 * Seed-content note for the design review: the featured row can only show the
 * two journeys that exist (of six), and one of the seven destination tiles has
 * a real content entry. The treatment is what is under review; the catalogue
 * arrives in M5.
 */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandWatermark from '../components/BandWatermark.astro';
import Hero from '../components/Hero.astro';
import CounterStat from '../components/CounterStat.astro';
import JourneyCard from '../components/JourneyCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import ConvertBand from '../components/ConvertBand.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import Button from '../components/Button.astro';
import Lotus from '../components/Lotus.astro';

import { getSiteSettings, verifiedTrustStats } from '../lib/site-settings';
import { heroPreload } from '../lib/hero-image';
import { DESTINATIONS, REGION_COUNT } from '../lib/destinations-strip';

/* Neutral grey 4:5 slot. A stock photograph of a stranger is deliberately NOT
   used for the founder — see the `founder` schema note in content.config.ts. */
import portraitPlaceholder from '../assets/placeholders/portrait.jpg';

const settings = await getSiteSettings();

/* The hero poster is CMS-fed (PRD v1.5, image-slot convention): swapping the
   client's own footage and still in is a content edit with zero code changes.
   It is currently a TEMP-VIDEO stand-in — see
   docs/brand/processed/TEMP-VIDEO-PROVENANCE.md. */
const homeHero = settings.homeHero.poster;
const heroLink = await heroPreload(homeHero);
const heroVideo = {
  webm: settings.homeHero.videoWebm,
  mp4: settings.homeHero.videoMp4,
};

/* ------------------------------------------------------- featured journeys --
   Editorial picks come from `featured: true`; the rest of the row fills from
   the catalogue so the section is never half-empty. T1 asks for a mix of
   domestic, international and one train — that mix becomes real in M5, and
   sorting trains last is what keeps the upsell at the end of the row. */
const journeys = await getCollection('journeys', ({ data }) => !data.draft);

/* Two of the four trust stats are counted, not claimed: the published journey
   count and the length of the locked destination list. Today that reads
   "2 Curated Journeys"; it reaches 20 in M5 with nobody editing anything. */
const stats = verifiedTrustStats(settings, {
  journeyCount: journeys.length,
  regionCount: REGION_COUNT,
});

const featuredJourneys = [...journeys]
  .sort((a, b) => {
    const byFeatured = Number(b.data.featured) - Number(a.data.featured);
    if (byFeatured !== 0) return byFeatured;
    return Number(a.data.variant === 'B') - Number(b.data.variant === 'B');
  })
  .slice(0, 6);

/* ---------------------------------------------------- destination tiles ----
   T1 v2 shows ALL NINE (it was seven until M4 revision 2) — travellers shop by
   place first, so this section also moves above the journeys. Locked order
   lives in lib/destinations-strip.ts; label and image come from the destination
   entry wherever one exists. */
/* Every tile resolves from its destination entry — image included (round 3,
   image control). A missing entry stops the build rather than falling back to
   a photograph nobody chose: the nine slugs are locked, so an absent entry is
   a content bug, and a homepage quietly rendering the wrong picture for a
   region is worse than a homepage that refuses to build. */
const destinationTiles = await Promise.all(
  DESTINATIONS.map(async (tile) => {
    const entry = await getEntry('destinations', tile.slug);
    if (!entry) {
      throw new Error(
        `Destination "${tile.slug}" is locked into the homepage strip but has no entry in ` +
          'src/content/destinations/. Add the entry, or change the locked list in ' +
          'src/lib/destinations-strip.ts (which needs a 301 — CLAUDE.md URL structure).',
      );
    }
    return {
      slug: tile.slug,
      label: entry.data.shortLabel,
      image: entry.data.heroImage,
      alt: entry.data.heroImageAlt,
    };
  }),
);

/* --------------------------------------------------------------- articles -- */
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => {
    const byFeatured = Number(b.data.featured) - Number(a.data.featured);
    if (byFeatured !== 0) return byFeatured;
    return b.data.publishDate.getTime() - a.data.publishDate.getTime();
  })
  .slice(0, 3);

/* ----------------------------------------------------------- testimonials -- */
/* Placeholder slots render too — they reserve the card and say one quiet line
   (word control, round 3). A real entry without recorded consent cannot exist:
   the schema refuses it. */
const testimonials = (
  await getCollection('testimonials', ({ data }) => data.placeholder || data.consentConfirmed)
).map((entry) => ({
  name: entry.data.name,
  origin: entry.data.origin,
  tripLabel: entry.data.tripLabel,
  quote: entry.data.quote,
  photo: entry.data.photo,
  placeholder: entry.data.placeholder,
}));

/* ------------------------------------------------------- luxury train card --
   The teaser points at the landing page, and its image is the flagship train's
   hero so the two pages feel continuous. */
/* Association logos — empty until the client supplies any. Typed as a real
   list so wiring them in M5 is data, not markup. */
const associationLogos: Array<{ image: ImageMetadata; alt: string }> = [];

const trainJourney = journeys.find((entry) => entry.data.variant === 'B');

/* T1 §4 — three steps. The plum band is one of only two on the page. */
const HOW_IT_WORKS = [
  {
    title: 'Tell us your dream',
    detail:
      'A conversation, not a form-filling exercise. Where you want to go, how long you have, what kind of days you enjoy.',
  },
  {
    title: 'We craft your itinerary',
    detail:
      'A day-by-day plan built around your pace, with every hotel, transfer and guide chosen for a reason — revised until it reads right.',
  },
  {
    title: 'Travel fully supported',
    detail:
      'Your itinerary, your contacts and a person on the end of a phone for the whole trip. Not a call centre.',
    lotus: true,
  },
];

/* T1 §6 — four reasons, lotus-marked, one or two lines each. */
const WHY_US = [
  {
    title: 'Twenty years of it',
    detail: `${settings.yearsExperience} years arranging journeys across India — long enough to know which hill station is worth the drive in July.`,
  },
  {
    title: 'Curated, not catalogued',
    detail: 'Every itinerary is written for the people travelling it. Nothing is picked off a shelf.',
  },
  {
    title: 'Affordable luxury',
    detail: 'Heritage properties, private guides and unhurried days — arranged at the price of a package tour.',
  },
  {
    title: 'With you the whole way',
    detail: settings.supportPromise,
  },
];
---

<Base
  title="India Visit — Curated Journeys Across India"
  description="A travel consultancy of twenty years, arranging unhurried private journeys across India, the Himalayas, Bhutan, Bali and Vietnam. Every trip planned by a person."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLink.href}
    imagesrcset={heroLink.imagesrcset}
    imagesizes={heroLink.imagesizes}
    type={heroLink.type}
    fetchpriority="high"
  />

  <Header slot="header" overlay={true} isHome={true} />

  <!-- 1 · Hero ---------------------------------------------------------- -->
  <Hero
    image={homeHero}
    alt={settings.homeHero.posterAlt}
    height="cover"
    kenBurns={true}
    video={heroVideo}
    scrollCue="#trust"
  >
    <h1 class="hero__title">Journeys across India, planned by a person</h1>
    <p class="hero__lede">
      {settings.yearsExperience} years of arranging unhurried, private travel —
      Rajasthan to the backwaters, the Himalayas to Bhutan, Bali and Vietnam.
    </p>
    <p class="hero__actions">
      <Button href="/plan-my-trip/" variant="primary" size="lg" data-analytics="home_hero_cta">
        Plan My Trip
      </Button>
      <Button href="/journeys/" variant="on-dark" size="lg">Explore Journeys</Button>
    </p>
  </Hero>

  <!-- 2 · Trust bar -----------------------------------------------------
       Four stats, two of them counted from our own catalogue rather than
       claimed — see verifiedTrustStats. No association logo row: T1 says omit
       it entirely when none are supplied, and none are. -->
  <div id="trust">
    <CounterStat stats={stats} surface="offwhite">
    {
      /* Association-logos row (T1 v2 §2). T1 says omit entirely when none are
         supplied, and none are — so this renders nothing at all rather than an
         empty bordered strip. The slot exists so M5 is a content change. */
      associationLogos.length > 0 && (
        <div class="assoc">
          <p class="assoc__label">Members and affiliations</p>
          <div class="assoc__row">
            {associationLogos.map((logo) => (
              <Image src={logo.image} alt={logo.alt} widths={[120, 240]} loading="lazy" />
            ))}
          </div>
        </div>
        )
      }
    </CounterStat>
  </div>

  <!-- 3 · Where do you want to go — MOVED ABOVE JOURNEYS (T1 v2) -------
       Travellers shop by place before they shop by trip, so destinations now
       sit above the journey cards. All nine tiles, not seven. -->
  <section class="band" aria-labelledby="dest-heading">
    <div class="container-content">
      <div class="sectionhead">
        <div>
          <p class="eyebrow">Nine regions</p>
          <h2 id="dest-heading">Where do you want to go?</h2>
        </div>
        <a class="pill tap-target" href="/destinations/">
          View all destinations
          <svg viewBox="0 0 16 10" aria-hidden="true" focusable="false">
            <path d="M1 5h13M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <ul class="tiles fade-up-stagger">
        {
          destinationTiles.map((tile) => (
            <li class="tile">
              <a class="tile__link" href={`/destinations/${tile.slug}/`}>
                <span class="tile__frame">
                  <Image
                    src={tile.image}
                    alt={tile.alt}
                    widths={[240, 360, 520]}
                    sizes="(min-width: 64rem) 16rem, (min-width: 40rem) 30vw, 45vw"
                    loading="lazy"
                    class="tile__image"
                  />
                </span>
                <span class="tile__label">{tile.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4 · Signature journeys --------------------------------------------- -->
  <section class="band" aria-labelledby="featured-heading">
    <div class="container-content">
      <div class="sectionhead">
        <div>
          <p class="eyebrow">Signature journeys</p>
          <h2 id="featured-heading">Trips we would take ourselves</h2>
        </div>
        <a class="pill tap-target" href="/journeys/">
          All journeys
          <svg viewBox="0 0 16 10" aria-hidden="true" focusable="false">
            <path d="M1 5h13M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="cards fade-up-stagger">
        {
          featuredJourneys.map((entry) => (
            <JourneyCard
              slug={entry.id}
              title={entry.data.title}
              image={entry.data.heroImage}
              imageAlt={entry.data.heroImageAlt}
              nights={entry.data.nights}
              days={entry.data.days}
              variant={entry.data.variant}
              priceFrom={entry.data.variant === 'A' ? entry.data.priceFrom : undefined}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5 · How it works — plum band 1 of 2 -------------------------------
       The dotted rail with circular nodes is the one property taken from the
       references' process treatment: it turns three steps into a journey
       rather than three boxes. It is a background, so it simply is not there
       at narrow widths where the steps stack. -->
  <section class="band band-plum band-watermarked on-dark" aria-labelledby="how-heading">
    <BandWatermark side="right" />
    <div class="container-content">
      <p class="eyebrow">How it works</p>
      <h2 id="how-heading" class="how__heading">Three steps, one person looking after them</h2>

      <ol class="how fade-up-stagger">
        {
          HOW_IT_WORKS.map((step, index) => (
            <li class="how__step">
              <span class="how__node" aria-hidden="true">
                {step.lotus ? <Lotus size={20} /> : <span class="how__num">{index + 1}</span>}
              </span>
              <h3 class="how__title">{step.title}</h3>
              <p class="how__detail">{step.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6 · Meet your travel consultant (NEW in T1 v2) ---------------------
       The trust centrepiece the page was missing. Everything here is CMS-fed
       and nothing is invented: the name renders only when the client supplies
       one, and the portrait falls back to the neutral grey slot rather than a
       stock photograph of a stranger. -->
  <section class="band consultant" aria-labelledby="consultant-heading">
    <div class="container-content consultant__grid">
      <div class="consultant__frame">
        <Image
          src={settings.founder.portrait ?? portraitPlaceholder}
          alt={settings.founder.portrait ? settings.founder.portraitAlt : 'Placeholder for the founder portrait, awaiting the client photo archive'}
          widths={[360, 540, 760]}
          sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 40vw, 80vw"
          loading="lazy"
          class="consultant__image"
        />
      </div>

      <div class="consultant__body">
        <p class="eyebrow">Meet your travel consultant</p>
        <h2 id="consultant-heading" class="consultant__heading">
          Someone plans your trip. Not something.
        </h2>

        <blockquote class="consultant__quote">
          <p>{settings.founder.quote}</p>
        </blockquote>

        <p class="consultant__attrib">
          {settings.founder.name && <span class="consultant__name">{settings.founder.name}</span>}
          <span class="consultant__role">{settings.founder.role}</span>
        </p>

        <p class="consultant__action">
          <Button href="/plan-my-trip/" variant="ghost">Start a conversation →</Button>
        </p>
      </div>
    </div>
  </section>

  <!-- 7 · Why India Visit — now follows the human section it backs up --- -->
  <section class="band band-offwhite" aria-labelledby="why-heading">
    <div class="container-content">
      <p class="eyebrow">Why India Visit</p>
      <h2 id="why-heading">The difference is who plans it</h2>

      <ul class="why fade-up-stagger">
        {
          WHY_US.map((item, index) => (
            <li class="why__item">
              <p class="why__head">
                {/* Numbered in the display face, reference-site style: it turns
                    four equal statements into a sequence you can read down. */}
                <span class="why__no" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <Lotus size={28} tone="crimson" class="why__mark" />
              </p>
              <h3 class="why__title">{item.title}</h3>
              <p class="why__detail">{item.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8 · Luxury trains banner ------------------------------------------ -->
  {
    trainJourney && (
      <section class="band" aria-labelledby="trains-heading">
        <div class="container-content">
          <div class="trains fade-up">
            <Image
              src={trainJourney.data.heroImage}
              alt={trainJourney.data.heroImageAlt}
              widths={[720, 1080, 1440]}
              sizes="(min-width: 64rem) 68rem, 96vw"
              loading="lazy"
              class="trains__image"
            />
            <div class="trains__body on-dark">
              <p class="eyebrow">Luxury rail</p>
              <h2 id="trains-heading" class="trains__heading">
                India's legendary luxury trains
              </h2>
              <p class="trains__detail">
                Palace on Wheels, the Golden Chariot and the Deccan Odyssey —
                booked through authorised agents, with the operator's terms set
                out plainly before you commit.
              </p>
              <Button href="/luxury-trains/" variant="on-dark">See the trains</Button>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- 9 · Testimonials --------------------------------------------------- -->
  {testimonials.length > 0 && <TestimonialCarousel testimonials={testimonials} />}

  <!-- 10 · Corporate — its own band ---------------------------------------
       Round 3 un-condenses this. It shared a slim off-white strip with the
       travel guide, on the argument that both are secondary audiences — which
       treated a whole line of business as a footnote. One sentence and one CTA
       on its own burgundy ground is less page than a full section and more
       presence than half a strip. -->
  <section class="band band-tight band-burgundy band-watermarked on-dark" aria-labelledby="corp-heading">
    <BandWatermark side="left" />
    <div class="container-content corp__inner">
      <div>
        <p class="eyebrow">Corporate travel</p>
        <h2 id="corp-heading" class="corp__heading">Offsites, incentives and conferences</h2>
        <p class="corp__detail">
          One vendor, GST invoicing, and one person who answers the phone for
          the whole trip — for twenty delegates or two hundred.
        </p>
      </div>
      <p class="corp__action">
        <Button href="/corporate/" variant="on-dark">Corporate travel →</Button>
      </p>
    </div>
  </section>

  <!-- 11 · Travel guide — a full section again -----------------------------
       Three cards, category tags and the index link, as T1 originally had it.
       The grid is sized for three and holds its shape at one: the catalogue is
       still being seeded, and a section that collapses when it is half-filled
       would look broken for the whole of M5. -->
  {
    posts.length > 0 && (
      <section class="band band-offwhite" aria-labelledby="guide-heading">
        <div class="container-content">
          <div class="sectionhead">
            <div>
              <p class="eyebrow">Travel guide</p>
              <h2 id="guide-heading">Reading before you go</h2>
            </div>
            <a class="pill tap-target" href="/travel-guide/">
              All articles
              <svg viewBox="0 0 16 10" aria-hidden="true" focusable="false">
                <path d="M1 5h13M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>

          <div class="guide fade-up-stagger">
            {posts.map((post) => (
              <ArticleCard
                slug={post.id}
                title={post.data.title}
                category={post.data.category}
                excerpt={post.data.excerpt}
                image={post.data.heroImage}
                imageAlt={post.data.heroImageAlt}
                publishDate={post.data.publishDate}
                updatedDate={post.data.updatedDate}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 12 · Lead capture — the closing ConvertBand, burgundy since round 3 -->
  <div id="enquire">
    <ConvertBand
      heading="Tell us where you'd like to go"
      body="Send us the shape of the trip — dates, rough length, who's travelling — and we'll come back with a day-by-day plan and a price. No obligation, and no call centre."
      leadType="general"
    />
  </div>

  <Footer slot="footer" />
  <StickyMobileBar slot="after-footer" />
</Base>

<style>
  /* ---- 1 · hero ------------------------------------------------------- */
  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    color: var(--color-on-dark);
    max-width: 20ch;
    text-wrap: balance;
  }

  .hero__lede {
    margin: 1.25rem 0 0;
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-on-dark);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 0;
  }

  /* ---- shared section header ------------------------------------------
     Heading left, one quiet outline pill right on the same baseline. The
     pill is NOT crimson-filled: a section's "see more" must never compete
     with the page's real action. */
  .sectionhead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }

  .sectionhead h2 {
    margin: 0.35rem 0 0;
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    max-width: 30ch;
    text-wrap: balance;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    color: var(--color-crimson);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .pill svg {
    width: 16px;
    height: 10px;
    flex: none;
  }

  .pill:hover {
    color: var(--color-burgundy);
    border-color: var(--color-burgundy);
  }

  /* ---- 3 · featured journeys ------------------------------------------ */
  /* Explicit column counts, NOT auto-fit: auto-fit collapses the empty tracks,
     so while the catalogue is still being seeded two cards would stretch to
     half the page each. T1's shape is 3 across on desktop whether there are
     two cards or six. */
  .cards {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---- 4 · how it works ----------------------------------------------- */
  .how__heading {
    margin: 0.4rem 0 0;
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    max-width: 26ch;
    text-wrap: balance;
  }

  .how {
    display: grid;
    gap: 2.5rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .how__node {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-yellow) 45%, transparent);
    background-color: var(--color-plum);
    color: var(--color-yellow); /* legal: plum ground */
  }

  .how__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .how__title {
    margin: 1.1rem 0 0;
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  .how__detail {
    margin: 0.55rem 0 0;
    max-width: 34ch;
    color: var(--color-on-dark-muted);
  }

  @media (min-width: 48rem) {
    .how {
      position: relative;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    /* The dotted rail spans node centre to node centre — one sixth in from
       each end of a three-column row — rather than running off the edge. */
    .how::before {
      content: '';
      position: absolute;
      top: 24px;
      left: 16.667%;
      right: 16.667%;
      height: 1px;
      background-image: linear-gradient(
        to right,
        color-mix(in srgb, var(--color-yellow) 35%, transparent) 0 4px,
        transparent 4px 12px
      );
      background-size: 12px 1px;
