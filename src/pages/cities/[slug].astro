---
/**
 * City page — PAGE_TEMPLATES T15 (new in PRD v1.5).
 * ---------------------------------------------------------------------------
 * A city page sits BENEATH a destination rather than beside it. The
 * destination page sells a region; this one answers "what is there to see in
 * Jaipur" — a question people type into a search box — and then routes the
 * reader to the journeys that go there.
 *
 * Which makes section (e) the point of the whole page, and it is computed
 * rather than curated: any journey whose route names this city appears here,
 * so adding a trip through Jaipur never means remembering to edit Jaipur.
 *
 * Every image slot is CMS-fed with a template-fixed aspect ratio, so the M5
 * photo swap is a content change with zero code edits, and no upload can
 * reflow the page.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import JourneyCard from '../../components/JourneyCard.astro';
import PracticalNotesGrid from '../../components/PracticalNotesGrid.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ConvertBand from '../../components/ConvertBand.astro';
import StickyMobileBar from '../../components/StickyMobileBar.astro';
import JsonLd from '../../components/JsonLd.astro';

import { heroPreload } from '../../lib/hero-image';
import { journeysForCity } from '../../lib/cities';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const city = entry.data;

const heroLink = await heroPreload(city.heroImage);
const journeys = await journeysForCity(entry);

const crumbs = breadcrumbSchema([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'Destinations', url: new URL('/destinations/', Astro.site).href },
  { name: city.name, url: new URL(`/cities/${entry.id}/`, Astro.site).href },
]);

const faq = faqSchema(city.faq);

/* T15 §b — the scannable strip. Composed here rather than in the content so
   the labels stay identical across every city page. */
const QUICK_FACTS = [
  { label: 'State / region', value: city.quickFacts.region },
  { label: 'Best months', value: city.quickFacts.bestMonths },
  { label: 'Nearest airport', value: city.quickFacts.nearestAirport },
  { label: 'Nearest rail', value: city.quickFacts.nearestRail },
  { label: 'Known for', value: city.quickFacts.knownFor },
];
---

<Base
  title={city.seo.metaTitle}
  description={city.seo.metaDescription}
  ogImage={city.seo.ogImage}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={heroLink.href}
      imagesrcset={heroLink.imagesrcset}
      imagesizes={heroLink.imagesizes}
      type={heroLink.type}
      fetchpriority="high"
    />
    <JsonLd schema={crumbs} />
    <JsonLd schema={faq} />
  </Fragment>

  <Header slot="header" />

  <!-- a · Hero ---------------------------------------------------------- -->
  <Hero image={city.heroImage} alt={city.heroImageAlt} height="short">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/destinations/">Destinations</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{city.name}</span>
    </nav>
    <p class="city__state">{city.state}</p>
    <h1 class="city__title">{city.name}</h1>
    <p class="city__hook">{city.hook}</p>
  </Hero>

  <!-- b · Quick facts ---------------------------------------------------- -->
  <section class="facts band-offwhite" aria-label={`${city.name} at a glance`}>
    <div class="container-content">
      <dl class="facts__grid">
        {QUICK_FACTS.map((fact) => (
          <div class="facts__item">
            <dt class="facts__label">{fact.label}</dt>
            <dd class="facts__value">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- c · Intro ---------------------------------------------------------- -->
  <section class="band band-tight" aria-labelledby="intro-heading">
    <div class="container-content intro__layout">
      <h2 id="intro-heading" class="intro__label">About {city.name}</h2>
      <div class="intro prose-measure fade-up">
        {city.intro.map((paragraph) => <p class="intro__p">{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!-- d · What to see & do ------------------------------------------------ -->
  <section class="band band-tight" aria-labelledby="see-heading">
    <div class="container-content">
      <h2 id="see-heading">What to see and do in {city.name}</h2>

      <ul class="tiles fade-up-stagger">
        {city.experiences.map((experience) => (
          <li class="tile">
            <span class="tile__frame">
              {/*
                `fetchpriority="low"` is doing real work here, not tidying.
                Chrome's lazy-load threshold is generous enough that all four
                tiles are requested while the hero is still arriving, and on a
                simulated 4G connection that contention alone took this page's
                LCP to 2.4s. Lazy says "maybe later"; low says "and behind the
                thing being measured".
              */}
              <Image
                src={experience.image}
                alt={experience.imageAlt}
                widths={[320, 480, 720]}
                sizes="(min-width: 64rem) 21rem, (min-width: 40rem) 30vw, 90vw"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                quality={58}
                class="tile__img"
              />
            </span>
            <h3 class="tile__name">{experience.name}</h3>
            <p class="tile__text">{experience.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- e · Journeys that visit — the conversion core ---------------------- -->
  {
    journeys.length > 0 && (
      <section class="band band-offwhite" aria-labelledby="journeys-heading">
        <div class="container-content">
          <div class="sectionhead">
            <div>
              <p class="eyebrow">Journeys</p>
              <h2 id="journeys-heading">Trips that visit {city.name}</h2>
            </div>
            <a class="pill tap-target" href="/journeys/">
              All journeys
              <svg viewBox="0 0 16 10" aria-hidden="true" focusable="false">
                <path
                  d="M1 5h13M10 1l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>

          <div class="cards fade-up-stagger">
            {journeys.slice(0, 6).map((journey) => (
              <JourneyCard
                slug={journey.id}
                title={journey.data.title}
                image={journey.data.heroImage}
                imageAlt={journey.data.heroImageAlt}
                nights={journey.data.nights}
                days={journey.data.days}
                routeCities={journey.data.routeCities}
                variant={journey.data.variant}
                signatureFeature={journey.data.signatureFeature}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- f · Photo strip ----------------------------------------------------- -->
  <section class="band band-tight" aria-labelledby="gallery-heading">
    <div class="container-content">
      <h2 id="gallery-heading" class="visually-hidden">{city.name} in photographs</h2>
      <!-- data-allow-clip: on a phone this is a snap-scrolling gallery, so the
           content beyond the viewport is reachable by design rather than
           hidden — the same exemption the itinerary route strip carries. -->
      <ul class="strip fade-up-stagger" data-allow-clip>
        {city.photoStrip.map((shot) => (
          <li class="strip__item">
            <Image
              src={shot.image}
              alt={shot.alt}
              widths={[320, 480, 800]}
              sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 80vw"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              quality={58}
              class="strip__img"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- g · Practical notes -------------------------------------------------- -->
  <PracticalNotesGrid
    notes={city.practicalNotes}
    heading={`Practical notes — ${city.name}`}
    surface="offwhite"
  />

  <!-- h · FAQ -------------------------------------------------------------- -->
  <FaqAccordion faq={city.faq} heading={`${city.name} — common questions`} id="faq" />

  <!-- i · Convert ---------------------------------------------------------- -->
  <div id="enquire">
    <ConvertBand
      heading={`Planning ${city.name}?`}
      body={`Tell us when you are thinking of travelling and what else you would like to see. We will build ${city.name} into a route that makes sense, rather than around it.`}
      leadType="general"
      cityName={city.name}
      waContext={city.name}
    />
  </div>

  <Footer slot="footer" />
  <StickyMobileBar slot="after-footer" />
</Base>

<style>
  /* ---- hero copy ------------------------------------------------------- */
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-on-dark-muted);
  }

  .crumbs a {
    color: var(--color-on-dark-muted);
  }

  .crumbs a:hover {
    color: var(--color-white);
  }

  .city__state {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-yellow);
  }

  .city__title {
    margin-top: 0.6rem;
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    color: var(--color-white);
  }

  .city__hook {
    margin-top: 1rem;
    max-width: 46ch;
    font-size: var(--text-xl);
    color: var(--color-on-dark);
  }

  /* ---- b · quick facts -------------------------------------------------- */
  .facts {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .facts__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    margin: 0;
  }

  @media (min-width: 56rem) {
    .facts__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .facts__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .facts__value {
    margin: 0.4rem 0 0;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* ---- c · intro --------------------------------------------------------
     Two columns on a wide screen for the same reason the FAQ has them: a 68ch
     measure alone in a 1280px container reads as an unfinished page rather
     than as generous space. The label earns its place — it is the only thing
     naming the section, which until now was visually hidden. */
  .intro__layout {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .intro__layout {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .intro__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-crimson);
  }

  .intro__p + .intro__p {
    margin-top: 1.1rem;
  }

  .intro__p:first-child {
    font-size: var(--text-xl);
  }

  /* ---- d · experience tiles --------------------------------------------- */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Fixed by the template, not by the upload: a photograph swap in M5 cannot
     reflow this grid. */
  .tile__frame {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: clip;
    background-color: var(--color-offwhite);
  }

  .tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile__name {
    margin-top: 1rem;
    font-size: var(--text-2xl);
  }

  .tile__text {
    margin-top: 0.5rem;
    color: var(--color-ink-muted);
  }

  /* ---- e · journeys ----------------------------------------------------- */
  .sectionhead {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.25rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.1rem;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    color: var(--color-crimson);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .pill:hover {
    border-color: var(--color-crimson);
  }

  .pill svg {
    width: 16px;
    height: 10px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
  }

  /* ---- f · photo strip --------------------------------------------------- */
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(70%, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    /* A horizontal gallery on a phone, a row on a desktop. It is its own
       scroll region, so this is deliberate overflow rather than a leak. */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .strip__item {
    scroll-snap-align: start;
  }

  @media (min-width: 48rem) {
    .strip {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
      overflow-x: visible;
    }
  }

  .strip__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
</style>
