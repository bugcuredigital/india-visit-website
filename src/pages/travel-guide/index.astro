---
/**
 * Travel Guide index — PAGE_TEMPLATES T8.
 * ---------------------------------------------------------------------------
 * Moved into Phase 1 at PRD v1.4 with 8 launch articles. One exists at M4;
 * the template is built for the full set and degrades honestly to what is
 * there — a featured card and nothing else, rather than a featured card over
 * an empty grid with category chips that filter nothing.
 */
import { getCollection } from 'astro:content';

import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BandWatermark from '../../components/BandWatermark.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import StickyMobileBar from '../../components/StickyMobileBar.astro';
import Button from '../../components/Button.astro';
import JsonLd from '../../components/JsonLd.astro';

import { breadcrumbSchema } from '../../lib/schema';
import { CATEGORY_LABELS } from '../../lib/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => {
  const byFeatured = Number(b.data.featured) - Number(a.data.featured);
  if (byFeatured !== 0) return byFeatured;
  return b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

const [featured, ...rest] = posts;

/* Chips are built from what actually exists, so a category with no articles
   is not offered as a filter that returns nothing. */
const categories = (Object.keys(CATEGORY_LABELS) as Array<keyof typeof CATEGORY_LABELS>)
  .map((key) => ({ key, label: CATEGORY_LABELS[key], count: rest.filter((p) => p.data.category === key).length }))
  .filter((category) => category.count > 0);

const crumbs = breadcrumbSchema([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'Travel Guide', url: new URL('/travel-guide/', Astro.site).href },
]);
---

<Base
  title="Travel Guide — Planning India | India Visit"
  description="Practical writing on planning a journey through India — visas and timing, the best months to travel, and guides to the regions we know best."
>
  <Fragment slot="head">
    <JsonLd schema={crumbs} />
  </Fragment>

  <Header slot="header" />

  <!-- 1 · Compact hero --------------------------------------------------- -->
  <section class="band band-tight intro">
    <div class="container-content">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Travel Guide</span>
      </nav>
      <h1 class="intro__title">Travel guide</h1>
      <p class="intro__lede prose-measure">
        The things we end up explaining on the phone anyway — when to go, what
        a visa actually involves, and what a region is like once you are in it.
      </p>
    </div>
  </section>

  <!-- 2 · Featured article ------------------------------------------------ -->
  {
    featured && (
      <section class="band band-tight" aria-labelledby="featured-heading">
        <div class="container-content">
          <h2 id="featured-heading" class="visually-hidden">Latest article</h2>
          <div class="featured fade-up">
            <ArticleCard
              slug={featured.id}
              title={featured.data.title}
              category={featured.data.category}
              excerpt={featured.data.excerpt}
              image={featured.data.heroImage}
              imageAlt={featured.data.heroImageAlt}
              publishDate={featured.data.publishDate}
              updatedDate={featured.data.updatedDate}
            />
          </div>
        </div>
      </section>
    )
  }

  <!-- 3 + 4 · Chips and grid ---------------------------------------------- -->
  {
    rest.length > 0 && (
      <section class="band band-tight" aria-labelledby="all-heading">
        <div class="container-content">
          <h2 id="all-heading">More reading</h2>

          {categories.length > 1 && (
            <div class="filter" role="group" aria-label="Filter articles by category">
              <button type="button" class="filter__btn tap-target" data-filter="all" aria-pressed="true">
                All <span class="filter__count">{rest.length}</span>
              </button>
              {categories.map((category) => (
                <button
                  type="button"
                  class="filter__btn tap-target"
                  data-filter={category.key}
                  aria-pressed="false"
                >
                  {category.label} <span class="filter__count">{category.count}</span>
                </button>
              ))}
            </div>
          )}

          <p class="filter__status visually-hidden" role="status" aria-live="polite" />

          <ul class="grid fade-up-stagger" data-article-grid>
            {rest.map((post) => (
              <li class="grid__item" data-category={post.data.category}>
                <ArticleCard
                  slug={post.id}
                  title={post.data.title}
                  category={post.data.category}
                  excerpt={post.data.excerpt}
                  image={post.data.heroImage}
                  imageAlt={post.data.heroImageAlt}
                  publishDate={post.data.publishDate}
                  updatedDate={post.data.updatedDate}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    /* `<=` here would be parsed as a fragment tag by the Astro compiler. */
    posts.length < 2 && (
      <section class="band band-tight" aria-label="Coming soon">
        <div class="container-content">
          <p class="pending prose-measure">
            Seven more articles are written and land with the rest of the
            catalogue in M5.
          </p>
        </div>
      </section>
    )
  }

  <!-- 5 · Newsletter band -------------------------------------------------- -->
  <section class="band band-tight band-burgundy band-watermarked on-dark" aria-labelledby="news-heading">
    <BandWatermark side="right" />
    <div class="container-content news">
      <div>
        <p class="eyebrow">Twice a month</p>
        <h2 id="news-heading" class="news__heading">Travel inspiration, not a mailing list</h2>
        <p class="news__detail">
          One note a fortnight: where is good right now, what has changed about
          getting there, and the occasional itinerary we are proud of. Unsubscribe
          in one click.
        </p>
      </div>

      <!-- Shell only; wired to the Pages Function in M6 alongside the enquiry
           form. `intent` tags the submission so a newsletter sign-up never
           lands in the sales inbox as a lead. -->
      <form class="news__form" method="post" action="/api/lead" data-lead-form novalidate>
        <input type="hidden" name="intent" value="newsletter" />
        <input type="hidden" name="pageUrl" value={Astro.url.pathname} />
        <label class="news__label" for="news-email">Your email</label>
        <div class="news__row">
          <input
            class="news__input"
            id="news-email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
          <Button type="submit" variant="on-dark">Subscribe</Button>
        </div>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
  <StickyMobileBar slot="after-footer" waContext="Travel guide" />
</Base>

<script is:inline>
  (() => {
    const grid = document.querySelector('[data-article-grid]');
    const buttons = document.querySelectorAll('[data-filter]');
    const status = document.querySelector('.filter__status');
    if (!grid || !buttons.length) return;
    const items = Array.from(grid.children);

    const apply = (key) => {
      let shown = 0;
      for (const item of items) {
        const match = key === 'all' || item.dataset.category === key;
        item.hidden = !match;
        if (match) shown += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === key));
      }
      if (status) status.textContent = `Showing ${shown} ${shown === 1 ? 'article' : 'articles'}.`;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter));
    }
  })();
</script>

<style>
  .intro {
    border-bottom: 1px solid var(--color-hairline);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .crumbs a {
    color: var(--color-ink-muted);
  }

  .crumbs a:hover {
    color: var(--color-crimson);
  }

  .intro__title {
    font-size: var(--text-h1);
  }

  .intro__lede {
    margin-top: 1rem;
    font-size: var(--text-xl);
    color: var(--color-ink-muted);
  }

  /* The featured card gets the full container width and a wider image; the
     grid below it does not. One article is the offer, the rest are the shelf. */
  .featured :global(.card__media) {
    aspect-ratio: 21 / 9;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 2rem;
  }

  :global(html:not(.js)) .filter {
    display: none;
  }

  .filter__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.1rem;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .filter__btn:hover {
    border-color: var(--color-crimson);
    color: var(--color-crimson);
  }

  .filter__btn[aria-pressed='true'] {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-white);
  }

  .filter__count {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    opacity: 0.65;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .grid__item {
    display: flex;
  }

  .grid__item > :global(*) {
    width: 100%;
  }

  .pending {
    font-style: italic;
    color: var(--color-ink-muted);
  }

  /* ---- newsletter ------------------------------------------------------- */
  .news {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .news {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .news__heading {
    margin-top: 1rem;
    font-size: var(--text-h2);
  }

  .news__detail {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--color-on-dark-muted);
  }

  .news__label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .news__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .news__input {
    flex: 1 1 14rem;
    min-height: 48px;
    padding: 0 1rem;
    border: 1px solid color-mix(in srgb, var(--color-on-dark) 35%, transparent);
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--color-on-dark) 10%, transparent);
    color: var(--color-on-dark);
    font-family: var(--font-body);
    font-size: var(--text-base);
  }

  .news__input:focus-visible {
    outline: 3px solid var(--color-yellow);
    outline-offset: 2px;
  }
</style>
