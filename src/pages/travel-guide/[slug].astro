---
/**
 * Article — PAGE_TEMPLATES T9.
 * ---------------------------------------------------------------------------
 * The conversion rule is structural rather than editorial: every article
 * embeds at least one journey card, enforced in the schema by
 * `embeddedJourneys.min(1)`. An article that cannot route a reader to a trip
 * is a blog post, and this is not a blog.
 *
 * The author block exists for E-E-A-T. It says "twenty years curating India"
 * and nothing that has not been verified — no name, because the founder's
 * name is still null by design (see the `founder` note in content.config.ts).
 */
import { getCollection, getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';

import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import JourneyCard from '../../components/JourneyCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ConvertBand from '../../components/ConvertBand.astro';
import StickyMobileBar from '../../components/StickyMobileBar.astro';
import JsonLd from '../../components/JsonLd.astro';
import Lotus from '../../components/Lotus.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

import { getSiteSettings } from '../../lib/site-settings';
import { byId } from '../../lib/order';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { categoryLabel, readingTime } from '../../lib/posts';
import { heroPreload, HERO_FORMATS, HERO_QUALITY } from '../../lib/hero-image';

/**
 * The article hero IS the LCP element, so it gets the same treatment every
 * other hero on the site gets — AVIF first and a matched preload.
 *
 * It shipped without one and measured 2.6s, past the 2.5s hard ceiling: a
 * plain <Image> is WebP-only and unpreloaded, so the browser did not learn
 * about the largest thing on the page until it had parsed down to it. The
 * widths stop at 1280 because this image is capped by the prose container, not
 * by the viewport, and `sizes` is passed to BOTH sides so the preload and the
 * element resolve to one file.
 */
const HEAD_WIDTHS = [480, 640, 960, 1280];
const HEAD_SIZES = '(min-width: 64rem) 68rem, 96vw';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const post = entry.data;
const { Content, headings } = await render(entry);

const settings = await getSiteSettings();
const minutes = readingTime(entry.body ?? '');

/* TOC only when there is enough structure to be worth one (T9 §2). Four
   headings is the threshold: three links is a list, not a table of contents. */
const sections = headings.filter((heading) => heading.depth === 2);
const showToc = sections.length >= 4;

const embedded = (
  await Promise.all(post.embeddedJourneys.map((ref) => getEntry('journeys', ref.id)))
).filter((journey) => journey !== undefined && !journey.data.draft);

/* Related reading, ranked by what the articles share (round 5, #63): newest
   first meant seven posts with one date fell to file order, three posts took
   21 of the 24 slots, four were never recommended, and the Palace on Wheels
   guide recommended the Bali visa guide. Two points for the same category,
   one for each destination the two articles' journeys share; the date, then
   the id, only break ties. */
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const allJourneys = await getCollection('journeys', ({ data }) => !data.draft);
const destinationsOf = (refs: Array<{ id: string }>) =>
  new Set(
    refs.flatMap((ref) => allJourneys.find((journey) => journey.id === ref.id)?.data.destinations ?? []),
  );
const ownDestinations = destinationsOf(post.embeddedJourneys);
const relatedness = (other: (typeof allPosts)[number]) =>
  (other.data.category === post.category ? 2 : 0) +
  [...destinationsOf(other.data.embeddedJourneys)].filter((slug) => ownDestinations.has(slug)).length;

const related = allPosts
  .filter((item) => item.id !== entry.id)
  .sort(
    (a, b) =>
      relatedness(b) - relatedness(a) ||
      b.data.publishDate.getTime() - a.data.publishDate.getTime() ||
      byId(a, b),
  )
  .slice(0, 3);

/* The journey card goes MID-body (T9 §3, round 5, #62), before the H2 that
   opens the second half, rather than after the last paragraph. The body is
   split on the rendered HTML at that heading. An article with fewer than two
   H2s, or a body carrying Astro's image placeholders (which only <Content />
   resolves), keeps the card after the text. */
const html = entry.rendered?.html ?? '';
const h2At = [...html.matchAll(/<h2[\s>]/g)].map((match) => match.index ?? 0);
const splitAt = h2At.length >= 2 && !html.includes('__ASTRO_IMAGE_') ? h2At[Math.ceil(h2At.length / 2)] : undefined;
const bodyHalves = splitAt === undefined ? null : { before: html.slice(0, splitAt), after: html.slice(splitAt) };

const pageUrl = new URL(`/travel-guide/${entry.id}/`, Astro.site).href;
const siteUrl = Astro.site?.href ?? '/';

const schemas = [
  articleSchema({
    siteUrl,
    url: pageUrl,
    headline: post.title,
    description: post.seo.metaDescription,
    image: new URL(post.heroImage.src, Astro.site).href,
    datePublished: post.publishDate,
    dateModified: post.updatedDate,
    authorName: settings.siteName,
  }),
  breadcrumbSchema([
    { name: 'Home', url: siteUrl },
    { name: 'Travel Guide', url: new URL('/travel-guide/', Astro.site).href },
    { name: post.title, url: pageUrl },
  ]),
];
if (post.faq) schemas.push(faqSchema(post.faq));

const headLink = await heroPreload(post.heroImage, HEAD_WIDTHS, HEAD_SIZES);

const dateLabel = (post.updatedDate ?? post.publishDate).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={post.seo.metaTitle} description={post.seo.metaDescription} ogImage={post.seo.ogImage}>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={headLink.href}
      imagesrcset={headLink.imagesrcset}
      imagesizes={headLink.imagesizes}
      type={headLink.type}
      fetchpriority="high"
    />
    {schemas.map((schema) => <JsonLd schema={schema} />)}
  </Fragment>

  <Header slot="header" />

  <!-- 1 · Slim hero ------------------------------------------------------ -->
  <article class:list={{ 'article--centred': !showToc }}>
    <header class="band band-tight band-ruled head">
      <div class="container-content">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Travel Guide', href: '/travel-guide/' },
            { label: post.title },
          ]}
        />

        <p class="eyebrow">{categoryLabel(post.category)}</p>
        <h1 class="head__title prose-measure">{post.title}</h1>

        <p class="head__meta">
          <span class="head__author">
            <Lotus size={16} class="head__mark" />
            <span>{settings.siteName} · {settings.yearsExperience} years curating India</span>
          </span>
          <span class="head__dot" aria-hidden="true">·</span>
          <time datetime={(post.updatedDate ?? post.publishDate).toISOString()}>{dateLabel}</time>
          {post.updatedDate && <span class="visually-hidden">(updated)</span>}
          <span class="head__dot" aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>

        <Picture
          src={post.heroImage}
          alt={post.heroImageAlt}
          widths={HEAD_WIDTHS}
          sizes={HEAD_SIZES}
          formats={[...HERO_FORMATS]}
          fallbackFormat="webp"
          quality={HERO_QUALITY}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          class="head__image"
          pictureAttributes={{ class: 'head__picture' }}
        />
      </div>
    </header>

    <!-- 2 + 3 · TOC and body --------------------------------------------- -->
    <div class="band band-tight">
      <div class:list={['container-content', 'body', { 'body--toc': showToc }]}>
        {
          /* Two renderings of one list, one shown at a time: the sticky
             sidebar from 64rem, a closed <details> below it (T9 §2,
             "collapsible mobile"). On a phone the open list of 4–8 links
             pushed the first paragraph to 890–1,060px of an 844px screen
             (round 5, #60). A display:none copy is out of the tab order and
             the accessibility tree, so nothing is announced twice. */
          showToc && (
            <nav class="toc" aria-labelledby="toc-heading">
              <h2 id="toc-heading" class="toc__heading toc__wide">On this page</h2>
              <ol class="toc__list toc__wide">
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.slug}`}>{section.text}</a>
                  </li>
                ))}
              </ol>
              <details class="toc__fold">
                <summary class="toc__summary">
                  <span>On this page</span>
                  <svg class="toc__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                    <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ol class="toc__list">
                  {sections.map((section) => (
                    <li>
                      <a href={`#${section.slug}`}>{section.text}</a>
                    </li>
                  ))}
                </ol>
              </details>
            </nav>
          )
        }

        <div class="body__main">
          <ArticleBody>
            {bodyHalves ? <Fragment set:html={bodyHalves.before} /> : <Content />}
          </ArticleBody>

          <!-- Required: at least one journey card mid-article (T9 §3). The
               schema enforces the minimum, so this can never render empty. -->
          {
            embedded.length > 0 && (
              <aside class:list={['embed', { 'embed--single': embedded.length === 1 }]} aria-labelledby="embed-heading">
                <div>
                  <p class="eyebrow">Travel this</p>
                  <h2 id="embed-heading" class="embed__heading">The journey behind the writing</h2>
                </div>
                <div class="embed__cards">
                  {embedded.map((journey) => (
                    <JourneyCard
                      slug={journey!.id}
                      title={journey!.data.title}
                      image={journey!.data.heroImage}
                      imageAlt={journey!.data.heroImageAlt}
                      nights={journey!.data.nights}
                      days={journey!.data.days}
                      variant={journey!.data.variant}
                    />
                  ))}
                </div>
              </aside>
            )
          }

          {
            bodyHalves && (
              <ArticleBody>
                <Fragment set:html={bodyHalves.after} />
              </ArticleBody>
            )
          }

          <!-- 4 · Author block — E-E-A-T ---------------------------------- -->
          <aside class="author">
            <Lotus size={22} tone="crimson" />
            <div>
              <p class="author__name">{settings.siteName}</p>
              <!-- Neutral attribution until the client confirms an authorship
                   claim: "written by the person who plans them" was struck
                   (round 5, #58), and "India and its neighbours" was untrue
                   of Bali and Vietnam. -->
              <p class="author__bio">
                From the {settings.siteName} travel desk: {settings.yearsExperience}
                years arranging private journeys across India and beyond.
              </p>
            </div>
          </aside>
        </div>
      </div>
    </div>

    <!-- FAQ, where the article has one ---------------------------------- -->
    {post.faq && <FaqAccordion faq={post.faq} heading="Questions this raises" id="faq" surface="offwhite" />}
  </article>

  <!-- 5 · Convert ---------------------------------------------------------- -->
  <div id="enquire">
    <ConvertBand
      heading="Planning this trip?"
      body="If this is the journey you have in mind, tell us your dates and we will draft it properly, day by day, with a price."
      leadType="general"
      waContext={post.title}
    />
  </div>

  <!-- 6 · Related ---------------------------------------------------------- -->
  {
    related.length > 0 && (
      <section class="band band-tight" aria-labelledby="related-heading">
        <div class="container-content">
          <h2 id="related-heading">More from the guide</h2>
          <div class="related fade-up-stagger">
            {related.map((item) => (
              <ArticleCard
                slug={item.id}
                title={item.data.title}
                category={item.data.category}
                excerpt={item.data.excerpt}
                image={item.data.heroImage}
                imageAlt={item.data.heroImageAlt}
                body={item.body ?? ''}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Footer slot="footer" />
  <StickyMobileBar slot="after-footer" waContext={post.title} enquireHref="#enquire" />
</Base>

<style>
  .head__title {
    margin-top: 0.75rem;
    font-size: var(--text-h1);
    line-height: var(--leading-display);
  }

  .head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .head__author {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .head__dot {
    opacity: 0.5;
  }

  .head__picture {
    display: block;
    margin-top: 2rem;
  }

  /* 21:9 from 48rem (T9 §1, "slim"; round 5, #59): at 16:9 the article's
     first screen at 1280 was all picture and no text. A phone keeps 16:9,
     where 21:9 would be a 150px strip. */
  .head__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 48rem) {
    .head__image {
      aspect-ratio: 21 / 9;
    }
  }

  /* ---- TOC + body ------------------------------------------------------- */
  .body {
    display: grid;
    gap: 2rem;
  }

  /* Without a table of contents, the title, the picture and the text share
     ONE centred column on desktop (round 6), instead of a left-hung measure
     beside an empty right half. The column is the reading measure itself, so
     lines stay at the ~68ch cap (the spec's 46rem would have run them to
     ~78). */
  @media (min-width: 64rem) {
    .article--centred :is(.head > .container-content, .body) {
      max-width: calc(var(--container-prose) + 2 * var(--space-gutter));
    }
  }

  /* Two columns only when there is a table of contents to fill the first.
     Without one, the body fell into the 16rem TOC column, ~28 characters a
     line beside an empty one (round 5, #57). */
  @media (min-width: 64rem) {
    .body--toc {
      grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .toc {
      position: sticky;
      top: 6rem;
    }
  }

  .toc__fold {
    display: none;
  }

  @media (max-width: 63.999rem) {
    .toc__wide {
      display: none;
    }

    .toc__fold {
      display: block;
      border-block: 1px solid var(--color-hairline);
    }
  }

  .toc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .toc__summary::-webkit-details-marker {
    display: none;
  }

  .toc__chevron {
    width: 12px;
    height: 8px;
    color: var(--color-burgundy);
  }

  .toc__fold .toc__list {
    margin: 0.25rem 0 1rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc__chevron {
      transition: transform var(--duration-base) var(--ease-brand);
    }

    .toc__fold[open] .toc__chevron {
      transform: rotate(180deg);
    }
  }

  .toc__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .toc__list {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
  }

  .toc__list li + li {
    margin-top: 0.6rem;
  }

  .toc__list a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .toc__list a:hover {
    color: var(--color-crimson);
    text-decoration: underline;
  }

  /* ---- embedded journey -------------------------------------------------
     Inside the text column, ruled above and below at the column's width: it
     sat after the last paragraph, alone in an 880px row, with its hairline
     running 151px past the text (round 5, #62). One card stands beside its
     heading rather than under it with an empty half beside it. */
  .embed {
    max-width: var(--container-prose);
    margin-block: 3rem;
    padding-block: 2rem;
    border-block: 1px solid var(--color-hairline);
  }

  .embed__heading {
    margin-top: 0.5rem;
    font-size: var(--text-2xl);
  }

  .embed__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 40rem) {
    .embed--single {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
      gap: 2rem;
      align-items: center;
    }

    .embed--single .embed__cards {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
    }
  }

  /* ---- author ------------------------------------------------------------ */
  .author {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-offwhite);
    max-width: var(--container-prose);
  }

  .author__name {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .author__bio {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin-top: 2rem;
  }
</style>
