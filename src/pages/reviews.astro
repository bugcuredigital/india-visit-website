---
/**
 * Reviews — PAGE_TEMPLATES T7.
 * ---------------------------------------------------------------------------
 * Every REAL testimonial here has `consentConfirmed: true`, enforced twice:
 * the schema refuses a real entry whose consent is not recorded, and this page
 * filters on it as well. Two gates for the same rule is deliberate — an
 * un-consented quote published on a travel site names a real customer and
 * their trip.
 *
 * Placeholder SLOTS (round 3) carry no name, no origin and no quote — the
 * schema refuses those fields when `placeholder` is true — and render one
 * quiet line. They never reach the structured data.
 *
 * The AGGREGATE LINE (T7 §1) renders only if `aggregateRating` is verified.
 * It is null (PRD Open Question #3), so the page carries no star average, and
 * emits no `AggregateRating` schema either — a machine-readable rating is
 * worse than an on-screen one, because aggregators republish it.
 *
 * The GUEST GALLERY (T7 §4) is absent for the same reason: photo consent is a
 * separate permission from quote consent, and nobody has given it yet.
 */
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConvertBand from '../components/ConvertBand.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import JsonLd from '../components/JsonLd.astro';
import Lotus from '../components/Lotus.astro';

import { getSiteSettings } from '../lib/site-settings';
import { breadcrumbSchema, reviewSchema } from '../lib/schema';

const settings = await getSiteSettings();

/* Placeholder SLOTS render alongside real reviews and say one quiet line.
   They are counted separately everywhere it matters: the chip counts, the
   filter status and — most importantly — the structured data below. */
const reviews = (
  await getCollection('testimonials', ({ data }) => data.placeholder || data.consentConfirmed)
).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const realReviews = reviews.filter((review) => !review.data.placeholder);

const CATEGORY_LABELS: Record<string, string> = {
  india: 'India',
  international: 'International',
  trains: 'Trains',
  corporate: 'Corporate',
};

/* Chips come from what exists, so no chip ever filters to nothing. */
const categories = Object.keys(CATEGORY_LABELS)
  .map((key) => ({ key, label: CATEGORY_LABELS[key], count: reviews.filter((r) => r.data.category === key).length }))
  .filter((category) => category.count > 0);

const crumbs = breadcrumbSchema([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'Reviews', url: new URL('/reviews/', Astro.site).href },
]);

/* REAL REVIEWS ONLY. A placeholder emitted as `Review` structured data would
   publish a fabricated review to every aggregator that reads this page — worse
   than an on-screen one, because we could not take it back. */
const reviewSchemas = realReviews.map((review) =>
  reviewSchema({
    author: review.data.name!,
    reviewBody: review.data.quote!,
    itemName: review.data.tripLabel,
  }),
);
---

<Base
  title="Guest Stories & Reviews | India Visit"
  description="What travellers say about journeys we planned — in their words, published only with their consent."
>
  <Fragment slot="head">
    <JsonLd schema={crumbs} />
    {reviewSchemas.map((schema) => <JsonLd schema={schema} />)}
  </Fragment>

  <Header slot="header" />

  <!-- 1 · Compact hero ---------------------------------------------------- -->
  <section class="band band-tight intro">
    <div class="container-content">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Reviews</span>
      </nav>
      <h1 class="intro__title">Guest stories</h1>
      {
        /* Only with a verified figure. No stars, no "rated by N travellers",
           and no AggregateRating in the structured data until then. */
        settings.aggregateRating ? (
          <p class="intro__rating">
            Rated {settings.aggregateRating.toFixed(1)} across {realReviews.length} reviews
          </p>
        ) : (
          <p class="intro__lede prose-measure">
            Published in the traveller's own words, and only with their written
            permission. We would rather show you a handful we can stand behind
            than a wall of them we cannot.
          </p>
        )
      }
    </div>
  </section>

  <!-- 2 + 3 · Chips and the review wall ------------------------------------ -->
  <section class="band band-tight" aria-labelledby="wall-heading">
    <div class="container-content">
      <h2 id="wall-heading" class="visually-hidden">Reviews</h2>

      {
        categories.length > 1 && (
          <div class="filter" role="group" aria-label="Filter reviews">
            <button type="button" class="filter__btn tap-target" data-filter="all" aria-pressed="true">
              All <span class="filter__count">{reviews.length}</span>
            </button>
            {categories.map((category) => (
              <button type="button" class="filter__btn tap-target" data-filter={category.key} aria-pressed="false">
                {category.label} <span class="filter__count">{category.count}</span>
              </button>
            ))}
          </div>
        )
      }

      <p class="filter__status visually-hidden" role="status" aria-live="polite"></p>

      <ul class="wall fade-up-stagger" data-review-wall>
        {
          reviews.map((review) => (
            <li class="wall__item" data-category={review.data.category}>
              <figure class:list={['review', { 'review--empty': review.data.placeholder }]}>
                <!-- data-allow-clip: hanging off the card corner is the design. -->
                <span class="review__watermark" data-allow-clip aria-hidden="true"><Lotus size={132} /></span>

                {review.data.placeholder ? (
                  <p class="review__pending">
                    <Lotus size={18} tone="burgundy" class="review__pendingmark" />
                    <span>Guest review coming soon</span>
                  </p>
                ) : (
                  <blockquote class="review__quote">
                    <p>{review.data.quote}</p>
                  </blockquote>
                )}

                <figcaption class="review__by">
                  {review.data.name && <span class="review__name">{review.data.name}</span>}
                  {review.data.origin && <span class="review__origin">{review.data.origin}</span>}
                  <span class="review__trip">{review.data.tripLabel}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <p class="wall__note prose-measure">
        More guest stories are being collected with permission and join this
        page as they are confirmed.
      </p>
    </div>
  </section>

  <!-- 5 · Convert ----------------------------------------------------------- -->
  <ConvertBand
    heading="Become our next story"
    body="Tell us what you have in mind and we will plan it properly. If it goes well, we may ask whether you would like to say so here — and you are entirely free to say no."
    leadType="general"
    waContext="Reviews"
  />

  <Footer slot="footer" />
  <StickyMobileBar slot="after-footer" waContext="Reviews" />
</Base>

<script is:inline>
  (() => {
    const wall = document.querySelector('[data-review-wall]');
    const buttons = document.querySelectorAll('[data-filter]');
    const status = document.querySelector('.filter__status');
    if (!wall || !buttons.length) return;
    const items = Array.from(wall.children);

    const apply = (key) => {
      let shown = 0;
      for (const item of items) {
        const match = key === 'all' || item.dataset.category === key;
        item.hidden = !match;
        if (match) shown += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === key));
      }
      if (status) status.textContent = `Showing ${shown} ${shown === 1 ? 'review' : 'reviews'}.`;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter));
    }
  })();
</script>

<style>
  .intro {
    border-bottom: 1px solid var(--color-hairline);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .crumbs a {
    color: var(--color-ink-muted);
  }

  .crumbs a:hover {
    color: var(--color-crimson);
  }

  .intro__title {
    font-size: var(--text-h1);
  }

  .intro__lede,
  .intro__rating {
    margin-top: 1rem;
    font-size: var(--text-xl);
    color: var(--color-ink-muted);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  :global(html:not(.js)) .filter {
    display: none;
  }

  .filter__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.1rem;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .filter__btn:hover {
    border-color: var(--color-crimson);
    color: var(--color-crimson);
  }

  .filter__btn[aria-pressed='true'] {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-white);
  }

  .filter__count {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    opacity: 0.65;
  }

  /* Two columns rather than masonry: a masonry wall of four reviews is a
     column of four reviews with extra CSS. */
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(21rem, 100%), 1fr));
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .review {
    position: relative;
    height: 100%;
    margin: 0;
    padding: 2rem 1.75rem 1.75rem;
    border: 1px solid var(--color-burgundy-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-offwhite);
    overflow: clip;
    isolation: isolate;
  }

  .review__watermark {
    position: absolute;
    top: -2.25rem;
    right: -2.25rem;
    z-index: -1;
    color: var(--color-burgundy);
    opacity: 0.07;
    pointer-events: none;
    line-height: 0;
  }

  .review__quote {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  /* Short, quiet, unmistakably not a review (word control, round 3). */
  .review__pending {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .review__pendingmark {
    opacity: 0.75;
  }

  .review__by {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-burgundy-hairline);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .review__name {
    display: block;
    font-weight: 600;
  }

  .review__origin {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-ink-muted);
  }

  .review__trip {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    border: 1px solid var(--color-burgundy-hairline);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-burgundy);
  }

  .wall__note {
    margin-top: 2rem;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-ink-muted);
  }
</style>
