---
/**
 * /journeys/{slug}/ — ONE template, BOTH variants.
 * ---------------------------------------------------------------------------
 * This is the file the client's original request is really about: editors pick
 * a variant, fill fields, and every one of the 20 pages comes out looking like
 * a sibling. Layout is never an editorial decision.
 *
 * Section order is Template Spec §3, verbatim:
 *   A: Hero → Quick Facts → Intro → Highlights → Glance → Days(+Map)
 *      → [Inclusions] → Practical Notes → Convert band → Related
 *   B: … → Highlights → Cabins → Glance → Days(+Map) → Inclusions
 *      → Departures → Booking process → Practical Notes → Convert band
 *      → Policies → Related
 *
 * Two spec tensions resolved here, both documented rather than silently
 * decided:
 *  1. §3's Variant B chain omits S13 Practical Notes, but S13 is marked ●
 *     (required on EVERY itinerary) and the schema requires `practicalNotes`
 *     on both variants. It renders on B too, after the booking process.
 *  2. §6 says a page "ends at the Customise/Availability band before
 *     Related", while §3 puts B's policies after that band. §3 wins (the
 *     Template Spec governs itinerary structure) and §6's actual failure
 *     condition — a page *ending* on policy text — still cannot happen,
 *     because Related follows.
 *
 * There is deliberately no price anywhere on this template. Variant A prices
 * live on the cards behind `siteSettings.showPrices`; Variant B has no tariff
 * field at all (CLAUDE.md invariant #6, permanent).
 */
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Logo from '../../components/Logo.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import QuickFactsBar from '../../components/QuickFactsBar.astro';
import HighlightsGrid from '../../components/HighlightsGrid.astro';
import GlanceTable from '../../components/GlanceTable.astro';
import DayAccordion from '../../components/DayAccordion.astro';
import InclusionsBlock from '../../components/InclusionsBlock.astro';
import CabinCards from '../../components/CabinCards.astro';
import BookingStepper from '../../components/BookingStepper.astro';
import PoliciesAccordion from '../../components/PoliciesAccordion.astro';
import PracticalNotesGrid from '../../components/PracticalNotesGrid.astro';
import ConvertBand from '../../components/ConvertBand.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import RelatedJourneys from '../../components/RelatedJourneys.astro';
import StickyMobileBar from '../../components/StickyMobileBar.astro';
import Button from '../../components/Button.astro';
import JsonLd from '../../components/JsonLd.astro';
import { Image } from 'astro:assets';

import { getSiteSettings, whatsappLink } from '../../lib/site-settings';
import { heroPreload } from '../../lib/hero-image';
import { getCityIndex, cityLinkFor, citiesMentionedIn } from '../../lib/cities';
import { touristTripSchema, breadcrumbSchema } from '../../lib/schema';

type Journey = CollectionEntry<'journeys'>;

export async function getStaticPaths() {
  const journeys = await getCollection('journeys', ({ data }) => !data.draft);
  return journeys.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

/* No `interface Props` here on purpose: for a dynamic route Astro infers the
   prop types from getStaticPaths, so declaring them again is dead code — and
   `astro check` says so. */
const { entry } = Astro.props;
const journey = entry.data;
const { Content } = await render(entry);
const settings = await getSiteSettings();

/* ---------------------------------------------------------------- related --
   Editorially assigned first (Template Spec S15). Until the siblings exist in
   M5 that list is empty on every seed, so we top it up with other journeys —
   same variant first, since "Kerala → another custom journey" is a closer
   neighbour than "Kerala → a fixed-departure train". The section simply does
   not render if nothing is available, rather than showing one lonely card in a
   three-card grid. */
const allJourneys = await getCollection('journeys', ({ data }) => !data.draft);

const manualRelated = (
  await Promise.all(journey.related.map((ref) => getEntry(ref)))
).filter((item): item is Journey => Boolean(item));

const autoFill = allJourneys
  .filter((item) => item.id !== entry.id && !manualRelated.some((m) => m.id === item.id))
  .sort((a, b) => Number(b.data.variant === journey.variant) - Number(a.data.variant === journey.variant));

const relatedEntries = [...manualRelated, ...autoFill].slice(0, 3);

const relatedCards = relatedEntries.map((item) => ({
  slug: item.id,
  title: item.data.title,
  image: item.data.heroImage,
  imageAlt: item.data.heroImageAlt,
  nights: item.data.nights,
  days: item.data.days,
  variant: item.data.variant,
}));

/* ------------------------------------------------------------------- copy --
   The two variants ask for different things, so the CTA verbs differ (S1) and
   the convert band's promise differs (S14). Everything else is shared. */
const isTrain = journey.variant === 'B';

const primaryCta = isTrain ? 'Check Availability' : 'Customise This Journey';
const convertHeading = isTrain
  ? 'Departures fill early — check availability for your dates'
  : 'Shall we tailor this to your dates?';
const convertBody =
  journey.customiseCopy ??
  (isTrain
    ? 'Tell us your preferred season and cabin and we will come back with what is still open, and what it involves.'
    : 'This itinerary can be tailored to your dates, pace and interests — extend a stay, add a retreat, change the order. Our team handles every transfer, guide and reservation.');

const waContext = `${journey.title} (${journey.nights}N/${journey.days}D)`;

/* Intro length decides whether the expander appears at all (S3: ~120 words
   visible, "read more" beyond). Counted on the raw markdown, so it costs
   nothing at runtime. */
const introWordCount = entry.body?.trim().split(/\s+/).length ?? 0;
const introNeedsExpander = introWordCount > 130;

/* --------------------------------------------------------------- metadata --
   A train page's parent is /luxury-trains/, a custom journey's is /journeys/.
   That is true for the visitor and true for the crawler, so the breadcrumb
   reflects it rather than flattening both into one trail. */
const siteUrl = Astro.site?.href ?? '/';
const pageUrl = new URL(`/journeys/${entry.id}/`, Astro.site).href;
const parent = isTrain
  ? { name: 'Luxury Trains', url: new URL('/luxury-trains/', Astro.site).href }
  : { name: 'Journeys', url: new URL('/journeys/', Astro.site).href };

const tripSchema = touristTripSchema({
  siteUrl,
  url: pageUrl,
  name: journey.title,
  description: journey.seo.metaDescription,
  image: new URL(journey.heroImage.src, Astro.site).href,
  days: journey.days,
  nights: journey.nights,
  routeCities: journey.routeCities,
});

/* Invariant #3: the hero is preloaded as well as fetchpriority="high". Same
   widths as <Hero>, so this resolves to the identical file — one download. */
const heroLink = await heroPreload(journey.heroImage);

/* ------------------------------------------------------------ city links --
   Route-strip entries and day titles link to /cities/{slug}/ where a city page
   exists, and stay plain text where one does not (PRD v1.5). Nothing here is
   authored per journey: the whole cross-link layer is derived, so growing the
   city set from two to fifteen touches no journey content at all. */
const cityIndex = await getCityIndex();

const routeChips = journey.routeCities.map((cityName) => ({
  name: cityName,
  link: cityLinkFor(cityIndex, cityName),
}));

const itineraryDays = journey.itineraryDays.map((day) => ({
  ...day,
  cities: citiesMentionedIn(cityIndex, day.title),
}));

const crumbs = breadcrumbSchema([
  { name: 'Home', url: siteUrl },
  parent,
  { name: journey.title, url: pageUrl },
]);
---

<Base
  title={journey.seo.metaTitle}
  description={journey.seo.metaDescription}
  ogImage={journey.seo.ogImage ?? journey.heroImage.src}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={heroLink.href}
      imagesrcset={heroLink.imagesrcset}
      imagesizes={heroLink.imagesizes}
      type={heroLink.type}
      fetchpriority="high"
    />
    <JsonLd schema={tripSchema} />
    <JsonLd schema={crumbs} />
  </Fragment>

  <Header slot="header" />

  <!-- Print only: the brand line at the top of the PDF (scripts/build-pdfs.mjs).
       Everything in it is siteSettings, so the PDF cannot carry a stale number. -->
  <div class="print-only print-brand">
    <Logo height={36} isHome={true} />
    <p class="print-brand__line">
      <strong>{settings.siteName}</strong> · {settings.phone} · {settings.email}
      <span class="print-brand__url">{Astro.url.href}</span>
    </p>
  </div>

  <!-- S1 ---------------------------------------------------------------- -->
  <Hero
    image={journey.heroImage}
    alt={journey.heroImageAlt}
    height="full"
    kenBurns={true}
    transitionName={`journey-image-${entry.id}`}
  >
    <p class="hero__tag">{journey.tripTypeTag}</p>
    <h1 class="hero__title" transition:name={`journey-title-${entry.id}`}>
      {journey.title}
    </h1>

    <p class="hero__badges">
      <span class="badge badge--duration">
        {journey.nights} Nights · {journey.days} Days
      </span>
      {journey.signatureFeature && (
        <span class="badge badge--signature">{journey.signatureFeature}</span>
      )}
    </p>

    <!-- Route strip: scrollable rather than wrapped, so a 7-city chain reads
         as one line on a phone instead of collapsing into a paragraph. -->
    <!-- data-allow-clip: the city chain scrolls sideways by design (S1). -->
    <div class="routestrip" role="group" aria-label="Route" data-allow-clip>
      <ol class="routestrip__list">
        {
          routeChips.map((chip) => (
            <li class="routestrip__city">
              {chip.link ? (
                <a class="routestrip__link" href={chip.link.href}>
                  {chip.name}
                </a>
              ) : (
                chip.name
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <p class="hero__actions">
      <Button href="#enquire" variant="primary" size="lg" data-analytics="journey_hero_cta">
        {primaryCta}
      </Button>
      <Button
        href={whatsappLink(settings, waContext)}
        variant="on-dark"
        size="lg"
        external={true}
        data-analytics="wa_click"
      >
        WhatsApp us
      </Button>
      {
        /* The PDF is GATED (PRD §8.1 — email + phone), so the hero button goes
           to the gate section rather than to the file. The file itself is
           released by the lead function in M6; the direct path is never
           printed in the hero. */
        journey.pdfFile && (
          <Button href="#download" variant="on-dark" size="lg" data-analytics="pdf_gate_open">
            Download the itinerary
          </Button>
        )
      }
    </p>
  </Hero>

  <!-- S2 ---------------------------------------------------------------- -->
  <QuickFactsBar
    nights={journey.nights}
    days={journey.days}
    startCity={journey.startCity}
    endCity={journey.endCity}
    pace={journey.pace}
    bestSeason={journey.bestSeason}
    idealFor={journey.idealFor}
  />

  <!-- S3 ----------------------------------------------------------------
       The expander is pure CSS via :has(), and it is gated behind
       @supports selector(:has(*)) so that a browser without :has() shows the
       whole intro instead of a clipped one that will not open. Content loss is
       never the fallback. -->
  <section class="band band-tight intro" id="introduction">
    <div class="container-content">
      <div class:list={['intro__body', 'prose-measure', { 'intro__body--clamped': introNeedsExpander }]}>
        <Content />
      </div>
      {
        introNeedsExpander && (
          <details class="intro__expander">
            <summary class="intro__summary tap-target">
              <span class="intro__summary-more">Read more</span>
              <span class="intro__summary-less">Show less</span>
            </summary>
          </details>
        )
      }
    </div>
  </section>

  <!-- S4 ---------------------------------------------------------------- -->
  <HighlightsGrid highlights={journey.highlights} />

  <!-- S9 (B only) — before the glance table, per §3: cabin choice is the
       first question a train traveller asks. -->
  {
    journey.variant === 'B' && (
      <CabinCards
        cabins={journey.cabinCategories}
        operatorDisclosure={journey.operatorDisclosure}
        bookingTermsUrl={journey.bookingTermsUrl}
      />
    )
  }

  <!-- S5 ---------------------------------------------------------------- -->
  <GlanceTable rows={journey.glanceRows} />

  <!-- S6 + S7 ----------------------------------------------------------- -->
  <DayAccordion days={itineraryDays} showProvisionalNotice={true} />

  {
    journey.mapGraphic && (
      <section class="band band-tight" aria-labelledby="route-map-heading">
        <div class="container-content">
          <h2 id="route-map-heading" class="map__heading">The route</h2>
          <Image
            src={journey.mapGraphic}
            alt={`Route map: ${journey.routeCities.join(' to ')}`}
            widths={[640, 960, 1280]}
            sizes="(min-width: 64rem) 60rem, 100vw"
            loading="lazy"
            class="map__image fade-up"
          />
        </div>
      </section>
    )
  }

  <!-- S8 — required and verbatim on B; optional on A until Open Question #13
       resolves, so A gets the standardised caveat when a list exists. -->
  {
    journey.variant === 'B' ? (
      <InclusionsBlock inclusions={journey.inclusions} exclusions={journey.exclusions} />
    ) : (
      journey.inclusions && (
        <InclusionsBlock
          inclusions={journey.inclusions}
          exclusions={journey.exclusions}
          standardisedCaveat={true}
        />
      )
    )
  }

  <!-- S10 (B only) — a plain editable string, because the season changes every
       year and this must never need a developer. -->
  {
    journey.variant === 'B' && (
      <section class="band band-tight departures" id="departures" aria-labelledby="departures-heading">
        <div class="container-content">
          <p class="eyebrow">{journey.departureSeasonLabel}</p>
          <h2 id="departures-heading">Departures</h2>
          <p class="departures__body prose-measure">{journey.departureInfo}</p>
        </div>
      </section>
    )
  }

  <!-- S11 (B only) — no Variant A stepper at launch (CLAUDE.md). -->
  {journey.variant === 'B' && <BookingStepper steps={journey.bookingSteps} />}

  <!-- S13 — required on both variants (see the header note). White on B
       because the booking stepper above it is already off-white. -->
  <PracticalNotesGrid notes={journey.practicalNotes} surface={isTrain ? 'white' : 'offwhite'} />

  <!-- PDF GATE (M5) — email + phone for the branded itinerary (PRD §8.1). The
       PDF is printed from THIS page by scripts/build-pdfs.mjs, so it cannot
       drift from what is above. The form is the shared EnquiryForm in its
       `pdf` layout; the release-on-submit lands with the lead function in M6,
       and until then the submit behaves like every other form shell. -->
  {
    journey.pdfFile && (
      <section class="band band-tight band-offwhite pdfgate" id="download" aria-labelledby="download-heading">
        <div class="container-content pdfgate__inner">
          <div>
            <p class="eyebrow">Take it with you</p>
            <h2 id="download-heading" class="pdfgate__heading">Download this itinerary</h2>
            <p class="pdfgate__detail prose-measure">
              The full day-by-day as a branded PDF — the same itinerary as this
              page, section for section. Leave a name, an email and a phone
              number and it is sent to you straight away.
            </p>
          </div>
          <div class="pdfgate__form">
            <EnquiryForm
              layout="pdf"
              leadType="pdf"
              journeySlug={entry.id}
              journeyTitle={journey.title}
            />
          </div>
        </div>
      </section>
    )
  }

  <!-- S14 — the single conversion moment. `#enquire` is what the hero CTA
       points at, so the primary action never leaves the page. -->
  <div id="enquire">
    <ConvertBand
      heading={convertHeading}
      body={convertBody}
      leadType="journey"
      journeySlug={entry.id}
      journeyTitle={journey.title}
      waContext={waContext}
    />
  </div>

  <!-- S12 (B only) — after the convert band, per §3. The disclosure sits in
       the section header, never buried (invariant #6). -->
  {
    journey.variant === 'B' && (
      <PoliciesAccordion
        policies={journey.policies}
        operatorDisclosure={journey.operatorDisclosure}
        operatorName={journey.operatorName}
        bookingTermsUrl={journey.bookingTermsUrl}
      />
    )
  }

  <!-- S15 ---------------------------------------------------------------- -->
  {
    relatedCards.length > 0 && (
      <RelatedJourneys
        journeys={relatedCards}
        viewAllHref={isTrain ? '/luxury-trains/' : '/journeys/'}
        viewAllLabel={isTrain ? 'All luxury trains' : 'All journeys'}
      />
    )
  }

  <Footer slot="footer" />

  <!-- S16 — one persistent-contact pattern sitewide: mobile bar, desktop
       floating WhatsApp (ruling b6). -->
  <StickyMobileBar slot="after-footer" waContext={waContext} enquireHref="#enquire" />
</Base>

<style>
  /* ---- S1 hero ------------------------------------------------------- */
  /* The trip-type label carries its own ground, like the badges below it and
     the route strip below those. It was the last element on the site still
     borrowing the hero gradient for legibility, and at 15px uppercase near the
     TOP of the tallest copy column on the site it was the one place the round
     3 gradient could not reach: 3.82:1 on the Golden Triangle hero at 390px.

     The alternative was to darken the journey hero's gradient by another 3rem
     to cover one small label — which is the opposite of the instruction this
     round ("the photo should read as a photo"). An opaque ground makes the
     contrast a property of the design rather than of whichever photograph an
     editor uploads, which is the argument already written twice on this page. */
  .hero__tag {
    display: inline-block;
    margin: 0;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-burgundy);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-yellow); /* legal: the pill's own burgundy ground */
  }

  .hero__title {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    color: var(--color-on-dark);
    max-width: 22ch;
    text-wrap: balance;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
  }

  /* Badges carry their own burgundy ground rather than relying on the scrim
     — that is what keeps yellow legal and AA-contrasted over any photograph. */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-burgundy);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .badge--duration {
    color: var(--color-yellow);
    font-family: var(--font-display);
    letter-spacing: 0.02em;
  }

  .badge--signature {
    color: var(--color-on-dark);
  }

  /* The strip carries its own plum ground rather than borrowing the hero
     scrim's. Two reasons, and the second is the real one:
       1. `overflow-x: auto` makes this its own scroll region, so a contrast
          checker resolves its background to the page white behind the hero and
          reports 1.08:1 — which it did.
       2. More importantly the checker is right in substance: the scrim is a
          sibling layer, so legibility of 12px uppercase text here would depend
          on whichever photograph an editor uploads. An opaque ground makes the
          contrast a property of the design instead of the content.
     It also matches the badge row directly above, and puts the yellow
     separators on plum, where yellow is legal (invariant #5). */
  .routestrip {
    margin-top: 1.1rem;
    /* Shrink to the city chain, not the container: this is a pill, and
       `.hero__content` is a plain block that would otherwise stretch it. */
    width: fit-content;
    max-width: 100%;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-burgundy);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .routestrip::-webkit-scrollbar {
    display: none;
  }

  .routestrip__list {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  .routestrip__city {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-dark);
  }

  /* Underlined rather than crimson: crimson is punctuation for the one action
     that matters in a viewport, and in this hero that is "Customise This
     Journey". A route chip is a way out of the page, not the way forward. */
  .routestrip__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    text-underline-offset: 0.2em;
  }

  .routestrip__link:hover {
    color: var(--color-white);
    text-decoration-color: currentColor;
  }

  .routestrip__city + .routestrip__city::before {
    content: '·';
    margin-right: 0.6rem;
    color: var(--color-yellow);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
  }

  /* ---- S3 intro ------------------------------------------------------- */
  .intro__body {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .intro__body :global(p + p) {
    margin-top: 1.1rem;
  }

  .intro__expander {
    margin-top: 0.5rem;
  }

  .intro__summary {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    color: var(--color-crimson);
    list-style: none;
  }

  .intro__summary::-webkit-details-marker {
    display: none;
  }

  .intro__summary:hover {
    color: var(--color-burgundy);
  }

  .intro__summary-less {
    display: none;
  }

  .intro__expander[open] .intro__summary-more {
    display: none;
  }

  .intro__expander[open] .intro__summary-less {
    display: inline;
  }

  /* The clamp only exists where :has() can undo it. Without :has() support the
     intro renders in full — a longer page is a far better failure than hidden
     copy behind a dead control. */
  @supports selector(:has(*)) {
    /* Small screens only. S3's "~120 words visible" exists to keep a phone
       from opening on a wall of prose; on desktop the same clamp cut a
       paragraph mid-sentence and left a dead half-band beneath it, which is
       worse than a slightly longer page. */
    @media (max-width: 63.999rem) {
      .intro__body--clamped {
        max-height: 13lh;
        overflow: clip;
        mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
      }

      .intro:has(.intro__expander[open]) .intro__body--clamped {
        max-height: none;
        mask-image: none;
      }
    }
  }

  @media (min-width: 64rem) {
    .intro__expander {
      display: none;
    }
  }

  /* ---- S7 route map --------------------------------------------------- */
  .map__heading {
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
  }

  .map__image {
    margin-top: 1.5rem;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-card-border);
  }

  /* ---- S10 departures ------------------------------------------------- */
  .departures h2 {
    margin: 0.4rem 0 0;
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
  }

  .departures__body {
    margin-top: 1rem;
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  /* ---- PDF gate (M5) ------------------------------------------------------ */
  .pdfgate__inner {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .pdfgate__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
      gap: 4rem;
      align-items: start;
    }
  }

  .pdfgate__heading {
    margin-top: 0.75rem;
    font-size: var(--text-h2);
  }

  .pdfgate__detail {
    margin-top: 1rem;
    color: var(--color-ink-muted);
  }

  /* ---- print-only brand header ------------------------------------------- */
  /* Hidden on screen HERE, not only via the global `.print-only` utility: a
     scoped selector carries an attribute token and outranks it, and the first
     build of this shipped the brand line visible under the nav. */
  .print-brand {
