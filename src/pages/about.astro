---
/**
 * About — PAGE_TEMPLATES T6.
 * ---------------------------------------------------------------------------
 * TWO SECTIONS OF THIS TEMPLATE DO NOT RENDER, and both absences are correct
 * rather than unfinished:
 *
 *   · the TIMELINE (T6 §3) is specified as "2006 → today". `foundingYear` is
 *     null and stays null until the client verifies it (PRD Open Question #2),
 *     and a timeline is nothing but dates — there is no honest way to draw one
 *     without the year. It renders when the year exists, and not before.
 *   · CERTIFICATIONS (T6 §5) wait on Open Question #4. No logos, no section.
 *
 * The portrait is the neutral grey 4:5 slot for the same reason it is on the
 * homepage: a stock photograph of a stranger presented as this consultancy's
 * founder would be a fabrication, not a placeholder.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CounterStat from '../components/CounterStat.astro';
import ConvertBand from '../components/ConvertBand.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import JsonLd from '../components/JsonLd.astro';
import Lotus from '../components/Lotus.astro';
import Button from '../components/Button.astro';

import { getSiteSettings, verifiedTrustStats } from '../lib/site-settings';
import { breadcrumbSchema } from '../lib/schema';
import { REGION_COUNT } from '../lib/destinations-strip';

import portraitPlaceholder from '../assets/placeholders/portrait.jpg';

const settings = await getSiteSettings();
const journeys = await getCollection('journeys', ({ data }) => !data.draft);
const stats = verifiedTrustStats(settings, {
  journeyCount: journeys.length,
  regionCount: REGION_COUNT,
});

const testimonial = (await getCollection('testimonials', ({ data }) => data.consentConfirmed))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))[0];

const PHILOSOPHY = [
  {
    title: 'Luxury where it changes the day',
    detail:
      'A heritage property you would have chosen yourself, a guide who knows the building rather than the script, a car that turns up. These are the things people remember.',
  },
  {
    title: 'Value where it does not',
    detail:
      'An internal flight is an internal flight. We do not add a business-class leg to make an itinerary look expensive, and we will tell you when an upgrade is not worth what it costs.',
  },
  {
    title: 'Nothing bought off a shelf',
    detail:
      'Every itinerary on this site was written for a particular set of travellers before it was written down. They are starting points, not packages.',
  },
];

const crumbs = breadcrumbSchema([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'About', url: new URL('/about/', Astro.site).href },
]);
---

<Base
  title={`About ${settings.siteName} — ${settings.yearsExperience} Years Planning India`}
  description="A travel consultancy of twenty years. Who plans your trip, how we work, and what affordable luxury means when somebody actually has to deliver it."
>
  <Fragment slot="head">
    <JsonLd schema={crumbs} />
  </Fragment>

  <Header slot="header" />

  <!-- 1 · Hero — portrait-led, not a stock handshake ---------------------- -->
  <section class="band band-tight intro">
    <div class="container-content intro__grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">About</span>
        </nav>
        <h1 class="intro__title">Every trip on this site was planned by a person</h1>
        <p class="intro__lede">
          {settings.yearsExperience} years of arranging private journeys across India
          and its neighbours — and in all that time, not one itinerary written by
          somebody who had not been there.
        </p>
      </div>

      <figure class="intro__figure">
        <Image
          src={settings.founder.portrait ?? portraitPlaceholder}
          alt={settings.founder.portrait ? settings.founder.portraitAlt : ''}
          widths={[320, 500, 720]}
          sizes="(min-width: 64rem) 22rem, 60vw"
          loading="eager"
          quality={60}
          class="intro__portrait"
        />
        {
          settings.founder.name && (
            <figcaption class="intro__caption">
              {settings.founder.name} · {settings.founder.role}
            </figcaption>
          )
        }
      </figure>
    </div>
  </section>

  <!-- 2 · The story -------------------------------------------------------- -->
  <section class="band band-tight" aria-labelledby="story-heading">
    <div class="container-content story">
      <h2 id="story-heading" class="story__label">The story</h2>
      <div class="story__body prose-measure">
        <p class="story__lead">{settings.founder.quote}</p>
        <p>
          India Visit began the way most good consultancies do — with more
          requests than could reasonably be turned down. What started as
          planning trips for friends of friends became a business built on the
          same principle it started with: that somebody who has walked the route
          should be the one writing it.
        </p>
        <p>
          Two decades on, the shape of the work has not changed much. We write
          the itinerary, we choose the properties and the guides, we book the
          trains, and then we stay reachable for the whole trip. The part that
          has changed is how many places we can do it in — nine regions now,
          three of them outside India.
        </p>
      </div>
    </div>
  </section>

  <!-- 3 · Timeline — renders only once the founding year is verified ------- -->
  {
    settings.foundingYear && (
      <section class="band band-tight band-offwhite" aria-labelledby="timeline-heading">
        <div class="container-content">
          <h2 id="timeline-heading">{settings.foundingYear} to today</h2>
          <p class="prose-measure">Milestones arrive with the verified founding year.</p>
        </div>
      </section>
    )
  }

  <!-- 4 · Philosophy -------------------------------------------------------- -->
  <section class="band band-tight band-offwhite" aria-labelledby="philosophy-heading">
    <div class="container-content">
      <p class="eyebrow">Affordable luxury, honestly</p>
      <h2 id="philosophy-heading">What that actually means</h2>
      <ul class="philosophy fade-up-stagger">
        {
          PHILOSOPHY.map((item) => (
            <li class="philosophy__item">
              <Lotus size={18} class="philosophy__mark" />
              <h3 class="philosophy__title">{item.title}</h3>
              <p class="philosophy__detail">{item.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6 · Trust numbers ----------------------------------------------------- -->
  <CounterStat stats={stats} surface="white" />

  <!-- 7 · Testimonial spotlight --------------------------------------------- -->
  {
    testimonial && (
      <section class="band band-tight" aria-labelledby="quote-heading">
        <div class="container-content">
          <h2 id="quote-heading" class="visually-hidden">What travellers say</h2>
          <figure class="quote fade-up">
            <Lotus size={22} class="quote__mark" />
            <blockquote class="quote__text">
              <p>{testimonial.data.quote}</p>
            </blockquote>
            <figcaption class="quote__by">
              {testimonial.data.name} · {testimonial.data.origin}
              <span class="quote__trip">{testimonial.data.tripLabel}</span>
            </figcaption>
          </figure>
          <p class="quote__more">
            <Button href="/reviews/" variant="ghost">Read more reviews</Button>
          </p>
        </div>
      </section>
    )
  }

  <!-- 8 · Convert ------------------------------------------------------------ -->
  <div id="enquire">
    <ConvertBand
      heading="Start a conversation"
      body="Not a booking form — a conversation. Tell us roughly what you have in mind and we will tell you honestly whether we are the right people for it."
      leadType="general"
      waContext="About"
    />
  </div>

  <Footer slot="footer" />
  <StickyMobileBar slot="after-footer" waContext="About" />
</Base>

<style>
  .intro {
    border-bottom: 1px solid var(--color-hairline);
  }

  .intro__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: 4rem;
    }
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .crumbs a {
    color: var(--color-ink-muted);
  }

  .crumbs a:hover {
    color: var(--color-crimson);
  }

  .intro__title {
    font-size: var(--text-h1);
    line-height: var(--leading-display);
  }

  .intro__lede {
    margin-top: 1.25rem;
    max-width: 46ch;
    font-size: var(--text-xl);
    color: var(--color-ink-muted);
  }

  .intro__figure {
    margin: 0;
  }

  .intro__portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .intro__caption {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* ---- story ------------------------------------------------------------- */
  .story {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .story {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .story__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-crimson);
  }

  .story__lead {
    font-size: var(--text-xl);
  }

  .story__body > p + p {
    margin-top: 1.1rem;
    color: var(--color-ink-muted);
  }

  /* ---- philosophy --------------------------------------------------------- */
  .philosophy {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: clamp(1.5rem, 0.5rem + 2vw, 2.5rem);
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .philosophy__mark {
    color: var(--color-crimson);
  }

  .philosophy__title {
    margin-top: 0.75rem;
    font-size: var(--text-2xl);
  }

  .philosophy__detail {
    margin-top: 0.6rem;
    color: var(--color-ink-muted);
  }

  /* ---- quote -------------------------------------------------------------- */
  .quote {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }

  .quote__mark {
    color: var(--color-crimson);
    margin-inline: auto;
  }

  .quote__text {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.4;
  }

  .quote__by {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .quote__trip {
    display: block;
    margin-top: 0.25rem;
    font-weight: 400;
    font-style: italic;
  }

  .quote__more {
    margin-top: 2rem;
    text-align: center;
  }
</style>
