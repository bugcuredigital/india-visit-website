---
/**
 * About — PAGE_TEMPLATES T6, rebuilt on 21 Nov 2026 from the client's own
 * About Us (docs/client/India_Visit_About_Us.docx).
 * ---------------------------------------------------------------------------
 * EVERY SENTENCE ON THIS PAGE IS HERS (COPY_REGISTER §T, APPROVED, client
 * source), edited only for house style: straight apostrophes, her bold belief
 * line set in the display face. Nothing is added that her text does not say.
 * The agency's inferred history, its "Affordable luxury, honestly" philosophy
 * and the absolute H1 claim it opened with are struck (COPY_REGISTER G1–G4).
 *
 * Her six sections, in her order, on T6's skeleton:
 *   1 Hero (T6 §1, portrait-led): her tagline, her first heading as the H1,
 *     her opening two paragraphs, her portrait with name and role.
 *   2 The story (T6 §2): "From the heart of India to the wider world".
 *   3 Timeline (T6 §3): renders now that `foundingYear` is verified. Two
 *     stops, not T6's 4–6, because her document dates only the founding;
 *     more arrive when she sends dated milestones (review sheet §14).
 *   · "Thoughtful planning, reliable support", "A life lived across India:
 *     meet Sheena Sewal" and "Who we work with" follow in her order.
 *   4 Philosophy (T6 §4): her "Our belief".
 *   5 Certifications (T6 §5) still wait on Open Question #4: no section.
 *   6–8 CounterStat, the testimonial spotlight (real reviews only) and the
 *     ConvertBand, unchanged.
 *
 * The brand name, the legal entity, the founding year and the founder's name
 * and role come from siteSettings, so they match every other page that shows
 * them (the homepage section, the policy pages' identity line, JSON-LD).
 */
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CounterStat from '../components/CounterStat.astro';
import ConvertBand from '../components/ConvertBand.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import JsonLd from '../components/JsonLd.astro';
import Lotus from '../components/Lotus.astro';
import Button from '../components/Button.astro';

import { getSiteSettings, verifiedTrustStats } from '../lib/site-settings';
import { breadcrumbSchema } from '../lib/schema';
import { REGION_COUNT } from '../lib/destinations-strip';

import portraitPlaceholder from '../assets/placeholders/portrait.jpg';

const settings = await getSiteSettings();
const journeys = await getCollection('journeys', ({ data }) => !data.draft);
const stats = verifiedTrustStats(settings, {
  journeyCount: journeys.length,
  regionCount: REGION_COUNT,
});

/* REAL reviews only for the spotlight. A placeholder slot is honest in a grid
   of cards, where it reads as one empty seat; blown up to display size as the
   single quotation on the About page it would read as the page having nothing
   to say. The section renders when there is something to put in it. */
const testimonial = (await getCollection('testimonials', ({ data }) => data.consentConfirmed))
  .filter((entry) => !entry.data.placeholder)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))[0];

const { siteName, legalEntity, foundingYear, founder } = settings;

/* "Thoughtful planning, reliable support": her list, verbatim. */
const CARE = [
  'Personalised itineraries and practical advice',
  'Airport meet-and-greet and arrival assistance',
  'Comfortable, well-maintained vehicles with experienced drivers',
  'Hotels selected with care',
  'Knowledgeable local guides',
  'Local experiences that bring places to life',
  'Responsive support throughout your journey',
];

const title = foundingYear
  ? `About ${siteName}: Curating Soulful Journeys Since ${foundingYear}`
  : `About ${siteName}: Curating Soulful Journeys`;
const description = [
  foundingYear ? `Founded in India in ${foundingYear}, ${siteName}` : siteName,
  `is the travel brand of ${legalEntity}.`,
  founder.name ? `Meet founder ${founder.name}, and see how every journey is planned.` : '',
].join(' ').trim();

const crumbs = breadcrumbSchema([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: 'About', url: new URL('/about/', Astro.site).href },
]);
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <JsonLd schema={crumbs} />
  </Fragment>

  <Header slot="header" />

  <!-- 1 · Hero — portrait-led, her opening -------------------------------- -->
  <section class="band band-tight intro">
    <div class="container-content intro__grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">About</span>
        </nav>
        <p class="eyebrow">Curating soulful journeys</p>
        <h1 class="intro__title">Travel that feels personal</h1>
        <p class="intro__lede">
          The best journeys are rarely remembered for the monuments alone. They
          are remembered for the people you met, the stories you were told, and
          the small details someone quietly took care of so you could simply
          enjoy it all.
        </p>
        <p class="intro__body">
          That is the idea behind {siteName}, the travel brand of {legalEntity}.
          {foundingYear ? `Founded in India in ${foundingYear}, we` : 'We'} have
          spent over two decades designing journeys for travellers from across
          India and around the world, bringing together local knowledge, trusted
          relationships and hands-on care to make travel rewarding, comfortable
          and seamless.
        </p>
      </div>

      <figure class="intro__figure">
        <Picture
          src={founder.portrait ?? portraitPlaceholder}
          alt={founder.portrait ? founder.portraitAlt : ''}
          widths={[320, 500, 720]}
          sizes="(min-width: 64rem) 22rem, 60vw"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          quality={60}
          class="intro__portrait"
        />
        {
          founder.name && (
            <figcaption class="intro__caption">
              {founder.name} · {founder.role}
            </figcaption>
          )
        }
      </figure>
    </div>
  </section>

  <!-- 2 · The story: from the heart of India ------------------------------ -->
  <section class="band band-tight" aria-labelledby="story-heading">
    <div class="container-content split">
      <h2 id="story-heading" class="split__heading">From the heart of India to the wider world</h2>
      <div class="split__body prose-measure">
        <p>
          India is where we are most at home, from its celebrated landmarks and
          historic cities to its quieter corners, varied landscapes and living
          traditions. We also plan journeys across Nepal, Bhutan and Sri Lanka,
          and to selected destinations across Asia and beyond.
        </p>
        <p>
          Whether it is your first visit or a return to go deeper, we begin by
          asking what matters to you: culture and heritage, food, wildlife,
          wellness, a family holiday, a celebration, or simply the freedom to
          travel at your own pace. Then we build the journey around you, never
          the other way round.
        </p>
      </div>
    </div>
  </section>

  <!-- 3 · Timeline — renders only once the founding year is verified ------- -->
  {
    foundingYear && (
      <section class="band band-tight band-offwhite" aria-labelledby="timeline-heading">
        <div class="container-content">
          <h2 id="timeline-heading">{foundingYear} to today</h2>
          <ol class="timeline">
            <li class="timeline__stop">
              <span class="timeline__when">{foundingYear}</span>
              <span class="timeline__what">
                Founded in India{founder.name ? ` by ${founder.name}` : ''}
              </span>
            </li>
            <li class="timeline__stop">
              <span class="timeline__when">Today</span>
              <span class="timeline__what">
                Over two decades designing journeys for travellers from across
                India and around the world
              </span>
            </li>
          </ol>
        </div>
      </section>
    )
  }

  <!-- Thoughtful planning, reliable support ---------------------------------- -->
  <section class="band band-tight" aria-labelledby="care-heading">
    <div class="container-content split">
      <h2 id="care-heading" class="split__heading">Thoughtful planning, reliable support</h2>
      <div class="split__body prose-measure">
        <p>
          Great travel is shaped as much by what happens behind the scenes as by
          what you experience along the way. Our on-ground network and carefully
          chosen partners take care of every important detail, including:
        </p>
        <ul class="care">
          {
            CARE.map((item) => (
              <li class="care__item">
                <Lotus size={16} tone="crimson" class="care__mark" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <p>
          Clear communication, dependable arrangements, and the reassurance that
          someone is always there when you need them. Well considered, never
          over-planned.
        </p>
      </div>
    </div>
  </section>

  <!-- A life lived across India: meet the founder -------------------------- -->
  <section class="band band-tight band-offwhite" aria-labelledby="founder-heading">
    <div class="container-content split">
      <h2 id="founder-heading" class="split__heading">
        A life lived across India{founder.name ? `: meet ${founder.name}` : ''}
      </h2>
      <div class="split__body prose-measure">
        <p>
          {siteName} is built on personal relationships. Founder and Managing
          Director {founder.name} remains closely involved in the business and in
          understanding what each client needs. Since founding the
          company{foundingYear ? ` in ${foundingYear}` : ''}, she has built a wide network of local contacts,
          long-standing friendships and first-hand destination knowledge across
          the country. Your journey is shaped by someone who knows the ground
          personally, not by a call centre.
        </p>
        <p>
          Army life is part of that story. Life in an Army family meant frequent
          moves, new communities, and making a home in different corners of the
          country. It gave Sheena a first-hand feel for India's diversity, its
          people and its regional cultures, and it taught her how to travel:
          adapting to new places, building relationships, and navigating the
          unfamiliar with curiosity, flexibility and an eye for the little
          details that make all the difference.
        </p>
        <p>
          That personal perspective, combined with years of professional
          experience, shapes how {siteName} plans every journey: with care,
          practical understanding and a genuine interest in the people and
          places that make travel meaningful.
        </p>
      </div>
    </div>
  </section>

  <!-- Who we work with -------------------------------------------------------- -->
  <section class="band band-tight" aria-labelledby="who-heading">
    <div class="container-content split">
      <h2 id="who-heading" class="split__heading">Who we work with</h2>
      <div class="split__body prose-measure">
        <p>
          We work with individual travellers, families, groups and corporate
          clients, as well as travel partners who need dependable destination
          support in India and the region. Whatever the journey, the care and
          attention to detail stay the same.
        </p>
      </div>
    </div>
  </section>

  <!-- 4 · Philosophy: her belief ---------------------------------------------- -->
  <section class="band band-offwhite" aria-labelledby="belief-heading">
    <div class="container-content belief">
      <Lotus size={22} tone="crimson" class="belief__mark" />
      <h2 id="belief-heading" class="belief__label">Our belief</h2>
      <p class="belief__line">Move slowly. Immerse yourself. Stay curious.</p>
      <p class="belief__body">
        Meet people, embrace the unexpected, and let each place reveal itself.
        We'll take care of the details.
      </p>
    </div>
  </section>

  <!-- 6 · Trust numbers ----------------------------------------------------- -->
  <CounterStat stats={stats} surface="white" />

  <!-- 7 · Testimonial spotlight --------------------------------------------- -->
  {
    testimonial && (
      <section class="band band-tight" aria-labelledby="quote-heading">
        <div class="container-content">
          <h2 id="quote-heading" class="visually-hidden">What travellers say</h2>
          <figure class="quote fade-up">
            <Lotus size={22} tone="crimson" class="quote__mark" />
            <blockquote class="quote__text">
              <p>{testimonial.data.quote}</p>
            </blockquote>
            <figcaption class="quote__by">
              {testimonial.data.name} · {testimonial.data.origin}
              <span class="quote__trip">{testimonial.data.tripLabel}</span>
            </figcaption>
          </figure>
          <p class="quote__more">
            <Button href="/reviews/" variant="ghost">Read more reviews</Button>
          </p>
        </div>
      </section>
    )
  }

  <!-- 8 · Convert ------------------------------------------------------------ -->
  <div id="enquire">
    <ConvertBand
      heading="Start a conversation"
      body="Not a booking form, a conversation. Tell us roughly what you have in mind and we will tell you honestly whether we are the right people for it."
      leadType="general"
      waContext="About"
    />
  </div>

  <Footer slot="footer" />
  <StickyMobileBar slot="after-footer" waContext="About" />
</Base>

<style>
  .intro {
    border-bottom: 1px solid var(--color-hairline);
  }

  .intro__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: 4rem;
    }
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .crumbs a {
    color: var(--color-ink-muted);
  }

  .crumbs a:hover {
    color: var(--color-crimson);
  }

  .intro__title {
    margin-top: 0.4rem;
    font-size: var(--text-h1);
    line-height: var(--leading-display);
  }

  .intro__lede {
    margin-top: 1.25rem;
    max-width: 46ch;
    font-size: var(--text-xl);
    color: var(--color-ink);
  }

  .intro__body {
    margin-top: 1rem;
    max-width: 60ch;
    color: var(--color-ink-muted);
  }

  .intro__figure {
    margin: 0;
  }

  .intro__portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .intro__caption {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* ---- heading over prose ---------------------------------------------------
     At every width. A heading column beside the prose put her longer headings
     ("A life lived across India: meet Sheena Sewal") on four lines at the H2
     size; stacked, they take one or two and keep the sitewide H2 scale. */
  .split {
    display: grid;
    gap: 1.25rem;
  }

  .split__heading {
    max-width: 28ch;
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    text-wrap: balance;
  }

  .split__body > * + * {
    margin-top: 1.1rem;
  }

  .split__body p {
    color: var(--color-ink-muted);
  }

  /* ---- timeline ------------------------------------------------------------ */
  .timeline {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .timeline__stop {
    padding-top: 1rem;
    border-top: 2px solid var(--color-burgundy);
  }

  .timeline__when {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-ink);
  }

  .timeline__what {
    display: block;
    margin-top: 0.4rem;
    max-width: 34ch;
    color: var(--color-ink-muted);
  }

  /* ---- planning list ------------------------------------------------------- */
  .care {
    display: grid;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .care__item {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    color: var(--color-ink);
  }

  .care__item :global(.care__mark) {
    flex: none;
    transform: translateY(0.15em);
  }

  /* ---- belief -------------------------------------------------------------- */
  .belief {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .belief :global(.belief__mark) {
    margin-inline: auto;
  }

  .belief__label {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .belief__line {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 700;
    line-height: var(--leading-heading);
    color: var(--color-ink);
    text-wrap: balance;
  }

  .belief__body {
    margin-top: 1rem;
    color: var(--color-ink-muted);
  }

  /* ---- quote -------------------------------------------------------------- */
  .quote {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }

  .quote__mark {
    margin-inline: auto;
  }

  .quote__text {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.4;
  }

  .quote__by {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .quote__trip {
    display: block;
    margin-top: 0.25rem;
    font-weight: 400;
    font-style: italic;
  }

  .quote__more {
    margin-top: 2rem;
    text-align: center;
  }
</style>
