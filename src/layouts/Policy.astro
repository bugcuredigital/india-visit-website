---
/**
 * Policy page shell — PAGE_TEMPLATES T12.
 * ---------------------------------------------------------------------------
 * One quiet template for all four legal pages: slim plum band, H1, prose with
 * anchored H2s, an updated date. NO conversion furniture and NO sticky bar —
 * T12 is explicit, and it is right: a page someone opens to check a
 * cancellation term should not be selling to them.
 *
 * The provisional notice is the important part of this file. The agency does
 * not write the client's legal copy: a privacy policy carries obligations
 * under India's DPDP Act and, for inbound travellers, the GDPR. What ships
 * here is the STRUCTURE each policy needs, with every section named, so the
 * client's lawyer is filling in a brief rather than starting from a blank
 * page — and so nobody can mistake agency drafting for legal advice.
 */
import Base from './Base.astro';
import BandWatermark from '../components/BandWatermark.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { breadcrumbSchema } from '../lib/schema';
import { getSiteSettings } from '../lib/site-settings';
import { PROVISIONAL_POLICY_PATHS } from '../lib/policies.mjs';

interface Props {
  title: string;
  heading: string;
  description: string;
  path: string;
  /** Defaults to whether `path` is in PROVISIONAL_POLICY_PATHS (src/lib/policies.mjs),
   *  the one launch-day switch. Pass it only to override that list. */
  provisional?: boolean;
  updated?: string;
  /** Adds the GSTIN to the identity line (round 5: /booking-terms/ only). */
  showGstin?: boolean;
}

const {
  title,
  heading,
  description,
  path,
  provisional = PROVISIONAL_POLICY_PATHS.includes(path),
  updated,
  showGstin = false,
} = Astro.props;
const settings = await getSiteSettings();

const crumbs = breadcrumbSchema([
  { name: 'Home', url: new URL('/', Astro.site).href },
  { name: heading, url: new URL(path, Astro.site).href },
]);
---

<Base title={title} description={description} noindex={provisional}>
  <Fragment slot="head">
    <JsonLd schema={crumbs} />
  </Fragment>

  <Header slot="header" />

  <section class="band band-tight band-burgundy band-watermarked on-dark">
    <BandWatermark side="right" size={260} />
    <div class="container-content">
      <Breadcrumb tone="dark" items={[{ label: 'Home', href: '/' }, { label: heading }]} />
      <h1>{heading}</h1>
      {/* Who stands behind the page: the client's own wording (About Us,
          21 Nov 2026), on all four policy pages, legal drafts included. */}
      <p class="identity">
        {settings.siteName} is the travel brand of {settings.legalEntity}.
        {showGstin && settings.gstNumber && <span class="identity__gst">GSTIN {settings.gstNumber}</span>}
      </p>
      {updated && <p class="updated">Last updated {updated}</p>}
    </div>
  </section>

  <section class="band band-tight">
    <div class="container-content">
      <div class="prose-measure">
        {
          provisional && (
            /*
              Also `noindex` while this is true — a placeholder legal page in a
              search index is worse than no page, because it is the version
              people quote back at you.
            */
            <p class="notice">
              <strong>This page is not final.</strong> The structure below is the
              agency's outline of what this policy must cover. The binding text is
              the client's to supply and their legal adviser's to approve; until
              then this page is excluded from search engines.
            </p>
          )
        }
        <div class="policy">
          <slot />
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .identity {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-on-dark-muted);
  }

  /* Its own line, so the number never breaks across two. */
  .identity__gst {
    display: block;
    margin-top: 0.25rem;
    letter-spacing: 0.02em;
  }

  .updated {
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--color-on-dark-muted);
  }

  .notice {
    margin-bottom: 2.5rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-burgundy);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background-color: var(--color-offwhite);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* Each heading opens a clearly separate block (round 6): a hairline above
     every section after the first, and a short rule over each heading, so a
     long legal page can be scanned by its sections. Burgundy, not the spec's
     crimson: fine rules are burgundy's job, and five crimson marks a screen
     would outshout the page's one action. */
  .policy :global(h2) {
    margin-top: 2.5rem;
    font-size: var(--text-2xl);
    scroll-margin-top: 6rem;
  }

  .policy :global(h2:not(:first-child)) {
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-hairline);
  }

  .policy :global(h2::before) {
    content: '';
    display: block;
    width: 1.75rem;
    height: 2px;
    margin-bottom: 0.9rem;
    border-radius: 2px;
    background-color: var(--color-burgundy);
  }

  .policy :global(h2:first-child) {
    margin-top: 0;
  }

  .policy :global(p),
  .policy :global(ul) {
    margin-top: 1rem;
    color: var(--color-ink-muted);
  }

  .policy :global(ul) {
    padding-left: 1.25rem;
  }

  .policy :global(li + li) {
    margin-top: 0.5rem;
  }

  .policy :global(li::marker) {
    color: var(--color-crimson);
  }

  .policy :global(a) {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .policy :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  .policy :global(table) {
    width: 100%;
    margin-top: 1.25rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .policy :global(th),
  .policy :global(td) {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-hairline);
    text-align: left;
  }

  .policy :global(th) {
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
