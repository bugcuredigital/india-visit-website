---
/**
 * S4 — Journey Highlights. Two-column grid, 5–8 items, each a bold verb-led
 * lead plus one line.
 *
 * THIS is where the brand mark earns its keep: the lotus glyph replaces the
 * client's ✦ character as the functional bullet. Never a generic checkmark,
 * never ✦ (invariant #5). The glyph inherits crimson here via currentColor.
 */
import Lotus from './Lotus.astro';

interface Props {
  highlights: Array<{ lead: string; text: string }>;
  heading?: string;
}

const { highlights, heading = 'Journey Highlights' } = Astro.props;
---

<section class="band">
  <div class="container-content">
    <h2 class="highlights__heading">{heading}</h2>
    <ul class="highlights fade-up-stagger">
      {highlights.map((item) => (
        <li class="highlights__item">
          <span class="highlights__glyph"><Lotus size={20} /></span>
          <p class="highlights__text">
            <strong class="highlights__lead">{item.lead}</strong>{' '}{item.text}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .highlights__heading {
    margin-bottom: 2.5rem;
  }

  .highlights {
    display: grid;
    gap: 1rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .highlights {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Each highlight is a soft off-white panel on the white band (round 6),
     the lotus in a small white badge at its head. */
  .highlights__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    background-color: var(--color-offwhite);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
  }

  .highlights__glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--color-white);
    border: 1px solid var(--color-card-border);
    color: var(--color-crimson);
    /* A flex item may shrink: beside a wrapping line the 20px lotus fell to
       5-12px at 390 (round 5, #29). The mark keeps its size. */
    flex: none;
  }

  /* A step up from the 16px body floor: the highlights are the section
     travellers actually scan, so they carry more weight than running copy.
     (Round 6's spec set it back to 16px; declined, this bump is a recorded
     ruling — tokens.css. The panel sets the line length now, so no cap.) */
  .highlights__text {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .highlights__lead {
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
