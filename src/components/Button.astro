---
/**
 * Button / CTA set.
 * ---------------------------------------------------------------------------
 * Crimson is punctuation (design direction): the solid crimson `primary` marks
 * the single most important action in a viewport. Everything else is
 * `secondary` (outline ink) or `ghost` (underlined ink text). If a screen has
 * two crimson buttons competing, one of them is wrong.
 *
 * On a dark band crimson lacks contrast, so the band's one action is
 * `on-dark-solid` (filled light, burgundy text) and the rest are `on-dark`
 * outlines (round 5, #15: the ConvertBand's three actions shared one outline
 * style, so it had no primary at all).
 *
 * Renders an <a> when given `href`, otherwise a <button> — so a CTA is always
 * the correct element for what it does.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'on-dark' | 'on-dark-solid';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  /** Full width on mobile, auto from 480px up — the common CTA pattern. */
  block?: boolean;
  external?: boolean;
  class?: string;
  'aria-label'?: string;
  /** Marks a link to the page you are on (the header pill on Plan My Trip). */
  'aria-current'?: 'page';
  id?: string;
  disabled?: boolean;
  'data-analytics'?: string;
  /** An onward arrow after the label, drawn (round 5, #28): the site had a
   *  typed →, an SVG and nothing, three ways. One glyph now, the same one
   *  the section pills carry. */
  arrow?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  block = false,
  external = false,
  class: className = '',
  disabled = false,
  arrow = false,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const tagProps = href
  ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : { type, disabled };
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  {...tagProps}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  {arrow && (
    <svg class="btn__arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false">
      <path d="M1 5h13M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {external && <span class="visually-hidden">(opens in a new tab)</span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* 44px minimum tap target (PRD §9.3) at every size. */
    min-height: 44px;
    padding-inline: var(--btn-pad-md);
    border: 1px solid transparent;
    border-radius: var(--btn-radius);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    background: none;
  }

  /* Disabled reads as "not yet", never as a faded CTA: no fill, a hairline
     edge and muted text that still clears AA, because the label is the
     explanation (the pre-launch forms, src/lib/forms.ts). Outranks every
     variant's rest colours on specificity. */
  .btn:disabled {
    cursor: not-allowed;
    background-color: transparent;
    border-color: var(--color-burgundy-hairline);
    color: var(--color-ink-muted);
  }

  .btn--on-dark:disabled,
  .btn--on-dark-solid:disabled {
    background-color: transparent;
    border-color: color-mix(in srgb, var(--color-on-dark) 35%, transparent);
    color: var(--color-on-dark-muted);
  }

  /* ---- Variants ------------------------------------------------------- */
  .btn--primary {
    background-color: var(--color-crimson);
    border-color: var(--color-crimson);
    color: var(--color-white);
  }

  .btn--primary:hover:not(:disabled) {
    background-color: var(--color-burgundy);
    border-color: var(--color-burgundy);
    color: var(--color-white);
  }

  .btn--secondary {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .btn--secondary:hover:not(:disabled) {
    background-color: var(--color-ink);
    color: var(--color-white);
  }

  /* Ink, underlined (round 5, #14): it was borderless crimson, so every
     secondary action on white ("Start a Conversation", the 404's two) was a
     second crimson call beside the primary. Ink is the design direction's
     secondary; the underline is what says "link" without a box. */
  .btn--ghost {
    padding-inline: 0.5rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.3em;
  }

  .btn--ghost:hover:not(:disabled) {
    color: var(--color-burgundy);
    text-decoration-color: currentColor;
  }

  /* A ghost on a dark ground (a hero's second action): on-dark text, since
     crimson text lacks contrast there, underlined so it still reads as a
     link without a box around it. */
  :global(.on-dark) .btn--ghost {
    color: var(--color-on-dark);
    text-decoration-color: currentColor;
  }

  :global(.on-dark) .btn--ghost:hover:not(:disabled) {
    color: var(--color-on-dark);
    text-decoration-thickness: 2px;
  }

  /* On a dark band: white outline, since crimson lacks contrast there. */
  .btn--on-dark {
    border-color: var(--color-on-dark);
    color: var(--color-on-dark);
  }

  .btn--on-dark:hover:not(:disabled) {
    background-color: var(--color-on-dark);
    color: var(--color-burgundy);
  }

  /* The one action on a dark band: the outline's hover state, at rest. Its
     own hover goes to white, with the lift every button has. */
  .btn--on-dark-solid {
    background-color: var(--color-on-dark);
    border-color: var(--color-on-dark);
    color: var(--color-burgundy);
  }

  .btn--on-dark-solid:hover:not(:disabled) {
    background-color: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-burgundy);
  }

  .btn__arrow {
    flex: none;
    width: 16px;
    height: 10px;
  }

  /* ---- Sizes ---------------------------------------------------------- */
  .btn--sm {
    min-height: 44px;
    padding-inline: var(--btn-pad-sm);
    font-size: var(--text-sm);
  }

  .btn--lg {
    /* Down one step from 52px/2rem/19px. Still comfortably above the 44px
       tap-target floor. */
    min-height: 48px;
    padding-inline: var(--btn-pad-lg);
    font-size: var(--text-lg);
  }

  .btn--block {
    width: 100%;
  }

  @media (min-width: 30rem) {
    .btn--block {
      width: auto;
    }
  }

  /* Hover lift 2px, 200ms, transform only (PRD §9.4). */
  @media (prefers-reduced-motion: no-preference) {
    .btn {
      transition:
        background-color var(--duration-fast) var(--ease-brand),
        border-color var(--duration-fast) var(--ease-brand),
        color var(--duration-fast) var(--ease-brand),
        transform var(--duration-fast) var(--ease-brand),
        box-shadow var(--duration-fast) var(--ease-brand);
    }

    .btn:hover:not(:disabled) {
      transform: translate3d(0, -2px, 0);
    }

    .btn--primary:hover:not(:disabled),
    .btn--on-dark-solid:hover:not(:disabled) {
      box-shadow: var(--shadow-lift-hover);
    }

    /* The arrow leans toward where it goes, as on the section pills. */
    .btn__arrow {
      transition: transform var(--duration-fast) var(--ease-brand);
    }

    .btn:hover:not(:disabled) .btn__arrow {
      transform: translate3d(3px, 0, 0);
    }

    /* Pressed: the lift gives way to a 1px press (round 6). After the hover
       rule on purpose, at the same specificity, so it wins while held. */
    .btn:active:not(:disabled) {
      transform: translate3d(0, 1px, 0);
    }
  }
</style>
