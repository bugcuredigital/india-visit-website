---
/**
 * S15 — Related journeys. Three cards, editorially assigned, and the place the
 * custom-journey → luxury-train upsell path lives (Template Spec S15).
 * Renders nothing at all when no siblings are assigned, rather than an empty
 * heading — relevant while the catalogue is still being seeded.
 */
import JourneyCard from './JourneyCard.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Optional quiet outline link on the heading's baseline. */
  viewAllHref?: string;
  viewAllLabel?: string;
  journeys: Array<{
    slug: string;
    title: string;
    image: ImageMetadata;
    imageAlt: string;
    nights: number;
    days: number;
    routeCities: string[];
    variant: 'A' | 'B';
    signatureFeature?: string;
  }>;
  heading?: string;
}

const {
  journeys,
  heading = 'Trips like this',
  viewAllHref,
  viewAllLabel = 'View all journeys',
} = Astro.props;
---

{journeys.length > 0 && (
  <section class="band band-offwhite">
    <div class="container-content">
      <div class="related__head">
        <h2 class="related__heading">{heading}</h2>
        {viewAllHref && (
          <a class="related__all tap-target" href={viewAllHref}>
            {viewAllLabel}
            <svg viewBox="0 0 16 10" aria-hidden="true" focusable="false">
              <path d="M1 5h13M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
      </div>
      <div class="related fade-up-stagger">
        {journeys.map((journey) => <JourneyCard {...journey} />)}
      </div>
    </div>
  </section>
)}

<style>
  /* Section header: heading left, quiet outline link right on the same
     baseline. Wraps to its own line before it ever squeezes the heading. */
  .related__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 2rem;
  }

  .related__heading {
    margin: 0;
  }

  .related__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    color: var(--color-crimson);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .related__all svg {
    width: 16px;
    height: 10px;
    flex: none;
  }

  .related__all:hover {
    color: var(--color-burgundy);
    border-color: var(--color-burgundy);
  }

  .related {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 40rem) {
    .related {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .related {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
