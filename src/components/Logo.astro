---
/**
 * Logo — TEMP-ASSET (grep: TEMP-ASSET)
 * ---------------------------------------------------------------------------
 * THIS IS NOT THE APPROVED LOGO. It is a temporary typographic stand-in.
 *
 * Why: the supplied docs/brand/india_visit_logo.svg contains no vector
 * artwork. It is a single 5910x4128 PNG embedded twice (once as the image,
 * once as a luminance mask) inside an SVG wrapper; its only <path> is a
 * full-canvas clip rectangle. So there is no background NODE to remove
 * structurally, and colour-keying the raster is forbidden — it would delete
 * the white wordmark along with the black background (CLAUDE.md invariant #5).
 * EXECUTION_RUNBOOK M1 step 6 pre-authorises this fallback so M1 is not
 * blocked while real vector artwork is sourced.
 *
 * Replace by: dropping logo-white.svg into docs/brand/processed/ + src/assets/,
 * then swapping the markup below for an <img>/inline SVG. The usage rule still
 * applies — the white wordmark never sits directly on off-white or white, so
 * the plum/crimson badge container stays.
 *
 * The lotus glyph is ALSO unavailable as vector and is required sitewide as
 * the highlight-bullet mark (invariant #5) — that lands as an M3 blocker.
 */
interface Props {
  /** `badge` is the light-background lockup (the default header case). */
  variant?: 'badge' | 'on-dark';
  class?: string;
}

const { variant = 'badge', class: className = '' } = Astro.props;
---

<a
  href="/"
  class:list={['logo', `logo--${variant}`, className]}
  data-temp-asset="logo"
  aria-label="India Visit — home"
>
  <span class="logo__badge">
    <span class="logo__india">INDIA</span>
    <span class="logo__visit">visit</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    /* 44px tap target (PRD §9.3) */
    min-height: 44px;
  }

  /* The badge container is not decoration — it is the usage rule. The
     wordmark is white, so it must never sit directly on off-white/white. */
  .logo__badge {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.05em;
    padding: 0.5rem 1.1rem 0.55rem;
    background-image: linear-gradient(
      110deg,
      var(--color-crimson) 0%,
      var(--color-burgundy) 55%,
      var(--color-plum) 100%
    );
    border-radius: var(--radius-md);
    line-height: 1;
  }

  .logo__india {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    color: var(--color-white);
  }

  .logo__visit {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.125rem;
    letter-spacing: 0.06em;
    color: var(--color-white);
  }

  /* On plum/burgundy the badge would disappear into the band, so the
     lockup sits bare — which is what the real white artwork will do too. */
  .logo--on-dark .logo__badge {
    background-image: none;
    padding-inline: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo__badge {
      transition: transform var(--duration-fast) var(--ease-brand);
    }

    .logo:hover .logo__badge {
      transform: translate3d(0, -2px, 0);
    }
  }
</style>
