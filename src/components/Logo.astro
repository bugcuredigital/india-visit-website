---
/**
 * Logo — the approved India Visit badge.
 * ---------------------------------------------------------------------------
 * RASTER BY OWNER-APPROVED EXCEPTION. The delivered brand file contains no
 * vector artwork (see CLAUDE.md brand section and
 * docs/brand/processed/PROVENANCE.md), so the badge is a PNG extracted from it
 * by silhouette mask. Regenerate with `npm run brand:logo`.
 *
 * The badge carries its own crimson->plum ground, so unlike a bare white
 * wordmark it may sit directly on off-white. Swapping to true SVG artwork
 * later is a drop-in: replace src/assets/brand/logo-badge.png with the SVG and
 * change the <Picture> below to an inline <svg> or <img>.
 */
import { Picture } from 'astro:assets';
import logoBadge from '../assets/brand/logo-badge.png';

interface Props {
  /** Rendered height in px. Badge aspect is 1.695:1. */
  height?: number;
  /** Home page suppresses the link — you are already there. */
  isHome?: boolean;
  /** `on-dark` is for plum/burgundy bands; the badge itself is unchanged. */
  variant?: 'default' | 'on-dark';
  class?: string;
}

const { height = 48, isHome = false, variant = 'default', class: className = '' } = Astro.props;
const width = Math.round(height * 1.695);

const Tag = isHome ? 'span' : 'a';
const linkProps = isHome ? {} : { href: '/', 'aria-label': 'India Visit — home' };
---

<Tag {...linkProps} class:list={['logo', `logo--${variant}`, className]}>
  <Picture
    src={logoBadge}
    formats={['webp']}
    fallbackFormat="png"
    densities={[1, 2]}
    width={width}
    height={height}
    alt={isHome ? 'India Visit' : ''}
    loading="eager"
    decoding="sync"
  />
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    /* 44px minimum tap target (PRD §9.3) even when the badge is shorter. */
    min-height: 44px;
    text-decoration: none;
  }

  .logo :global(img) {
    display: block;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    a.logo :global(img) {
      transition: transform var(--duration-fast) var(--ease-brand);
    }

    a.logo:hover :global(img) {
      transform: translate3d(0, -2px, 0);
    }
  }
</style>
