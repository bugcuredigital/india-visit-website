---
/**
 * FAQ accordion — the SEO workhorse section.
 * ---------------------------------------------------------------------------
 * Used by city pages (T15 §h), destination pages (T2 §7) and articles (T9),
 * which is why it takes a plain array and nothing page-specific.
 *
 * Native <details>/<summary>, for the same reasons DayAccordion uses it:
 * keyboard operation, Esc, and find-in-page for free, and — the one that
 * matters for a section whose whole job is search — the answers are in the
 * HTML whether or not a panel is open. A JavaScript accordion that reveals
 * text on click is an accordion that ships its answers to nobody.
 *
 * The first question opens by default: an accordion where everything is shut
 * looks like an empty section, and the first answer is the one that proves
 * there is something worth opening.
 *
 * No height animation. Animating a <details> panel means animating height,
 * which the motion spec forbids outright (PRD §9.4).
 *
 * The default slot renders under the list, inside the same section: a page's
 * last word on the subject (the trains landing's operator note) sits there
 * rather than in a section of its own, with a full band of space above and
 * below one line (round 5, #75).
 */
interface Props {
  faq: Array<{ question: string; answer: string }>;
  heading?: string;
  id?: string;
  surface?: 'white' | 'offwhite';
}

const { faq, heading = 'Common questions', id, surface = 'white' } = Astro.props;
const headingId = `${id ?? 'faq'}-heading`;
---

<section
  class:list={['band', surface === 'offwhite' && 'band-offwhite']}
  id={id}
  aria-labelledby={headingId}
>
  <div class="container-content faq__layout">
    <div class="faq__head">
      <h2 id={headingId}>{heading}</h2>
    </div>

    <ul class="faq">
      {faq.map((item, index) => (
        <li class="faq__item">
          <details class="faq__panel" open={index === 0}>
            <summary class="faq__summary">
              <span class="faq__question">{item.question}</span>
              <svg class="faq__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                <path
                  d="M1 1.5 6 6.5l5-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <p class="faq__answer">{item.answer}</p>
          </details>
        </li>
      ))}
    </ul>
    {Astro.slots.has('default') && (
      <div class="faq__after">
        <slot />
      </div>
    )}
  </div>
</section>

<style>
  /* An answer column capped at 68ch sits in a 1280px container, so on a wide
     screen the section was two-fifths type and three-fifths nothing. Putting
     the heading in its own column turns that dead space into structure — the
     grid discipline the reference sites get their composure from — while the
     measure stays exactly where legibility wants it. */
  .faq__layout {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .faq__layout {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  /* The panels keep their round-6 width; the answer text inside them is
     what holds to the reading measure. */
  .faq {
    max-width: 46rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Under the list, in the answer column. */
  .faq__after {
    max-width: 46rem;
  }

  @media (min-width: 64rem) {
    .faq__after {
      grid-column: 2;
    }
  }

  /* Each question is its own panel since round 6, rather than a row between
     two rules. The open one firms its edge; no shadow (a hover state, and an
     open answer is not hovering). */
  .faq__item + .faq__item {
    margin-top: 0.75rem;
  }

  .faq__panel {
    padding-inline: 1.5rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
  }

  .faq__panel[open] {
    border-color: var(--color-burgundy-hairline);
  }

  .faq__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    /* 44px+ target across the full row. */
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__question {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-heading);
    overflow-wrap: break-word;
    color: var(--color-ink);
  }

  .faq__summary:hover .faq__question {
    color: var(--color-burgundy);
  }

  /* The same round control as the day-by-day (DayAccordion). */
  .faq__chevron {
    box-sizing: content-box;
    flex: none;
    width: 12px;
    height: 8px;
    padding: 11px 9px;
    border: 1px solid var(--color-burgundy-hairline);
    border-radius: 50%;
    color: var(--color-burgundy);
  }

  .faq__panel[open] .faq__chevron {
    border-color: var(--color-burgundy);
  }

  @media (hover: hover) {
    .faq__summary:hover .faq__chevron {
      background-color: var(--color-burgundy);
      border-color: var(--color-burgundy);
      color: var(--color-white);
    }
  }

  @media (max-width: 39.999rem) {
    .faq__chevron {
      padding: 9px 7px;
    }
  }

  .faq__answer {
    max-width: var(--container-prose);
    padding-bottom: 1.6rem;
    color: var(--color-ink-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__chevron {
      transition:
        transform var(--duration-base) var(--ease-brand),
        background-color var(--duration-fast) var(--ease-brand),
        border-color var(--duration-fast) var(--ease-brand),
        color var(--duration-fast) var(--ease-brand);
    }

    .faq__question {
      transition: color var(--duration-fast) var(--ease-brand);
    }

    .faq__panel[open] .faq__chevron {
      transform: rotate(180deg);
    }
  }
</style>
