---
/**
 * Hero — full-bleed photograph, plum gradient ONLY at the text zone.
 * ---------------------------------------------------------------------------
 * LCP PROTECTION (invariant #3) is the whole point of this component:
 *   · the image is `fetchpriority="high"`, eager, and NOT lazy
 *   · it is NEVER entrance-animated — it paints at full opacity immediately
 *   · Ken Burns applies to a separate wrapper and is opt-in, so the pixels are
 *     never hidden behind an animation that has yet to run
 *   · the gradient is a CSS overlay, so it costs no extra request
 *
 * If you find yourself adding opacity or a transform to the <img>, stop.
 */
import { Picture } from 'astro:assets';
import { HERO_WIDTHS, HERO_SIZES, HERO_FORMATS } from '../lib/hero-image';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** `full` for the homepage (85svh), `short` for destinations (55svh),
   *  `compact` for index/tool pages that are not a story. */
  height?: 'full' | 'short' | 'compact';
  /** Slow scale on the image. Exempt from the 200–600ms rule (PRD §9.4). */
  kenBurns?: boolean;
  /** Widest rendered width; heroes are full-bleed so this is large. */
  widths?: number[];
  /** View-transition name. Pair with the matching JourneyCard image so the
   *  card morphs into this hero on navigation (M4). Omit and nothing morphs. */
  transitionName?: string;
}

const {
  image,
  alt,
  height = 'full',
  kenBurns = false,
  widths = HERO_WIDTHS,
  transitionName,
} = Astro.props;
---

<section class:list={['hero', `hero--${height}`]}>
  <!-- data-allow-clip: Ken Burns scales the image past the hero on purpose. -->
  <div data-allow-clip class:list={['hero__media', { 'hero__media--kenburns': kenBurns }]}>
    <!-- AVIF first, WebP fallback (invariant #3). The head preload targets the
         AVIF set, so a browser that supports it has the file in flight before
         the parser reaches this element. -->
    <Picture
      src={image}
      alt={alt}
      widths={widths}
      sizes={HERO_SIZES}
      formats={[...HERO_FORMATS]}
      fallbackFormat="webp"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      class="hero__img"
      pictureAttributes={{ class: 'hero__picture' }}
      transition:name={transitionName}
    />
  </div>

  <!-- Gradient sits only where the text is, so the photograph stays a
       photograph everywhere else (design direction). -->
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container-content hero__content">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    /* minmax(0, 1fr), NOT the implicit `auto` track. An auto track takes its
       automatic minimum from the item's min-content, so one `white-space:
       nowrap` descendant (the itinerary route strip) grew the track to 775px
       inside a 390px hero. `overflow: clip` below then hid the damage instead
       of reporting it, and a document-scrollWidth check cannot see it — the
       headline and both CTAs were simply cut off on a phone. */
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    isolation: isolate;
    overflow: clip;
    background-color: var(--color-plum);
  }

  .hero--full {
    min-height: 85svh;
  }

  .hero--short {
    min-height: 55svh;
  }

  .hero--compact {
    min-height: 34svh;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* <Picture> wraps the img, so the wrapper has to carry the fill too. */
  .hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: -1;
    /* Only the lower text zone is tinted — roughly the bottom 62%. */
    height: 62%;
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-plum) 92%, transparent) 0%,
      color-mix(in srgb, var(--color-plum) 62%, transparent) 42%,
      transparent 100%
    );
  }

  .hero__content {
    /* Belt and braces on the same blowout: a grid item's default min-width is
       auto, which is min-content. */
    min-width: 0;
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    color: var(--color-white);
  }

  /* Ken Burns runs on the WRAPPER, never on the LCP image's visibility.
     8s+ and subtle, per PRD §9.4. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__media--kenburns {
      animation: hero-kenburns var(--duration-kenburns) var(--ease-brand) both;
    }
  }

  @keyframes hero-kenburns {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }
</style>
