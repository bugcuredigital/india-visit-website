---
/**
 * Section-entrance observer — the sitewide default for motion.
 * ---------------------------------------------------------------------------
 * PRD §9.4 as amended: CSS + IntersectionObserver handles ALL section
 * entrances, homepage included. GSAP is reserved for 1–2 homepage set pieces
 * and lazy-loads below the fold, because the library alone (~35–38KB gzipped)
 * would consume nearly the whole 40KB animation budget.
 *
 * Included once by Base.astro. Adds `is-visible` to `.fade-up` /
 * `.fade-up-stagger` elements as they enter, then stops observing them —
 * entrance animations never replay on scroll.
 *
 * Runs on first paint AND on every `astro:page-load`, because View Transitions
 * swap the document without a fresh script execution. Each element is stamped
 * once, so the double call on initial load with the ClientRouter present does
 * not build a second observer over the same nodes.
 *
 * The whole thing is inside a reduced-motion guard: when motion is unwelcome
 * the CSS never hides the elements in the first place, so doing nothing here
 * is the correct behaviour rather than a degraded one.
 */
---

<script is:inline>
  (() => {
    if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
    if (!('IntersectionObserver' in window)) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );

    const observe = () => {
      document.querySelectorAll('.fade-up, .fade-up-stagger').forEach((el) => {
        if (el.dataset.revealed) return;
        el.dataset.revealed = '1';
        io.observe(el);
      });
    };

    observe();
    document.addEventListener('astro:page-load', observe);
  })();
</script>
