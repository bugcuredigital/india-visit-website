---
/**
 * Per-day transfer chip. Per-DAY, never per-trip: the Western & Southern
 * India itinerary mixes flights and overnight trains mid-journey, so the
 * template has to express that at day level (Template Spec S6).
 *
 * The icon is decorative; the text carries the meaning, so screen readers get
 * "Flight — Delhi to Udaipur" rather than an unlabelled glyph.
 */
import Icon from './Icon.astro';
import type { PhosphorIconName } from '../lib/phosphor-icons';

interface Props {
  mode: 'flight' | 'overnight-train' | 'train' | 'drive' | 'boat' | 'walk';
  detail: string;
}

const { mode, detail } = Astro.props;

const MODE_LABEL: Record<Props['mode'], string> = {
  flight: 'Flight',
  'overnight-train': 'Overnight train',
  train: 'Train',
  drive: 'Drive',
  boat: 'Boat',
  walk: 'On foot',
};

/** Words a detail may already open with ("Drive — 274 km", "Fly — Delhi to
 *  Udaipur"). Such a detail labels itself: its own word becomes the label
 *  and the rest the detail, so the chip never reads "Drive — Drive — 274 km"
 *  (the bug found on sixteen journeys). Matched per mode, so "Delhi to Agra —
 *  3 hours" still gets its label. The separator is the middle dot the design
 *  uses for every other label pair ("5 Nights · 6 Days"), not an em dash:
 *  the copy rule is at most one em dash per screen (client ruling 2026-11-12),
 *  and a chip on every travel day would spend it on its own. */
const SELF_LABEL: Record<Props['mode'], string[]> = {
  flight: ['Flight', 'Fly'],
  'overnight-train': ['Overnight train', 'Train'],
  train: ['Train', 'Day train', 'Rail'],
  drive: ['Drive', 'Road'],
  boat: ['Boat', 'Cruise', 'Ferry'],
  walk: ['On foot', 'Walk', 'Hike', 'Trek'],
};
// The separator is optional: "Drive 172 km" and "Fly to Paro" name their
// own mode too, and without one they rendered "Drive · Drive 172 km" (round
// 5, #30). `npm run check:transport-labels` fails the build on any survivor.
const own = SELF_LABEL[mode]
  .map((word) => new RegExp(`^(${word})(?:\\s*[—:·]\\s+|\\s+)`, 'i').exec(detail))
  .find(Boolean);
const label = own ? own[1] : MODE_LABEL[mode];
const rest = own ? detail.slice(own[0].length) : detail;

/** Phosphor glyphs, regular weight (design round 6: these were hand-drawn
 *  on their own 16px grid; they now come from the one authorised icon set,
 *  scripts/brand/fetch-phosphor-icons.mjs). */
const MODE_ICON: Record<Props['mode'], PhosphorIconName> = {
  flight: 'airplane-tilt',
  'overnight-train': 'train',
  train: 'train',
  drive: 'car-profile',
  boat: 'boat',
  walk: 'footprints',
};
---

<span class="chip">
  <span class="chip__icon"><Icon name={MODE_ICON[mode]} size={15} /></span>
  <span class="chip__text">{label} · {rest}</span>
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.32rem 0.8rem 0.32rem 0.65rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink-muted);
    /* Wraps. It was `nowrap`, and one long train label ("Thanjavur to
       Chettinad by day; overnight to Kochi") pushed a phone page 100px
       sideways — caught by check:responsive. An editor will write labels
       like that; the chip has to survive them. */
    max-width: 100%;
    line-height: 1.3;
  }

  .chip__icon {
    display: inline-flex;
    flex: none;
    color: var(--color-crimson);
  }
</style>
