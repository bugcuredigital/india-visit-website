---
/**
 * Per-day transfer chip. Per-DAY, never per-trip: the Western & Southern
 * India itinerary mixes flights and overnight trains mid-journey, so the
 * template has to express that at day level (Template Spec S6).
 *
 * The icon is decorative; the text carries the meaning, so screen readers get
 * "Flight — Delhi to Udaipur" rather than an unlabelled glyph.
 */
interface Props {
  mode: 'flight' | 'overnight-train' | 'train' | 'drive' | 'boat' | 'walk';
  detail: string;
}

const { mode, detail } = Astro.props;

const MODE_LABEL: Record<Props['mode'], string> = {
  flight: 'Flight',
  'overnight-train': 'Overnight train',
  train: 'Train',
  drive: 'Drive',
  boat: 'Boat',
  walk: 'On foot',
};

/** Simple stroked glyphs — no icon-font dependency for six shapes. */
const MODE_PATH: Record<Props['mode'], string> = {
  flight: 'M2 9.5 14 6l-1.5 4.5L14 15 2 11.5Z',
  'overnight-train': 'M4 3h8v7H4Zm0 7 1.5 3h5L12 10M6 5.5h4',
  train: 'M4 3h8v7H4Zm0 7 1.5 3h5L12 10M6 5.5h4',
  drive: 'M2.5 10h11l-1-3.5h-9ZM4 10v2m8-2v2',
  boat: 'M2.5 9.5h11L12 13H4Zm5.5 0V4l4 2',
  walk: 'M8 3.5v3l2.5 2M8 6.5 5.5 9v4m5-2.5V14',
};
---

<span class="chip">
  <svg class="chip__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d={MODE_PATH[mode]} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="chip__text">{MODE_LABEL[mode]} — {detail}</span>
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  .chip__icon {
    width: 14px;
    height: 14px;
    color: var(--color-crimson);
  }
</style>
