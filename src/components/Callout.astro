---
/**
 * Article callout block. Off-white fill with a crimson edge — an accent, not a
 * flood (colour ruling). Used inside ArticleBody for practical asides.
 */
import Lotus from './Lotus.astro';

interface Props {
  title?: string;
  tone?: 'note' | 'important';
}

const { title, tone = 'note' } = Astro.props;
---

<aside class:list={['callout', `callout--${tone}`]}>
  {title && (
    <p class="callout__title">
      <Lotus size={16} />
      <span>{title}</span>
    </p>
  )}
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    margin-block: 2rem;
    padding: 1.35rem 1.5rem;
    background-color: var(--color-offwhite);
    border-left: 3px solid var(--color-crimson);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--text-base);
  }

  /* `important` uses burgundy rather than a louder red — restraint is the
     point, and burgundy is the fine-rule colour (round 3 rebalance). */
  .callout--important {
    border-left-color: var(--color-burgundy);
  }

  .callout__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }

  .callout__title :global(.lotus) {
    color: var(--color-crimson);
  }

  .callout__body :global(> * + *) {
    margin-top: 0.75rem;
  }
</style>
