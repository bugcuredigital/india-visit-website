---
/**
 * Testimonials — swipe/arrow only. AUTO-ADVANCE IS OFF, deliberately:
 * PRD §9.4 forbids autoplay carousels, and PAGE_TEMPLATES T1 §8 says so
 * explicitly. A luxury page does not move on its own.
 *
 * Implemented as a scroll-snap track, so swipe works natively on touch and the
 * arrows just nudge the scroll position. That keeps it keyboard-reachable
 * (the track is focusable and arrow keys scroll it) with almost no JS.
 *
 * Only consented testimonials exist to render — the schema refuses entries
 * whose `consentConfirmed` is not true, so filtering here would be redundant.
 */
import Lotus from './Lotus.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  testimonials: Array<{
    name: string;
    origin: string;
    tripLabel: string;
    quote: string;
    photo?: ImageMetadata;
  }>;
  heading?: string;
}

const { testimonials, heading = 'What travellers say' } = Astro.props;
---

{testimonials.length > 0 && (
  <section class="band">
    <div class="container-content">
      <div class="quotes__head">
        <h2>{heading}</h2>
        {testimonials.length > 1 && (
          <div class="quotes__nav">
            <button type="button" class="quotes__arrow tap-target" data-quote-prev aria-label="Previous testimonial">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="quotes__arrow tap-target" data-quote-next aria-label="Next testimonial">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        )}
      </div>

      <!-- The scroll region and the list are SEPARATE elements on purpose.
           Putting role="group" on the <ul> itself overrides its implicit list
           role, which orphans every <li> in the accessibility tree (axe flags
           it, and screen readers stop announcing item counts). The focusable
           wrapper takes the role; the list stays a list. -->
      <div
        data-allow-clip
        class="quotes__viewport"
        data-quote-track
        tabindex="0"
        role="group"
        aria-label="Traveller testimonials, use arrow keys to scroll"
      >
      <ul class="quotes">
        {testimonials.map((item) => (
          <li class="quote">
            <span class="quote__glyph"><Lotus size={22} /></span>
            <blockquote class="quote__body">
              <p>{item.quote}</p>
            </blockquote>
            <footer class="quote__meta">
              {item.photo && (
                <Image src={item.photo} alt="" width={44} height={44} loading="lazy" class="quote__photo" />
              )}
              <div>
                <p class="quote__name">{item.name}</p>
                <p class="quote__origin">{item.origin} · {item.tripLabel}</p>
              </div>
            </footer>
          </li>
        ))}
      </ul>
      </div>
    </div>
  </section>
)}

<script is:inline>
  (() => {
    document.querySelectorAll('[data-quote-track]').forEach((track) => {
      const scope = track.closest('section');
      if (!scope) return;
      const step = () => track.querySelector('.quote')?.getBoundingClientRect().width ?? 320;
      scope.querySelector('[data-quote-prev]')?.addEventListener('click', () => {
        track.scrollBy({ left: -step() - 24, behavior: 'smooth' });
      });
      scope.querySelector('[data-quote-next]')?.addEventListener('click', () => {
        track.scrollBy({ left: step() + 24, behavior: 'smooth' });
      });
    });
  })();
</script>

<style>
  .quotes__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .quotes__nav {
    display: flex;
    gap: 0.5rem;
  }

  .quotes__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    cursor: pointer;
  }

  .quotes__arrow svg {
    width: 16px;
    height: 16px;
  }

  .quotes__arrow:hover {
    border-color: var(--color-crimson);
    color: var(--color-crimson);
  }

  .quotes__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: 1rem;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 64rem) {
    .quotes__viewport {
      overflow-x: visible;
    }
  }

  .quotes {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(min(20rem, 82%), 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .quotes {
      grid-auto-columns: minmax(0, 1fr);
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: row;
    }
  }

  .quote {
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    padding: 1.75rem;
    background-color: var(--color-offwhite);
    border-radius: var(--radius-lg);
  }

  .quote__glyph {
    color: var(--color-crimson);
  }

  .quote__body {
    flex: 1;
    margin: 1rem 0 0;
  }

  .quote__body p {
    font-size: var(--text-xl);
    line-height: 1.55;
  }

  .quote__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
  }

  .quote__photo {
    border-radius: var(--radius-pill);
    object-fit: cover;
  }

  .quote__name {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .quote__origin {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
</style>
