---
/**
 * Testimonials — swipe/arrow/dots only. AUTO-ADVANCE IS OFF, deliberately:
 * PRD §9.4 forbids autoplay carousels, and PAGE_TEMPLATES T1 §8 says so
 * explicitly. A luxury page does not move on its own.
 *
 * Implemented as a scroll-snap track, so swipe works natively on touch and the
 * controls just nudge the scroll position. That keeps it keyboard-reachable
 * (the track is focusable and arrow keys scroll it) with almost no JS. At
 * >=64rem the track becomes a static three-column grid and the controls are
 * hidden, because there is nothing left to scroll.
 *
 * ---------------------------------------------------------------------------
 * PLACEHOLDER SLOTS (design round 3 — word control). A slot with no review yet
 * renders ONE quiet italic line and the lotus. It previously rendered the
 * internal explanation of why no review existed, at quote size, under an
 * invented guest name — which is exactly the failure the word-control rule was
 * written for. `placeholder` entries carry no name, origin or quote at all
 * (the schema refuses them), so there is nothing here to leak.
 */
import Lotus from './Lotus.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface TestimonialItem {
  name?: string;
  origin?: string;
  tripLabel: string;
  quote?: string;
  photo?: ImageMetadata;
  placeholder?: boolean;
}

interface Props {
  testimonials: TestimonialItem[];
  heading?: string;
}

const { testimonials, heading = 'What travellers say' } = Astro.props;

/** "James & Clare W." -> "JC". Never more than two characters. */
const initialsOf = (name: string) =>
  name
    .replace(/[^A-Za-z\s&]/g, ' ')
    .split(/[\s&]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]!.toUpperCase())
    .join('');

const showNav = testimonials.length > 1;
---

{testimonials.length > 0 && (
  <section class="band quotes__band">
    <div class="container-content">
      <div class="quotes__head">
        <div>
          <p class="eyebrow">In their words</p>
          <h2 class="quotes__heading">{heading}</h2>
        </div>
        {showNav && (
          <div class="quotes__nav">
            <button type="button" class="quotes__arrow tap-target" data-quote-prev aria-label="Previous testimonial">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="quotes__arrow tap-target" data-quote-next aria-label="Next testimonial">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        )}
      </div>

      <!-- The scroll region and the list are SEPARATE elements on purpose.
           Putting role="group" on the <ul> itself overrides its implicit list
           role, which orphans every <li> in the accessibility tree (axe flags
           it, and screen readers stop announcing item counts). The focusable
           wrapper takes the role; the list stays a list. -->
      <div
        data-allow-clip
        class="quotes__viewport"
        data-quote-track
        tabindex="0"
        role="group"
        aria-label="Traveller testimonials, use arrow keys to scroll"
      >
      <ul class="quotes">
        {testimonials.map((item) => (
          <li class:list={['quote', { 'quote--empty': item.placeholder }]}>
            {/* Oversized, cropped at the corner, very low opacity — the same
                watermark language as the dark bands (design round 3). */}
            <span class="quote__watermark" data-allow-clip aria-hidden="true"><Lotus size={132} /></span>

            {item.placeholder ? (
              <p class="quote__pending">
                <Lotus size={18} tone="burgundy" class="quote__pendingmark" />
                <span>Guest review coming soon</span>
              </p>
            ) : (
              <blockquote class="quote__body">
                <p>{item.quote}</p>
              </blockquote>
            )}

            <footer class="quote__meta">
              {!item.placeholder && (
                <span class="quote__avatar" aria-hidden="true">
                  {item.photo ? (
                    <Image src={item.photo} alt="" width={44} height={44} loading="lazy" class="quote__photo" />
                  ) : (
                    /* Initials, never a stock face. A stranger's photograph
                       presented as a guest is a fabrication, not a placeholder. */
                    <span class="quote__initials">{initialsOf(item.name ?? '')}</span>
                  )}
                </span>
              )}
              <div class="quote__who">
                {item.name && <p class="quote__name">{item.name}</p>}
                {item.origin && <p class="quote__origin">{item.origin}</p>}
                <p class="quote__trip">{item.tripLabel}</p>
              </div>
            </footer>
          </li>
        ))}
      </ul>
      </div>

      {showNav && (
        /* Dots are a JS affordance: without JS they cannot track the scroll
           position, so they are hidden rather than rendered inert. */
        <div class="quotes__dots" data-quote-dots role="tablist" aria-label="Testimonial">
          {testimonials.map((_, index) => (
            <button
              type="button"
              class="quotes__dot"
              role="tab"
              data-quote-dot={index}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-label={`Testimonial ${index + 1} of ${testimonials.length}`}
            />
          ))}
        </div>
      )}
    </div>
  </section>
)}

<script is:inline>
  (() => {
    const boot = () => {
      document.querySelectorAll('[data-quote-track]').forEach((track) => {
        if (track.dataset.quoteBound) return;
        track.dataset.quoteBound = '1';
        const scope = track.closest('section');
        if (!scope) return;
        const cards = Array.from(track.querySelectorAll('.quote'));
        const dots = Array.from(scope.querySelectorAll('[data-quote-dot]'));
        const step = () => cards[0]?.getBoundingClientRect().width ?? 320;

        scope.querySelector('[data-quote-prev]')?.addEventListener('click', () => {
          track.scrollBy({ left: -step() - 24, behavior: 'smooth' });
        });
        scope.querySelector('[data-quote-next]')?.addEventListener('click', () => {
          track.scrollBy({ left: step() + 24, behavior: 'smooth' });
        });

        dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            const card = cards[index];
            if (card) track.scrollTo({ left: card.offsetLeft - track.offsetLeft, behavior: 'smooth' });
          });
        });

        if (!dots.length || !('IntersectionObserver' in window)) return;
        const seen = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const index = cards.indexOf(entry.target);
              dots.forEach((dot, i) => dot.setAttribute('aria-selected', String(i === index)));
            }
          },
          { root: track, threshold: 0.6 },
        );
        cards.forEach((card) => seen.observe(card));
      });
    };

    boot();
    document.addEventListener('astro:page-load', boot);
  })();
</script>

<style>
  .quotes__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .quotes__heading {
    margin-top: 0.6rem;
    font-size: var(--text-h2);
  }

  .quotes__nav {
    display: flex;
    flex: none;
    gap: 0.5rem;
  }

  @media (min-width: 64rem) {
    .quotes__nav {
      display: none;
    }
  }

  .quotes__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--color-burgundy-hairline);
    border-radius: var(--radius-pill);
    color: var(--color-burgundy);
    cursor: pointer;
  }

  .quotes__arrow svg {
    width: 16px;
    height: 16px;
  }

  .quotes__arrow:hover {
    background-color: var(--color-burgundy);
    border-color: var(--color-burgundy);
    color: var(--color-white);
  }

  .quotes__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: 1rem;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 64rem) {
    .quotes__viewport {
      overflow-x: visible;
    }
  }

  .quotes {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(min(20rem, 82%), 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .quotes {
      grid-auto-columns: minmax(0, 1fr);
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: row;
    }
  }

  /* Firmer presence than round 2: off-white on white was reading as nothing at
     all, so the border is burgundy at low opacity rather than the generic
     hairline, and the card carries the corner watermark. */
  .quote {
    position: relative;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    padding: 2rem 1.75rem 1.75rem;
    background-color: var(--color-offwhite);
    border: 1px solid var(--color-burgundy-hairline);
    border-radius: var(--radius-lg);
    overflow: clip;
    isolation: isolate;
  }

  .quote__watermark {
    position: absolute;
    top: -2.25rem;
    right: -2.25rem;
    z-index: -1;
    color: var(--color-burgundy);
    opacity: 0.07;
    pointer-events: none;
  }

  .quote__body {
    flex: 1;
    margin: 0;
  }

  .quote__body p {
    font-size: var(--text-xl);
    line-height: 1.55;
  }

  /* The whole point of the word-control rule: short, quiet, unmistakably not a
     review. One line, italic, muted — never a paragraph at quote size. */
  .quote__pending {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--text-base);
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .quote__pendingmark {
    opacity: 0.75;
  }

  .quote__meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-burgundy-hairline);
  }

  .quote__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background-color: var(--color-burgundy);
    color: var(--color-white);
    overflow: clip;
  }

  .quote__initials {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .quote__photo {
    width: 44px;
    height: 44px;
    object-fit: cover;
  }

  .quote__name {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .quote__origin {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  /* The trip is a fact rather than a line of prose, so it reads as a tag. */
  .quote__trip {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    border: 1px solid var(--color-burgundy-hairline);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-burgundy);
  }

  .quotes__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  :global(html:not(.js)) .quotes__dots {
    display: none;
  }

  @media (min-width: 64rem) {
    .quotes__dots {
      display: none;
    }
  }

  .quotes__dot {
    width: 44px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .quotes__dot::before {
    content: '';
    display: block;
    width: 100%;
    height: 3px;
    border-radius: var(--radius-pill);
    background-color: var(--color-burgundy-hairline);
  }

  .quotes__dot[aria-selected='true']::before {
    background-color: var(--color-crimson);
  }

  @media (prefers-reduced-motion: no-preference) {
    .quotes__dot::before {
      transition: background-color var(--duration-base) var(--ease-brand);
    }
  }
</style>
