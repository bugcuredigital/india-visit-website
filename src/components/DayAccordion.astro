---
/**
 * S6 — Day-by-Day itinerary.
 * ---------------------------------------------------------------------------
 * Built on native <details>/<summary>, which gives keyboard operation, Esc
 * behaviour and find-in-page for free, and means the content is present for
 * search engines whether or not a day is open.
 *
 * Per the Template Spec: first three days expanded by default, days 8+ stay
 * collapsed so a 13-day trip does not become an endless page, and an
 * "Expand all" control is available.
 *
 * IDs are `day-{n}` to match the anchors GlanceTable emits.
 *
 * The height transition is deliberately absent: animating a <details> panel
 * means animating height, which the motion spec forbids outright (layout
 * thrash kills INP). The chevron rotate is transform-only and does the work.
 */
import TransportChip from './TransportChip.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Day {
  dayNo: number;
  title: string;
  narrative: string;
  overnight: string;
  transport?: { mode: 'flight' | 'overnight-train' | 'train' | 'drive' | 'boat' | 'walk'; detail: string };
  /** 0–4 photographs (PRD v1.5). One fills the day body; two or more become a
   *  two-column grid. A day with none renders no image area at all — an empty
   *  day is not an unphotographed slot, so it gets no placeholder. */
  dayImages?: ImageMetadata[];
  /** City pages this day's title names, where such a page exists (PRD v1.5). */
  cities?: Array<{ slug: string; name: string; href: string }>;
  provisional?: boolean;
}

interface Props {
  days: Day[];
  heading?: string;
  /** Shows a build-time notice when any day's copy is unapproved. */
  showProvisionalNotice?: boolean;
}

const { days, heading = 'Day by Day', showProvisionalNotice = false } = Astro.props;
const hasProvisional = days.some((day) => day.provisional);
---

<section class="band" id="day-by-day">
  <div class="container-content">
    <div class="days__head">
      <h2>{heading}</h2>
      <button type="button" class="days__toggle tap-target" data-expand-all>
        Expand all
      </button>
    </div>

    {showProvisionalNotice && hasProvisional && (
      <p class="days__notice">
        Some day descriptions are drafted from the published route and are
        awaiting the operator's confirmed copy.
      </p>
    )}

    <ol class="days">
      {days.map((day, index) => (
        <li class="days__item">
          <details class="day" id={`day-${day.dayNo}`} open={index < 3}>
            <summary class="day__summary">
              <span class="day__no">Day {String(day.dayNo).padStart(2, '0')}</span>
              <span class="day__title">{day.title}</span>
              <svg class="day__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>

            <div class="day__body">
              {day.transport && (
                <p class="day__transport">
                  <TransportChip mode={day.transport.mode} detail={day.transport.detail} />
                </p>
              )}
              <p class="day__narrative">{day.narrative}</p>
              {day.dayImages && day.dayImages.length > 0 && (
                <ul
                  class:list={['dayshots', { 'dayshots--pair': day.dayImages.length > 1 }]}
                >
                  {day.dayImages.slice(0, 4).map((shot) => (
                    <li class="dayshots__item">
                      {/*
                        alt="" on purpose: the narrative immediately above
                        describes this day, so alt text would read back to a
                        screen-reader user what they have just been told.

                        loading="lazy" AND decoding="async": days 1-3 are open
                        by default, so without both, a day-1 photograph could
                        contend with the hero for the LCP on a short page.
                      */}
                      <Image
                        src={shot}
                        alt=""
                        widths={[320, 480, 800]}
                        sizes={
                          day.dayImages && day.dayImages.length > 1
                            ? '(min-width: 48rem) 20rem, 45vw'
                            : '(min-width: 48rem) 40rem, 92vw'
                        }
                        loading="lazy"
                        decoding="async"
                        fetchpriority="low"
                        quality={58}
                        class="dayshots__img"
                      />
                    </li>
                  ))}
                </ul>
              )}
              {day.cities && day.cities.length > 0 && (
                /*
                  The city link belongs HERE and not in the <summary> above it,
                  even though the summary is where the city is named. An anchor
                  nested inside a disclosure control both navigates and toggles
                  the panel on the same click, and it is reached by Tab as a
                  second stop inside a control that is already one — a keyboard
                  and assistive-technology trap for the sake of a shortcut. The
                  link does the same job one line down, where it also reads as
                  a next step rather than as decoration on the heading.
                */
                <p class="day__cities">
                  {day.cities.map((city) => (
                    <a class="day__city" href={city.href}>
                      <span>Explore {city.name}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </p>
              )}
              <p class="day__overnight">{day.overnight}</p>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-expand-all]').forEach((button) => {
      const section = button.closest('section');
      if (!section) return;
      button.addEventListener('click', () => {
        const panels = section.querySelectorAll('details.day');
        const shouldOpen = button.dataset.state !== 'open';
        panels.forEach((panel) => {
          panel.open = shouldOpen;
        });
        button.dataset.state = shouldOpen ? 'open' : 'closed';
        button.textContent = shouldOpen ? 'Collapse all' : 'Expand all';
      });
    });
  })();
</script>

<style>
  .days__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .days__toggle {
    padding: 0 0.25rem;
    background: none;
    border: 0;
    color: var(--color-crimson);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .days__toggle:hover {
    color: var(--color-burgundy);
    text-decoration: underline;
  }

  .days__notice {
    margin-bottom: 1.5rem;
    padding: 0.85rem 1rem;
    /* Burgundy, not yellow: yellow is legal on plum/burgundy ONLY, never on
       a light surface (CLAUDE.md invariant #5). A fine rule on a light
       surface is burgundy's role per the design direction. */
    border-left: 3px solid var(--color-burgundy);
    background-color: var(--color-offwhite);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .days {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .day {
    border-top: 1px solid var(--color-hairline);
  }

  .days__item:last-child .day {
    border-bottom: 1px solid var(--color-hairline);
  }

  .day__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    /* 44px+ target across the full row width. */
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
  }

  .day__summary::-webkit-details-marker {
    display: none;
  }

  .day__no {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-crimson);
    white-space: nowrap;
  }

  .day__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-heading);
    color: var(--color-ink);
  }

  .day__chevron {
    width: 12px;
    height: 8px;
    color: var(--color-ink-muted);
  }

  .day__body {
    padding-bottom: 1.75rem;
    /* Align with the title column on wide viewports. */
    max-width: var(--container-prose);
  }

  .day__transport {
    margin-bottom: 0.9rem;
  }

  /* Rounded frames on white, gallery-style (design direction). The aspect
     ratio is fixed by the template rather than by the upload, so swapping the
     client's archive in cannot reflow a 13-day itinerary. */
  .dayshots {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Two side by side; three or four wrap into the same two columns. Kept at
     two even on a phone — a pair reads as a pair, and stacking them would push
     the overnight line four screens down inside one day. */
  .dayshots--pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dayshots__item {
    margin: 0;
  }

  .dayshots__img {
    width: 100%;
    height: 100%;
    /* A lone photograph runs the full prose measure, so 4:3 would make it
       about 520px tall — more page than a single day's illustration has
       earned. 3:2 is the same picture, calmer. Pairs and grids keep 4:3,
       where each frame is half the width and the height is already modest. */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .dayshots--pair .dayshots__img {
    aspect-ratio: 4 / 3;
  }

  .day__cities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .day__city {
    display: inline-flex;
    align-items: center;
    /* Flex items get their leading whitespace trimmed, so the space before the
       arrow has to be a gap rather than a character. */
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    /* Ink, not crimson. An eight-day itinerary can put half a dozen of these
       on one screen, and crimson is reserved for the single action that
       matters in a viewport — here that is "Customise This Journey". A city
       chip is a way out of the page, not the way forward. */
    color: var(--color-ink);
    text-decoration: none;
  }

  .day__city:hover {
    border-color: var(--color-crimson);
    color: var(--color-crimson);
  }

  .day__overnight {
    margin-top: 1rem;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-ink-muted);
  }

  /* Transform-only: chevron rotates, nothing animates height. */
  @media (prefers-reduced-motion: no-preference) {
    .day__chevron {
      transition: transform var(--duration-base) var(--ease-brand);
    }

    .day[open] .day__chevron {
      transform: rotate(180deg);
    }
  }
</style>
