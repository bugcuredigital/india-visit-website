---
/**
 * S2 — Quick Facts bar. Required on every itinerary page, in the same
 * position on all 20, which is what the Template Spec §6 checklist verifies.
 * Stacks 2×2 on mobile.
 *
 * Pace and "Ideal for" are editorial fields the client assigns; they help
 * Personas 2 and 3 self-select, which is why they sit this high on the page.
 */
interface Props {
  nights: number;
  days: number;
  startCity: string;
  endCity: string;
  pace: string;
  bestSeason: string;
  idealFor: string[];
}

const { nights, days, startCity, endCity, pace, bestSeason, idealFor } = Astro.props;

const titleCase = (value: string) =>
  value.replace(/(^|[\s-])([a-z])/g, (_, sep, chr) => sep + chr.toUpperCase());

const facts = [
  { label: 'Duration', value: `${nights} Nights · ${days} Days` },
  { label: 'Route', value: startCity === endCity ? `${startCity} return` : `${startCity} → ${endCity}` },
  { label: 'Pace', value: titleCase(pace) },
  { label: 'Best season', value: bestSeason },
  { label: 'Ideal for', value: idealFor.map(titleCase).join(', ') },
];
---

<section class="quickfacts band-offwhite" aria-label="Journey at a glance">
  <div class="container-content">
    <dl class="quickfacts__grid">
      {facts.map((fact) => (
        <div class="quickfacts__item">
          <dt class="quickfacts__label">{fact.label}</dt>
          <dd class="quickfacts__value">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .quickfacts {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .quickfacts__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 1.5rem;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .quickfacts__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .quickfacts__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .quickfacts__value {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-ink);
  }
</style>
