---
/**
 * JourneyCard — the listing unit, reused on the homepage, journeys index,
 * destination pages, related strips and inline in articles.
 *
 * Variant B cards get plum treatment plus a "Fixed Departures" tag so trains
 * read as a different product at a glance (PAGE_TEMPLATES T3).
 *
 * Price is routed through `displayPrice`, which returns null unless
 * `showPrices` is on — and always null for Variant B, since operator tariffs
 * are never published. The card therefore cannot leak a price by accident.
 *
 * The image carries `transition:name` so M4's view transition can morph the
 * card into the itinerary hero.
 *
 * THREE SIZES, and the difference is editorial rather than cosmetic:
 *   · `featured` — the homepage's six picks. A recommendation, so it gets room
 *     for the route line.
 *   · `default`  — related strips, destination pages, inline in articles.
 *   · `compact`  — the /journeys/ archive ONLY (design revision round 2). Forty
 *     full-height cards turned a tool page into a scroll, so the body is
 *     clipped to a duration pill and the title. The image height is unchanged
 *     on purpose: the photograph is what a visitor actually scans. Everything
 *     removed is one click away on the journey page itself.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getSiteSettings, displayPrice } from '../lib/site-settings';

interface Props {
  slug: string;
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  nights: number;
  days: number;
  routeCities: string[];
  variant: 'A' | 'B';
  signatureFeature?: string;
  priceFrom?: number;
  /** `featured` = homepage row; `compact` = the /journeys/ archive grid. */
  size?: 'default' | 'featured' | 'compact';
  /** GC/DO launch as full pages, but the state exists for future titles. */
  comingSoon?: boolean;
}

const {
  slug,
  title,
  image,
  imageAlt,
  nights,
  days,
  routeCities,
  variant,
  signatureFeature,
  priceFrom,
  size = 'default',
  comingSoon = false,
} = Astro.props;

const settings = await getSiteSettings();
const price = displayPrice(settings, priceFrom, variant);
const href = comingSoon ? '/plan-my-trip/' : `/journeys/${slug}/`;
const route = routeCities.join(' · ');
const isCompact = size === 'compact';
---

<article class:list={['card', `card--${size}`, { 'card--train': variant === 'B' }]}>
  <a class="card__link" href={href}>
    <div class="card__media">
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 600, 900]}
        sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 90vw"
        loading="lazy"
        class="card__img"
        transition:name={`journey-image-${slug}`}
      />
      {variant === 'B' && <p class="card__tag">Fixed Departures</p>}
      {comingSoon && <p class="card__tag card__tag--soon">Coming soon</p>}
    </div>

    <div class="card__body">
      {
        isCompact ? (
          <>
            {/* "11N · 12D" — a pill, not a line of caps. The whole card is the
                link, so there is no "View journey" affordance to repeat. */}
            <p class="card__pill">
              {nights}N · {days}D
            </p>
            <h3 class="card__title" transition:name={`journey-title-${slug}`}>
              {title}
            </h3>
          </>
        ) : (
          <>
            <p class="card__duration">
              {nights} Nights · {days} Days
            </p>
            <h3 class="card__title" transition:name={`journey-title-${slug}`}>
              {title}
            </h3>
            <p class="card__route">{route}</p>
            {signatureFeature && <p class="card__feature">{signatureFeature}</p>}
            {price && <p class="card__price">{price}</p>}
            <span class="card__cta" aria-hidden="true">
              {comingSoon ? 'Enquire for details' : 'View journey'} →
            </span>
          </>
        )
      }
    </div>
  </a>
</article>

<style>
  .card {
    background-color: var(--color-white);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  /* Trains read as a different product: plum ground, light text. */
  .card--train {
    background-color: var(--color-plum);
    border-color: var(--color-plum);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background-color: var(--color-offwhite);
  }

  .card--featured .card__media {
    aspect-ratio: 16 / 10;
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__tag {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.28rem 0.65rem;
    border-radius: var(--radius-pill);
    /* Yellow on plum — legal, and only used on the train treatment. */
    background-color: var(--color-yellow);
    color: var(--color-plum);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .card__tag--soon {
    background-color: var(--color-white);
    color: var(--color-ink);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.35rem 1.35rem 1.5rem;
  }

  .card--compact .card__body {
    padding: 1rem 1.1rem 1.15rem;
  }

  /* Duration as a pill rather than a caps line: at this density the card needs
     one small solid shape to anchor the eye, and the pill reads as a fact
     rather than as a link. */
  .card__pill {
    align-self: flex-start;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-offwhite);
    border: 1px solid var(--color-card-border);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
  }

  .card--train .card__pill {
    background-color: color-mix(in srgb, var(--color-on-dark) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-on-dark) 24%, transparent);
    color: var(--color-yellow);
  }

  .card__duration {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-crimson);
  }

  .card--train .card__duration {
    color: var(--color-yellow);
  }

  .card__title {
    margin-top: 0.5rem;
    font-size: var(--text-2xl);
  }

  /* One type-step down, and hard-clipped to two lines so a long title cannot
     make one card taller than its neighbours in a forty-card grid. */
  .card--compact .card__title {
    margin-top: 0.6rem;
    font-size: var(--text-xl);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card--train .card__title {
    color: var(--color-on-dark);
  }

  .card__route {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    /* Long city chains stay to two lines rather than stretching the card. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card--train .card__route {
    color: var(--color-on-dark-muted);
  }

  .card__feature {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .card--train .card__feature {
    color: var(--color-on-dark-muted);
  }

  .card__price {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
  }

  .card__cta {
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-crimson);
  }

  .card--train .card__cta {
    color: var(--color-yellow);
  }

  /* Shadow on hover only, 2–4px lift (design direction). */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform var(--duration-fast) var(--ease-brand),
        box-shadow var(--duration-fast) var(--ease-brand);
    }

    .card__img {
      transition: transform var(--duration-slow) var(--ease-brand);
    }

    .card:hover {
      transform: translate3d(0, -4px, 0);
      box-shadow: var(--shadow-lift-hover);
    }

    .card:hover .card__img {
      transform: scale(1.03);
    }
  }
</style>
