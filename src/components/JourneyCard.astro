---
/**
 * JourneyCard — the listing unit, reused on the homepage, journeys index,
 * destination pages, city pages, related strips and inline in articles.
 *
 * ONE TREATMENT EVERYWHERE (design round 3). It used to have three sizes —
 * `featured` for the homepage, `default` for strips, `compact` for the archive
 * — and the differences were editorial arguments about how much each context
 * deserved. The client's ruling is simpler and better: a journey card is a
 * journey card. Image, duration pill, title, "View journey". The route line
 * and the signature feature are gone from ALL cards, because they were the
 * part that made one card twice the height of another and they are both on the
 * journey page itself, one click away.
 *
 * COLOUR ON HOVER ONLY. Variant B cards used to carry a permanent plum ground
 * so trains read as a different product; with plum demoted (round 3, item 9)
 * that would just have become a permanent burgundy ground, which is a colour
 * flood by another name. Every card is now white at rest and its footer turns
 * burgundy on hover or keyboard focus. Trains keep the "Fixed Departures"
 * badge, which is the part that actually carries the meaning — a badge says
 * what a background colour only implies, and it survives being looked at by
 * someone who cannot see colour.
 *
 * Price is routed through `displayPrice`, which returns null unless
 * `showPrices` is on — and always null for Variant B, since operator tariffs
 * are never published. The card therefore cannot leak a price by accident. It
 * renders nothing today; the path stays wired so the pricing decision remains
 * reversible without a component edit (invariant #1).
 *
 * The image carries `transition:name` so the view transition can morph the
 * card into the itinerary hero.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getSiteSettings, displayPrice } from '../lib/site-settings';

interface Props {
  slug: string;
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  nights: number;
  days: number;
  variant: 'A' | 'B';
  priceFrom?: number;
  /** GC/DO launch as full pages, but the state exists for future titles. */
  comingSoon?: boolean;
}

const {
  slug,
  title,
  image,
  imageAlt,
  nights,
  days,
  variant,
  priceFrom,
  comingSoon = false,
} = Astro.props;

const settings = await getSiteSettings();
const price = displayPrice(settings, priceFrom, variant);
const href = comingSoon ? '/plan-my-trip/' : `/journeys/${slug}/`;
---

<article class="card">
  <a class="card__link" href={href}>
    <div class="card__media">
      {/* Two attributes below are load-order decisions rather than styling.
          `fetchpriority="low"`: a card image is never the LCP element in any
          arrangement of this component, and saying so keeps it behind whatever
          is — on the article page one card image was racing the hero it sits
          below. `quality={58}`: Astro's default is tuned for images you look
          AT; this one renders at 400 CSS pixels behind a lazy load, and at the
          default it was that page's single heaviest asset at 139KB. 58 halves
          it with no visible difference at card size.

          (These are JSX comments, and they must live OUTSIDE the attribute
          list. Inside it the build tolerates them and `astro check` does not —
          third time on this project.) */}
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 600, 900]}
        sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 90vw"
        loading="lazy"
        decoding="async"
        fetchpriority="low"
        quality={58}
        class="card__img"
        transition:name={`journey-image-${slug}`}
      />
      {variant === 'B' && <p class="card__tag">Fixed Departures</p>}
      {comingSoon && <p class="card__tag card__tag--soon">Coming soon</p>}
    </div>

    <div class="card__body">
      <p class="card__meta">
        {/* "11N · 12D" — a pill, not a line of caps. One small solid shape to
            anchor the eye at the top of the body. */}
        <span class="card__pill">{nights}N · {days}D</span>
        {price && <span class="card__price">{price}</span>}
      </p>
      <h3 class="card__title" transition:name={`journey-title-${slug}`}>
        {title}
      </h3>
      <span class="card__cta" aria-hidden="true">
        {comingSoon ? 'Enquire for details' : 'View journey'} →
      </span>
    </div>
  </a>
</article>

<style>
  .card {
    background-color: var(--color-white);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background-color: var(--color-offwhite);
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__tag {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.28rem 0.65rem;
    border-radius: var(--radius-pill);
    /* Yellow on burgundy — legal, and the badge carries its own dark ground
       rather than relying on whatever the photograph happens to be. */
    background-color: var(--color-burgundy);
    color: var(--color-yellow);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .card__tag--soon {
    background-color: var(--color-white);
    color: var(--color-ink);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem 1.25rem 1.3rem;
    background-color: var(--color-white);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .card__pill {
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-offwhite);
    border: 1px solid var(--color-card-border);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-burgundy);
  }

  .card__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  /* Clipped to two lines so one long title cannot make a card taller than its
     neighbours in a forty-card grid. */
  .card__title {
    margin-top: 0.7rem;
    font-size: var(--text-xl);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__cta {
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-crimson);
  }

  /* ---- HOVER: the only place a card carries colour ---------------------
     `:focus-within` as well as `:hover`, because the whole card is one link
     and a keyboard user should get the same affordance a mouse user gets.
     Colour changes are not gated behind prefers-reduced-motion — they are not
     motion; only the lift and the image scale below are. */
  .card__body,
  .card__pill,
  .card__title,
  .card__cta {
    transition:
      background-color var(--duration-base) var(--ease-brand),
      border-color var(--duration-base) var(--ease-brand),
      color var(--duration-base) var(--ease-brand);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-burgundy);
  }

  .card:hover .card__body,
  .card:focus-within .card__body {
    background-color: var(--color-burgundy);
  }

  .card:hover .card__title,
  .card:focus-within .card__title {
    color: var(--color-on-dark);
  }

  .card:hover .card__cta,
  .card:focus-within .card__cta {
    color: var(--color-yellow);
  }

  .card:hover .card__pill,
  .card:focus-within .card__pill {
    background-color: color-mix(in srgb, var(--color-on-dark) 14%, transparent);
    border-color: color-mix(in srgb, var(--color-on-dark) 26%, transparent);
    color: var(--color-on-dark);
  }

  .card:hover .card__price,
  .card:focus-within .card__price {
    color: var(--color-on-dark);
  }

  /* Shadow and lift on hover only, 2–4px (design direction). */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform var(--duration-fast) var(--ease-brand),
        border-color var(--duration-base) var(--ease-brand),
        box-shadow var(--duration-fast) var(--ease-brand);
    }

    .card__img {
      transition: transform var(--duration-slow) var(--ease-brand);
    }

    .card:hover,
    .card:focus-within {
      transform: translate3d(0, -4px, 0);
      box-shadow: var(--shadow-lift-hover);
    }

    .card:hover .card__img,
    .card:focus-within .card__img {
      transform: scale(1.03);
    }
  }
</style>
