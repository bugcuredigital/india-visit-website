---
/**
 * Trust stats with count-up on scroll into view.
 * ---------------------------------------------------------------------------
 * Renders 2–4 stats gracefully, because it is fed `verifiedTrustStats()` and
 * an unanswered open question means one fewer stat, never a placeholder number
 * (PRD Open Question #2). Nothing here invents a figure.
 *
 * The count-up is a ~20-line vanilla island (PRD §9.4). Two accessibility
 * details that matter more than the effect:
 *   · the final value is in the HTML, so it is correct with JS off and for
 *     screen readers reading before animation finishes
 *   · under prefers-reduced-motion the number simply appears
 *
 * Only the numeric portion animates; suffixes like "+" and strings like "24/7"
 * are left exactly as authored.
 */
interface Props {
  stats: Array<{ value: string; label: string }>;
  surface?: 'white' | 'offwhite' | 'plum';
}

const { stats, surface = 'offwhite' } = Astro.props;

const bandClass =
  surface === 'plum' ? 'band-plum on-dark' : surface === 'offwhite' ? 'band-offwhite' : '';
---

<section class:list={['band band-tight', bandClass]}>
  <div class="container-content">
    <dl class="stats">
      {stats.map((stat) => (
        <div class="stat">
          <dt class="stat__value" data-countup={stat.value}>{stat.value}</dt>
          <dd class="stat__label">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script is:inline>
  (() => {
    const targets = document.querySelectorAll('[data-countup]');
    if (!targets.length) return;
    if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
    if (!('IntersectionObserver' in window)) return;

    const run = (el) => {
      const final = el.dataset.countup ?? '';
      const match = final.match(/^(\D*)(\d[\d,]*)(.*)$/);
      if (!match) return; // "24/7" and similar are left alone
      const [, prefix, digits, suffix] = match;
      const target = Number(digits.replace(/,/g, ''));
      const duration = 900;
      const start = performance.now();
      const tick = (now) => {
        const progress = Math.min((now - start) / duration, 1);
        // Same easing family as the CSS, so motion feels of a piece.
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = prefix + Math.round(target * eased).toLocaleString('en-IN') + suffix;
        if (progress < 1) requestAnimationFrame(tick);
        else el.textContent = final;
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          run(entry.target);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.4 },
    );
    targets.forEach((el) => io.observe(el));
  })();
</script>

<style>
  /* Full-width row of big display numerals divided by hairlines — the bar
     should read as one confident band, not four cards. Two columns on a
     phone, four across from 48rem. */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
  }

  .stat {
    padding: 0.75rem 1.25rem 0.9rem;
  }

  /* Hairlines BETWEEN cells only, never on the outer edges. Drawn with
     borders on the cell rather than a separate element so they cannot fall
     out of step with the grid when it reflows. */
  .stat:nth-child(odd) {
    border-inline-end: 1px solid var(--color-hairline);
    padding-inline-start: 0;
  }

  .stat:nth-child(even) {
    padding-inline-end: 0;
  }

  .stat:nth-child(n + 3) {
    border-block-start: 1px solid var(--color-hairline);
    margin-block-start: 0.75rem;
    padding-block-start: 1.5rem;
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .stat {
      padding-block: 0;
      border-inline-end: 1px solid var(--color-hairline);
    }

    .stat:first-child {
      padding-inline-start: 0;
    }

    /* Last cell carries no divider, and nothing carries a top rule once the
       row is a single line. */
    .stat:last-child {
      border-inline-end: 0;
      padding-inline-end: 0;
    }

    .stat:nth-child(n + 3) {
      border-block-start: 0;
      margin-block-start: 0;
      padding-block-start: 0;
    }
  }

  .on-dark .stat,
  .on-dark .stat:nth-child(odd) {
    border-color: color-mix(in srgb, var(--color-on-dark) 22%, transparent);
  }

  .stat__value {
    font-family: var(--font-display);
    /* A step up from --text-stat: these numerals are meant to be the second
       loudest thing on the homepage, after the hero H1. */
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    /* Reserve the line box so the count-up cannot shift layout (CLS). */
    font-variant-numeric: tabular-nums;
  }

  .on-dark .stat__value {
    color: var(--color-yellow);
  }

  .stat__label {
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink-muted);
    text-wrap: balance;
  }

  .on-dark .stat__label {
    color: var(--color-on-dark-muted);
  }
</style>
