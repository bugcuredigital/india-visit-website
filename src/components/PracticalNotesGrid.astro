---
/**
 * S13 — Practical Notes. Icon-led grid: visa, getting there, best time,
 * currency, pace. High SEO value because it answers the
 * "best time to visit X" queries directly (PRD §11).
 *
 * Icons are named in content (`icon: calendar`), so an editor picks from a
 * known set rather than pasting emoji — and an unknown name falls back to the
 * lotus rather than rendering nothing.
 */
import Icon from './Icon.astro';
import Lotus from './Lotus.astro';
import type { PhosphorIconName } from '../lib/phosphor-icons';

interface Props {
  notes: Array<{ icon: string; label: string; text: string }>;
  heading?: string;
  surface?: 'white' | 'offwhite';
}

const { notes, heading = 'Practical notes', surface = 'offwhite' } = Astro.props;

/** Content's `icon` values → Phosphor glyphs (design round 6: these were
 *  hand-drawn at their own stroke weight; they now come from the one
 *  authorised set, at the regular weight, like the transfer chips). The
 *  content keys are unchanged, so no entry needed editing. */
const ICONS: Record<string, PhosphorIconName> = {
  calendar: 'calendar-blank',
  plane: 'airplane-tilt',
  clock: 'clock-regular',
  pace: 'path',
  passport: 'file-text',
  currency: 'money',
  weather: 'cloud',
};

/* Resolved once here, so an unknown key is a plain `undefined` (the lotus)
   rather than an index lookup TypeScript cannot narrow in the template. */
const items = notes.map((note) => ({ ...note, glyph: ICONS[note.icon] as PhosphorIconName | undefined }));

/* Columns on a wide screen follow the count, so no row is left mostly empty
   (round 5, #19 and #55): three notes sat in four columns, and a fifth note
   stood alone on its own row. Three or four across; whichever leaves the
   fuller last row, four on a tie. */
const count = items.length;
const lastRowFill = (cols: number) => (count % cols || cols) / cols;
const columns = count <= 4 ? Math.max(count, 1) : lastRowFill(4) >= lastRowFill(3) ? 4 : 3;
---

<section class:list={['band', surface === 'offwhite' && 'band-offwhite']}>
  <div class="container-content">
    <h2>{heading}</h2>
    <dl class="notes fade-up-stagger" style={`--notes-columns: ${columns}`}>
      {items.map((note) => (
        <div class="note">
          <span class="note__icon" aria-hidden="true">
            {note.glyph ? <Icon name={note.glyph} size={22} /> : <Lotus size={22} />}
          </span>
          <dt class="note__label">{note.label}</dt>
          <dd class="note__text">{note.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Each note is a quiet card since round 6: white on the band's off-white,
     a hairline edge, no shadow (shadow is a hover state, and these are not
     links). */
  .notes {
    display: grid;
    gap: 1.25rem;
    margin: 2.5rem 0 0;
  }

  .note {
    padding: 1.5rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 40rem) {
    .notes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .notes {
      grid-template-columns: repeat(var(--notes-columns, 4), 1fr);
    }
  }

  /* The glyph in a soft badge rather than floating (round 6). Burgundy, not
     crimson: four crimson icons per row were four calls to action. */
  .note__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--color-burgundy-tint);
    color: var(--color-burgundy);
  }

  .note__label {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.012em;
    color: var(--color-ink);
  }

  /* Was --text-sm in ink-muted, which disappeared at a glance. Practical
     notes are read, not skimmed past. (Round 6's spec set it back to small
     and muted; declined, this bump is a recorded ruling — tokens.css.) */
  .note__text {
    margin: 0.4rem 0 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-ink);
  }
</style>
