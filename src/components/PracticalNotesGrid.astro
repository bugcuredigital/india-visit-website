---
/**
 * S13 — Practical Notes. Icon-led grid: visa, getting there, best time,
 * currency, pace. High SEO value because it answers the
 * "best time to visit X" queries directly (PRD §11).
 *
 * Icons are named in content (`icon: calendar`), so an editor picks from a
 * known set rather than pasting emoji — and an unknown name falls back to the
 * lotus rather than rendering nothing.
 */
import Lotus from './Lotus.astro';

interface Props {
  notes: Array<{ icon: string; label: string; text: string }>;
  heading?: string;
  surface?: 'white' | 'offwhite';
}

const { notes, heading = 'Practical notes', surface = 'offwhite' } = Astro.props;

/** Stroked 20×20 glyphs. Keys are the `icon` values used in content. */
const ICONS: Record<string, string> = {
  calendar: 'M4 6h12v10H4Zm0 3.5h12M7.5 4v3m5-3v3',
  plane: 'M2.5 11 17 6l-2 5.5 2 5.5-14.5-5Z',
  clock: 'M10 4.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Zm0 2.5V10l2.5 1.5',
  pace: 'M10 3.5v4l3 2M3.5 10h2m9 0h2M10 14.5v2',
  passport: 'M5 3.5h10v13H5Zm2.5 3.5h5m-5 3h5m-5 3h3',
  currency: 'M10 4v12M7 7h4.5a2 2 0 0 1 0 4H7m0 0h5',
  weather: 'M6 12a3 3 0 1 1 .8-5.9A4 4 0 0 1 14.5 8a2.5 2.5 0 0 1 0 5H6Z',
};
---

<section class:list={['band', surface === 'offwhite' && 'band-offwhite']}>
  <div class="container-content">
    <h2>{heading}</h2>
    <dl class="notes fade-up-stagger">
      {notes.map((note) => (
        <div class="note">
          <span class="note__icon" aria-hidden="true">
            {ICONS[note.icon] ? (
              <svg viewBox="0 0 20 20" focusable="false">
                <path d={ICONS[note.icon]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            ) : (
              <Lotus size={20} />
            )}
          </span>
          <dt class="note__label">{note.label}</dt>
          <dd class="note__text">{note.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .notes {
    display: grid;
    gap: 2rem 1.75rem;
    margin: 2.5rem 0 0;
  }

  @media (min-width: 40rem) {
    .notes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .notes {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .note__icon {
    display: inline-flex;
    color: var(--color-crimson);
  }

  .note__icon svg {
    width: 24px;
    height: 24px;
  }

  .note__label {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-ink);
  }

  .note__text {
    margin: 0.4rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>
