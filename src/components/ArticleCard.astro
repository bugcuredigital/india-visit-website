---
/**
 * Article card — the Travel Guide teaser on the homepage and the card in the
 * /travel-guide/ index. Photography-led on white, per the design direction:
 * a rounded image frame, a crimson category label, then the title.
 *
 * The whole card is one link (the title's anchor stretched over the card), so
 * there is a single tab stop per card rather than three.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const CATEGORY_LABELS: Record<string, string> = {
  'planning-visas': 'Planning & Visas',
  'best-time': 'Best Time to Go',
  guides: 'Guides',
};

interface Props {
  slug: string;
  title: string;
  category: string;
  excerpt: string;
  image: ImageMetadata;
  imageAlt: string;
  publishDate: Date;
  updatedDate?: Date;
}

const { slug, title, category, excerpt, image, imageAlt, publishDate, updatedDate } =
  Astro.props;

const shown = updatedDate ?? publishDate;
const dateLabel = shown.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
});
---

<article class="post">
  <div class="post__frame">
    <Image
      src={image}
      alt={imageAlt}
      widths={[320, 480, 720]}
      sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw"
      loading="lazy"
      class="post__image"
    />
  </div>

  <p class="post__meta">
    <span class="post__category">{CATEGORY_LABELS[category] ?? category}</span>
    <span class="post__dot" aria-hidden="true">·</span>
    <time datetime={shown.toISOString()}>{dateLabel}</time>
    {updatedDate && <span class="visually-hidden">(updated)</span>}
  </p>

  <h3 class="post__title">
    <a href={`/travel-guide/${slug}/`} class="post__link">{title}</a>
  </h3>

  <p class="post__excerpt">{excerpt}</p>
</article>

<style>
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .post__frame {
    overflow: clip;
    border-radius: var(--radius-md);
    background-color: var(--color-offwhite);
    aspect-ratio: 4 / 3;
  }

  .post__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 1rem 0 0;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .post__category {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-crimson);
  }

  .post__title {
    margin: 0.45rem 0 0;
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  /* One tab stop per card: the anchor covers the card, so the meta line and
     excerpt are readable content rather than extra link text. */
  .post__link {
    color: inherit;
    text-decoration: none;
  }

  .post__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .post__link:hover {
    color: var(--color-crimson);
  }

  .post__excerpt {
    margin: 0.6rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    max-width: 42ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .post__image {
      transition: transform var(--duration-slow) var(--ease-brand);
    }

    .post:hover .post__image {
      transform: scale(1.03);
    }
  }
</style>
