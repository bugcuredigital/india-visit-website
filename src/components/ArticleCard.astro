---
/**
 * Article card — the Travel Guide teaser on the homepage and the card in the
 * /travel-guide/ index. Photography-led on white, per the design direction:
 * a rounded image frame, a crimson category label, then the title.
 *
 * The whole card is one link (the title's anchor stretched over the card), so
 * there is a single tab stop per card rather than three.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { categoryLabel, readingTime } from '../lib/posts';

interface Props {
  slug: string;
  title: string;
  category: string;
  excerpt: string;
  image: ImageMetadata;
  imageAlt: string;
  /** The article's markdown body, for its reading time. T8 §4 asks cards for
   *  reading time, and while seven of eight posts shared one publish date
   *  every card read "September 2026", which told nobody anything (round 5,
   *  #70). The article page itself still carries the date. */
  body: string;
  /** The Travel Guide index's lead article (T8 §2): a 21:9 frame across the
   *  container, files sized for that width, an H2-scale title. Until round 5
   *  (#68) the index styled a class this card does not have, so the lead
   *  rendered 4:3 from a 352px file stretched ~3.4×. */
  featured?: boolean;
}

const { slug, title, category, excerpt, image, imageAlt, body, featured = false } = Astro.props;

const minutes = readingTime(body);
---

<article class:list={['post', { 'post--featured': featured }]}>
  <div class="post__frame">
    <Image
      src={image}
      alt={imageAlt}
      widths={featured ? [640, 960, 1280, 1600] : [320, 480, 720]}
      sizes={featured ? '(min-width: 80rem) 76rem, 92vw' : '(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw'}
      loading={featured ? 'eager' : 'lazy'}
      fetchpriority={featured ? 'high' : undefined}
      class="post__image"
    />
  </div>

  <p class="post__meta">
    <!-- data-allow-clip: clipping the line-start dot is the technique. -->
    <span class="post__metaclip" data-allow-clip>
      <span class="post__metarow">
        <span class="post__category">{categoryLabel(category)}</span>
        <span class="post__time">{minutes} min read</span>
      </span>
    </span>
  </p>

  <h3 class="post__title">
    <a href={`/travel-guide/${slug}/`} class="post__link">{title}</a>
  </h3>

  <p class="post__excerpt">{excerpt}</p>
</article>

<style>
  /* A card since round 6 (external polish spec): white, hairline, the
     photograph bleeding to the card's edges and the copy inset below it.
     No shadow at rest; it lifts on hover and on keyboard focus, like the
     journey card (shadow appears on hover only, CLAUDE.md). */
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: clip;
    background-color: var(--color-white);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
  }

  .post > :not(.post__frame) {
    padding-inline: 1.25rem;
  }

  .post > :last-child {
    padding-bottom: 1.4rem;
  }

  /* The frame's shape is the template's, whatever the file is. In the card's
     flex column the frame's automatic minimum height was the photograph's own
     height, so every card rendered at its file's ratio (3:2), and the
     featured card's 21:9 never applied (round 5, #68; the journey card's #42
     had the same cause). The image fills the frame absolutely. */
  .post__frame {
    position: relative;
    flex: none;
    min-height: 0;
    overflow: clip;
    background-color: var(--color-offwhite);
    aspect-ratio: 4 / 3;
  }

  .post__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 21:9 from 40rem; on a phone that would be a 160px strip, so it stays 4:3. */
  @media (min-width: 40rem) {
    .post--featured .post__frame {
      aspect-ratio: 21 / 9;
    }
  }

  .post--featured .post__title {
    font-size: var(--text-h2);
  }

  /* Wraps BETWEEN its parts, never inside one: in a narrow four-up grid the
     wider-tracked category (round 6) left "Planning & / Visas" and the date
     folding mid-phrase. Now the date drops to its own line instead. */
  /* The parts are joined by a middle dot that never ends a line: each part
     carries its dot in front, the row is pulled one dot-width left, and a
     clipping box (inside the card's padding, so the padding cannot show it)
     cuts it off, so whichever part starts a line loses its dot.
     In a narrow card the category and the reading time wrap onto two clean
     lines instead of leaving a dot hanging at the end of the first. */
  .post__meta {
    margin: 1rem 0 0;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .post__metaclip {
    display: block;
    overflow: hidden;
  }

  .post__metarow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.15rem;
    margin-left: -1.2em;
  }

  .post__metarow > * {
    white-space: nowrap;
  }

  .post__metarow > *::before {
    content: '·';
    content: '·' / '';
    display: inline-block;
    width: 1.2em;
    text-align: center;
    color: var(--color-ink-muted);
    letter-spacing: 0;
  }

  .post__category {
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-crimson);
  }

  .post__title {
    margin: 0.45rem 0 0;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  /* One tab stop per card: the anchor covers the card, so the meta line and
     excerpt are readable content rather than extra link text. */
  .post__link {
    color: inherit;
    text-decoration: none;
  }

  .post__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .post__link:hover {
    color: var(--color-crimson);
  }

  .post__excerpt {
    margin: 0.6rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    max-width: 42ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .post {
      transition:
        transform var(--duration-fast) var(--ease-brand),
        box-shadow var(--duration-fast) var(--ease-brand);
    }

    .post:hover,
    .post:focus-within {
      transform: translate3d(0, -4px, 0);
      box-shadow: var(--shadow-lift-hover);
    }

    .post__image {
      transition: transform var(--duration-slow) var(--ease-brand);
    }

    .post:hover .post__image {
      transform: scale(1.03);
    }
  }
</style>
