---
/**
 * Header — sticky, white, hairline-bottomed, settings-driven.
 * ---------------------------------------------------------------------------
 * Design direction: white with a hairline bottom border, ink links, and the
 * single crimson button (Plan My Trip). It may sit transparent over a hero
 * photograph and solidify to white on scroll — `overlay` opts into that.
 *
 * Invariant #1: the phone number and WhatsApp link come from siteSettings.
 * Nothing here is typed by hand.
 *
 * The scroll-solidify uses an IntersectionObserver on a sentinel rather than a
 * scroll listener, so it costs nothing per frame. The mobile menu toggle is
 * ~15 lines of UI JavaScript — not animation, so it sits outside the 40KB
 * animation budget, but it is kept small on principle.
 */
import Logo from './Logo.astro';
import Button from './Button.astro';
import { NAV_ITEMS } from '../lib/nav';
import { getSiteSettings, whatsappLink } from '../lib/site-settings';
import { getCollection } from 'astro:content';

interface Props {
  /** Transparent over a full-bleed hero, solidifying on scroll. */
  overlay?: boolean;
  /** Suppresses the logo link and marks the current page for a11y. */
  isHome?: boolean;
}

const { overlay = false, isHome = false } = Astro.props;

const settings = await getSiteSettings();
const currentPath = Astro.url.pathname;

const destinations = (await getCollection('destinations'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ label: entry.data.name, href: `/destinations/${entry.id}/` }));

const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

{overlay && <div id="header-sentinel" aria-hidden="true"></div>}

<header class:list={['header', { 'header--overlay': overlay }]} data-header>
  <div class="container-content header__inner">
    <Logo height={40} isHome={isHome} class="header__logo" />

    <nav class="header__nav" aria-label="Main">
      <ul class="header__list">
        <li class="header__item header__item--has-menu">
          <!-- Native disclosure: keyboard-operable and Esc-closable with no JS. -->
          <details class="menu">
            <summary class="header__link header__summary">
              Destinations
              <svg class="menu__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <ul class="menu__panel">
              {destinations.map((item) => (
                <li>
                  <a href={item.href} class="menu__link">{item.label}</a>
                </li>
              ))}
              <li class="menu__all">
                <a href="/destinations/" class="menu__link">View all destinations</a>
              </li>
            </ul>
          </details>
        </li>

        {NAV_ITEMS.map((item) => (
          <li class:list={['header__item', { 'header__item--collapsible': item.collapsible }]}>
            <a
              href={item.href}
              class="header__link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}

        <!-- At 1024–1200px About + Reviews fold in here instead of crowding. -->
        <li class="header__item header__item--more">
          <details class="menu">
            <summary class="header__link header__summary">
              More
              <svg class="menu__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <ul class="menu__panel">
              {NAV_ITEMS.filter((i) => i.collapsible).map((item) => (
                <li><a href={item.href} class="menu__link">{item.label}</a></li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <div class="header__actions">
      <a
        href={settings.phoneHref}
        class="header__icon tap-target"
        aria-label={`Call us on ${settings.phone}`}
        data-analytics="call_click"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M4.5 2.5h2.2l1.5 3.6-1.8 1.3a9.4 9.4 0 0 0 4.7 4.7l1.3-1.8 3.6 1.5v2.2a1.5 1.5 0 0 1-1.7 1.5A13.4 13.4 0 0 1 3 4.2 1.5 1.5 0 0 1 4.5 2.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </a>
      <a
        href={whatsappLink(settings)}
        class="header__icon tap-target"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Message us on WhatsApp (opens in a new tab)"
        data-analytics="wa_click"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M10 2.5a7.5 7.5 0 0 0-6.4 11.4L2.5 17.5l3.7-1.1A7.5 7.5 0 1 0 10 2.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M7.2 7.1c.3-.6 1-.5 1.2-.1l.5 1c.1.3 0 .5-.2.7l-.3.3c.4.8 1 1.4 1.8 1.8l.3-.3c.2-.2.4-.3.7-.2l1 .5c.4.2.5.9-.1 1.2-1.2.6-2.6-.1-3.6-1.1S6.6 8.3 7.2 7.1Z" fill="currentColor"/>
        </svg>
      </a>
      <Button href="/plan-my-trip/" size="sm" class="header__cta">Plan My Trip</Button>

      <button
        type="button"
        class="header__burger tap-target"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        data-burger
      >
        <span class="header__burger-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="header__mobile" id="mobile-nav" hidden data-mobile-nav>
    <ul class="header__mobile-list">
      <li><a href="/destinations/" class="header__mobile-link">Destinations</a></li>
      {NAV_ITEMS.map((item) => (
        <li><a href={item.href} class="header__mobile-link">{item.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  (() => {
    const burger = document.querySelector('[data-burger]');
    const panel = document.querySelector('[data-mobile-nav]');
    if (!burger || !panel) return;

    const setOpen = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.hidden = !open;
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    // Transparent-over-hero headers solidify once the sentinel scrolls away.
    // A sentinel + observer costs nothing per frame, unlike a scroll listener.
    const sentinel = document.getElementById('header-sentinel');
    const header = document.querySelector('[data-header]');
    if (sentinel && header && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => header.classList.toggle('is-solid', !entry.isIntersecting),
        { threshold: 0 },
      ).observe(sentinel);
    }
  })();
</script>

<style>
  #header-sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 100%;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-hairline);
  }

  /* Transparent over a hero photograph, then solid white on scroll. */
  .header--overlay {
    position: fixed;
    inset-inline: 0;
    background-color: transparent;
    border-bottom-color: transparent;
    color: var(--color-white);
    /* Legibility scrim. Without it the white links sit on whatever the top of
       the photograph happens to be — a pale sunrise sky in the homepage hero,
       where they vanished. Soft enough to read as depth, not as a bar.

       INK rather than plum since round 3, matching the hero gradient it sits
       on top of: two washes in two different hues over one photograph is how
       you get a seam even when neither gradient has an edge of its own. It
       also carries more of the work now, because the hero's own wash is close
       to nothing at the very top. */
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-ink) 58%, transparent) 0%,
      color-mix(in srgb, var(--color-ink) 42%, transparent) 35%,
      color-mix(in srgb, var(--color-ink) 20%, transparent) 68%,
      transparent 100%
    );
  }

  .header--overlay :is(.header__link, .header__icon, .header__summary) {
    color: var(--color-white);
  }

  .header--overlay.is-solid {
    background-color: var(--color-white);
    background-image: none;
    border-bottom-color: var(--color-hairline);
    color: var(--color-ink);
  }

  .header--overlay.is-solid :is(.header__link, .header__icon, .header__summary) {
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .header--overlay {
      transition:
        background-color var(--duration-base) var(--ease-brand),
        border-color var(--duration-base) var(--ease-brand);
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 72px;
  }

  .header__nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .header__nav {
      display: block;
      flex: 1;
    }
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.65rem 0.7rem;
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-sm);
  }

  .header__link:hover {
    color: var(--color-crimson);
  }

  .header__link[aria-current='page'] {
    color: var(--color-crimson);
    font-weight: 600;
  }

  /* ---- Disclosure menus ------------------------------------------------ */
  .menu {
    position: relative;
  }

  .header__summary {
    cursor: pointer;
    list-style: none;
  }

  .header__summary::-webkit-details-marker {
    display: none;
  }

  .menu__chevron {
    width: 10px;
    height: 7px;
  }

  .menu[open] .menu__chevron {
    transform: rotate(180deg);
  }

  .menu__panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    z-index: 60;
    min-width: 15rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background-color: var(--color-white);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift-hover);
  }

  .menu__link {
    display: block;
    padding: 0.6rem 0.75rem;
    color: var(--color-ink);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .menu__link:hover {
    background-color: var(--color-offwhite);
    color: var(--color-crimson);
  }

  .menu__all {
    margin-top: 0.25rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-hairline);
  }

  .menu__all .menu__link {
    font-weight: 600;
    color: var(--color-crimson);
  }

  /* ---- The 1024–1200px fold ------------------------------------------- */
  .header__item--more {
    display: none;
  }

  @media (min-width: 64rem) and (max-width: 74.99rem) {
    .header__item--collapsible {
      display: none;
    }

    .header__item--more {
      display: block;
    }
  }

  /* ---- Actions --------------------------------------------------------- */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    border-radius: var(--radius-sm);
  }

  .header__icon svg {
    width: 20px;
    height: 20px;
  }

  .header__icon:hover {
    color: var(--color-crimson);
  }

  .header__cta {
    display: none;
  }

  @media (min-width: 48rem) {
    .header__cta {
      display: inline-flex;
      margin-left: 0.5rem;
    }
  }

  /* ---- Mobile menu ----------------------------------------------------- */
  .header__burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    cursor: pointer;
    color: inherit;
  }

  @media (min-width: 64rem) {
    .header__burger {
      display: none;
    }
  }

  .header__burger-bars,
  .header__burger-bars::before,
  .header__burger-bars::after {
    display: block;
    width: 20px;
    height: 1.75px;
    background-color: currentColor;
    border-radius: 2px;
  }

  .header__burger-bars::before,
  .header__burger-bars::after {
    content: '';
    position: relative;
  }

  .header__burger-bars::before {
    top: -6px;
  }

  .header__burger-bars::after {
    top: 4px;
  }

  .header__mobile {
    border-top: 1px solid var(--color-hairline);
    background-color: var(--color-white);
  }

  .header__mobile-list {
    margin: 0;
    padding: 0.5rem var(--space-gutter) 1rem;
    list-style: none;
  }

  .header__mobile-link {
    display: block;
    padding: 0.85rem 0;
    color: var(--color-ink);
    font-size: var(--text-xl);
    font-family: var(--font-display);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline);
  }
</style>
