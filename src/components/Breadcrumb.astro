---
/**
 * Breadcrumb — one trail, one markup, every page that shows one.
 * ---------------------------------------------------------------------------
 * Twelve templates each hand-built their own `.crumbs` until round 5 (#17),
 * which is how the article trail came to stop one step short of where every
 * other trail ends. The trail always ends on the page you are on, marked
 * `aria-current="page"` and not linked.
 *
 * The visible trail and the BreadcrumbList JSON-LD stay two calls on purpose:
 * the structured data carries absolute URLs and goes in <head>, this carries
 * labels and goes in the hero. The pages that build both pass the same steps.
 *
 * `tone` follows the ground, because a breadcrumb's legibility is the ground's
 * problem, not the page's:
 *   light  ink-muted on white or off-white
 *   image  white on a photograph's ink wash. Measured by check:hero-contrast,
 *          which finds this element by its `aria-label` (round 5, #6: the
 *          muted pink measured 3.0–3.9:1 there, and on-dark 4.25:1 on Ladakh)
 *   dark   on-dark-muted on a solid ink or burgundy band
 *
 * The Itinerary Template Specification's S1 hero carries no breadcrumb, so a
 * journey page has none on screen; its BreadcrumbList is in the head.
 */
interface Crumb {
  label: string;
  /** Omit on the last step: it is the current page. */
  href?: string;
}

interface Props {
  items: Crumb[];
  tone?: 'light' | 'image' | 'dark';
}

const { items, tone = 'light' } = Astro.props;
const last = items.length - 1;
---

<nav class:list={['crumbs', `crumbs--${tone}`]} aria-label="Breadcrumb">
  <ol class="crumbs__list">
    {items.map((item, index) => (
      <li class="crumbs__step">
        {index === last || !item.href ? (
          <span aria-current={index === last ? 'page' : undefined}>{item.label}</span>
        ) : (
          <a href={item.href}>{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs {
    margin-bottom: 1.25rem;
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
  }

  .crumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The separator is drawn, not typed. The second `content` gives it empty
     alternative text, so a screen reader reads the steps and not "slash";
     a browser without that syntax keeps the first line. */
  .crumbs__step + .crumbs__step::before {
    content: '/';
    content: '/' / '';
    margin-right: 0.5rem;
  }

  .crumbs--light {
    color: var(--color-ink-muted);
  }

  .crumbs--light a {
    color: var(--color-ink-muted);
  }

  .crumbs--light a:hover {
    color: var(--color-crimson);
  }

  .crumbs--image,
  .crumbs--image a {
    color: var(--color-white);
  }

  .crumbs--image a:hover {
    text-decoration-thickness: 2px;
  }

  .crumbs--dark,
  .crumbs--dark a {
    color: var(--color-on-dark-muted);
  }

  .crumbs--dark a:hover {
    color: var(--color-yellow);
  }
</style>
