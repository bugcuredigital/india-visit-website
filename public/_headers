# Cloudflare Pages response headers. Astro copies this file to dist/ as is.
#
# Everything under /_astro/ is content-hashed by Vite (fonts, scripts, styles
# and optimised images), so a changed file is a new URL and a cached copy can
# never go stale: cache it for a year and never revalidate. Pages' default was
# `max-age=0, must-revalidate`, so every view re-checked the fonts and, with
# `font-display: optional`, often missed the ~100ms window and drew the
# headings in the fallback face (round 5, #2; CLAUDE.md, locked stack).
#
# Never add /uploads/* here: CMS media keeps its file name when it changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
