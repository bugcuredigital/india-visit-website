# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.astro/
.output/

# environment
.env
.env.*
!.env.example

# tooling / audit artefacts
.lighthouseci/
*.log
npm-debug.log*

# macOS
.DS_Store
**/.DS_Store

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# Lighthouse raw reports — large; the committed evidence is the *-summary.json
# files beside them. Globbed at any depth: per-round reports live in
# subdirectories (reports/rev2/...) and the top-level pattern missed them.
reports/**/*.report.json
reports/**/*.report.html

# Regenerable brand master (npm run brand:logo reproduces it exactly)
docs/brand/processed/logo-badge-master.png

# Reference captures — client-supplied design ground truth, 90MB of full-page
# PNGs. Kept local rather than committed: see docs/references/README.md.
docs/references/*.png

# Raw review captures. The committed evidence is the JPEG set beside them.
reports/**/*.png
